<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- 
      IMPORTANT: Update this connection string to match your database server
      Replace: YOUR_SERVER, YOUR_DATABASE, YOUR_USER, YOUR_PASSWORD
    -->
    <add name="DefaultConnection" 
         connectionString="Server=YOUR_SERVER;Database=AU_eOffice_Live;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=false;TrustServerCertificate=true;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- 
      CRITICAL: These keys MUST match your Web.config exactly!
      
      To generate keys:
      1. Run GenerateEncryptionKeys.cs utility
      2. Copy the generated keys here AND to Web.config
      3. Both files MUST have identical keys
      
      Example keys (DO NOT USE IN PRODUCTION - Generate your own!):
    -->
    <add key="AesEncryptionKey" value="YOUR_GENERATED_KEY_HERE" />
    <add key="AesEncryptionIV" value="YOUR_GENERATED_IV_HERE" />
    
    <!-- 
      If you already have keys in Web.config, copy them here:
      1. Open your Web.config
      2. Find AesEncryptionKey and AesEncryptionIV values
      3. Paste them above
    -->
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
