@model System.Data.DataTable
@{
    ViewBag.Title = "HandOver_Files";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div id="accordiontwenty6" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingtwenty6" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapsetwenty6" aria-expanded="true" aria-controls="collapsetwenty6" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">HandOver Files<i class="float-right pe-7s-angle-down"></i></h5>
                    </button>
                </div>
                <div data-parent="#accordiontwenty6" id="collapsetwenty6" aria-labelledby="headingtwenty6" class="collapse show">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails">
                                <div class="">

                                    <table style="width: 100%;" id="scr-vtr-dynamic" class="example1 table table-striped table-bordered nowrap table-hover text-left">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th class="text-left">Employee Name</th>
                                                <th class="text-left">Department</th>
                                                <th class="text-left">Section</th>
                                                <th class="text-left">Designation</th>
                                                <th class="text-left">File Count</th>
                                              
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Rows.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (System.Data.DataRow row in Model.Rows)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@row["Emp_Name"]</td>
                                                        <td>@row["Est_deptName"]</td>
                                                        <td>@row["Est_secName"]</td>
                                                        <td>@row["Est_desigName"]</td>
                                                        @*<td> <a href="/User/Frm_ViewHandoverFiles?forwardedFrom=@row["forwarded_From"]">@row["Count_File"]</a> </td>*@
                                                        <td>
                                                            <a href="@Url.Action("Frm_ViewHandoverFiles", "User", new { forwardedFrom = row["forwarded_From"] })">
                                                                @row["Count_File"]
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }
                                        </tbody>
                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

