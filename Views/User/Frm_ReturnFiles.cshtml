@model System.Data.DataTable

@{
    ViewBag.Title = "Frm_ReturnFiles";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<section class="content">
    <div class="container-fluid">


        <div id="accordiontwenty5" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingtwenty5" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapsetwenty5" aria-expanded="true" aria-controls="collapsetwenty5" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title"> Return Files<i class="float-right pe-7s-angle-down"></i></h5>
                    </button>
                </div>
                <div data-parent="#accordiontwenty5" id="collapsetwenty5" aria-labelledby="headingtwenty5" class="collapse show">

                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails">
                                <div class="">

                                    <table style="width: 100%; " id="scr-vtr-dynamic" class="example1 table table-striped table-bordered  table-hover text-left">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th class="text-left">File_Code</th>
                                                <th class="text-left">File_Des</th>
                                                <th class="text-left">Created By Section</th>
                                                <th class="text-left">Sent From</th>
                                                <th class="text-left">Sent To </th>
                                                <th class="text-left">Return Date</th>
                                                <th>Priority</th>
                                                <th>Status</th>
                                                <th>Remarks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Rows.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (System.Data.DataRow row in Model.Rows)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td><a href="@Url.Action("Noting_Page", "User", new { fileCode = row["File_Code"] })">@row["File_Code"]</td>
                                                        <td style="white-space: normal !important; word-wrap: break-word; min-width: 300px; ">@row["File_Desc"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["transfer_from"]</td>
                                                        <td>@row["transfer_To"]</td>
                                                        <td>@row["forwarded_DT"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["File_status"]</td>
                                                        <td>@row["Remark1"]</td>
                                                        @*<td>
                                                                @Html.ActionLink("Edit", "Department", "Admin", new { DepCode = item.Dep_Code }, new { @class = "btn btn-sm btn-warning" })
                                                                @Html.ActionLink("Delete", "DeleteDepartment", "Admin", new { DepCode = item.Dep_Code }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this department?');" })
                                                           </td>*@
                                                    </tr>
                                                    i++;
                                                }
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


