    /* Zoom Lens */
    .zoom-lens {
        display: none !important;
    }

        .zoom-lens canvas {
            display: none !important;
        }

    .page:hover .zoom-lens {
        display: none !important;
    }

    .page-left {
        left: 0;
        z-index: 2;
        transform-origin: right center;
    }

    .page-right {
        left: 50%;
        z-index: 1;
        transform-origin: left center;
    }

    /* Center single page when it's the only one */
    .page-left.single-page {
        left: 25%;
        z-index: 2;
    }

    .page-left.turning-left {
        animation: turnPageLeft 1.2s cubic-bezier(0.645, 0.045, 0.355, 1) forwards;
        z-index: 10;
    }

    .page-right.turning-right {
        animation: turnPageRight 1.2s cubic-bezier(0.645, 0.045, 0.355, 1) forwards;
        z-index: 10;
    }

    @@keyframes turnPageRight {
        0% {
            transform: rotateY(0deg);
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
        }

        50% {
            transform: rotateY(-90deg);
            box-shadow: -30px 0 50px rgba(0,0,0,0.4);
        }

        100% {
            transform: rotateY(-180deg);
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
        }
    }

    @@keyframes turnPageLeft {
        0% {
            transform: rotateY(0deg);
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
        }

        50% {
            transform: rotateY(90deg);
            box-shadow: 30px 0 50px rgba(0,0,0,0.4);
        }

        100% {
            transform: rotateY(180deg);
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
        }
