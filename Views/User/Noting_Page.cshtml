<script>
    // Global variables for flipbook - must be declared outside function
    let currentSheet = 0;
    let totalPages = 0;
    let pdfDoc = null;
    let isPlaying = false;
    let playInterval = null;
    let playSpeed = 3000;
    let isAnimating = false;
    let isGoingForward = true;
    let zoomLevel = 0.9; // Start at 90% zoom
    let isFullscreen = false;
    let turnJsInitialized = false;
    let renderedPages = {};

    // Wait for PDF.js and Turn.js to load before initializing flipbook
    window.addEventListener('DOMContentLoaded', function () {
        var checkLibraries = setInterval(function () {
            if (typeof pdfjsLib !== 'undefined' && typeof jQuery !== 'undefined' && typeof jQuery.fn.turn !== 'undefined') {
                clearInterval(checkLibraries);
                initializeFlipbook();
            }
        }, 50);
    });

    // Global flipbook functions - must be outside initializeFlipbook so they're accessible everywhere
    function showCover(show) {
        if (show === undefined) show = true;
        $("#flipbook-cover").toggle(show);
    }

    function stopAutoPlay() {
        isPlaying = false;
        if (playInterval) clearInterval(playInterval);
        $('#flipbook-play i').removeClass('fa-pause').addClass('fa-play');
    }

    function startAutoPlayTurnJs() {
        isPlaying = true;
        $('#flipbook-play i').removeClass('fa-play').addClass('fa-pause');

        playInterval = setInterval(() => {
            const magazine = $('#flipbook-magazine');
            if (!magazine.turn('is')) {
                stopAutoPlay();
                return;
            }

            const currentPage = magazine.turn('page');
            const totalPgs = magazine.turn('pages');

            if (currentPage >= totalPgs) {
                stopAutoPlay();
                return;
            }
            magazine.turn('next');
        }, playSpeed);
    }

    function closeFlipbook() {
        stopAutoPlay();
        const flipbookContainer = $('.flipbook-container');
        flipbookContainer.removeClass('active');

        // Remove body class to restore scrollbar
        $('body').removeClass('flipbook-active');

        // Destroy Turn.js instance
        const magazine = $('#flipbook-magazine');
        if (magazine.turn('is')) {
            magazine.turn('destroy');
            turnJsInitialized = false;
        }

        setTimeout(() => {
            flipbookContainer.hide();
            $('#pdfViewer').show();
            magazine.hide();

            // Reset page indicators to cover
            $('#current-page, #top-current-page').text('Cover');
            $('#total-pages, #top-total-pages').text(totalPages);

            renderedPages = {}; // Clear cache
        }, 400);
    }

    function goToPageTurnJs(page) {
        const magazine = $('#flipbook-magazine');
        if (magazine.turn('is')) {
            magazine.turn('page', page);
            updateFlipbookNavTurnJs();
        }
    }

    // Render a single page for Turn.js - GLOBAL function
    async function renderPageForTurnJs(pageNum) {
        console.log('renderPageForTurnJs called for page', pageNum);
        console.log('pdfDoc:', pdfDoc);

        if (renderedPages[pageNum]) {
            console.log('Returning cached page', pageNum);
            // Clone canvas properly with content
            const originalCanvas = renderedPages[pageNum];
            const clonedCanvas = document.createElement('canvas');
            clonedCanvas.width = originalCanvas.width;
            clonedCanvas.height = originalCanvas.height;
            const ctx = clonedCanvas.getContext('2d');
            ctx.drawImage(originalCanvas, 0, 0);
            return clonedCanvas;
        }

        try {
            const canvas = document.createElement('canvas');
            const pdfPage = await pdfDoc.getPage(pageNum);
            const viewport = pdfPage.getViewport({ scale: 1.5 });

            canvas.width = viewport.width;
            canvas.height = viewport.height;

            console.log('Rendering page', pageNum, 'with dimensions', canvas.width, 'x', canvas.height);

            await pdfPage.render({
                canvasContext: canvas.getContext('2d'),
                viewport: viewport
            }).promise;

            console.log('Page', pageNum, 'rendered successfully');
            renderedPages[pageNum] = canvas;

            // Return a proper clone with content
            const clonedCanvas = document.createElement('canvas');
            clonedCanvas.width = canvas.width;
            clonedCanvas.height = canvas.height;
            const ctx = clonedCanvas.getContext('2d');
            ctx.drawImage(canvas, 0, 0);
            return clonedCanvas;
        } catch (error) {
            console.error('Error in renderPageForTurnJs for page', pageNum, ':', error);
            throw error;
        }
    }

    // Add page to Turn.js magazine - GLOBAL function
    async function addPageToMagazine(page, magazine) {
        console.log('addPageToMagazine called for page', page);

        // Create page element with Turn.js expected structure
        const pageElement = $('<div />');

        // Render the page
        try {
            const canvas = await renderPageForTurnJs(page);
            console.log('Canvas received for page', page, ':', canvas);

            // Directly append canvas to page element
            pageElement.append(canvas);

            // Add gradient overlay for realistic book effect
            const gradient = $('<div class="gradient"></div>');
            pageElement.append(gradient);

            // Add inline styles to ensure visibility
            pageElement.css({
                'width': '100%',
                'height': '100%',
                'background': 'white',
                'display': 'flex',
                'align-items': 'center',
                'justify-content': 'center',
                'position': 'relative'
            });

            canvas.style.maxWidth = '100%';
            canvas.style.maxHeight = '100%';
            canvas.style.display = 'block';

            console.log('Canvas appended to page element for page', page);
        } catch (error) {
            console.error('Error rendering page:', page, error);
            pageElement.html('<div style="padding: 20px; color: red;">Error loading page ' + page + '</div>');
        }

        return pageElement;
    }

    // Initialize Turn.js magazine - GLOBAL function
    async function initTurnJsMagazine() {
        if (turnJsInitialized) {
            // If already initialized, just show it and go to page 1
            $('#flipbook-magazine').show();
            const magazine = $('#flipbook-magazine');
            magazine.turn('page', 1);
            updatePageIndicatorTurnJs(1);
            updateFlipbookNavTurnJs();
            return;
        }

        console.log('initTurnJsMagazine called');
        console.log('$.fn.turn available:', typeof $.fn.turn);
        console.log('pdfDoc loaded:', pdfDoc !== null);
        console.log('totalPages:', totalPages);

        if (typeof $.fn.turn === 'undefined') {
            console.error('Turn.js is not loaded!');
            alert('Turn.js library is not available. Cannot initialize flipbook.');
            return;
        }

        if (!pdfDoc || totalPages === 0) {
            console.error('PDF document not loaded yet!');
            alert('Please wait for the PDF to load before opening the flipbook.');
            return;
        }

        // Show loader and hide magazine during initialization
        const loader = $('#flipbook-loader');
        const magazine = $('#flipbook-magazine');
        const container = $('.magazine-viewport .container');

        loader.show();
        magazine.css('opacity', '0');
        container.css('opacity', '0');

        // Calculate responsive dimensions based on viewport
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight - 100; // Account for controls
        const aspectRatio = 1.6; // Book aspect ratio (width / height) - wider book

        let containerWidth, containerHeight;

        // Calculate dimensions to fit viewport while maintaining aspect ratio
        const maxWidth = viewportWidth * 0.95; // 95% of viewport width - much wider
        const maxHeight = viewportHeight * 0.68; // 68% of viewport height - decreased height more

        if (maxWidth / maxHeight > aspectRatio) {
            // Height is the limiting factor
            containerHeight = maxHeight;
            containerWidth = containerHeight * aspectRatio;
        } else {
            // Width is the limiting factor
            containerWidth = maxWidth;
            containerHeight = containerWidth / aspectRatio;
        }

        // Ensure reasonable size for book appearance
        if (containerWidth < 1100) {
            containerWidth = 1100;
            containerHeight = containerWidth / aspectRatio;
        }

        console.log('Magazine element:', magazine.length);
        console.log('Calculated dimensions:', Math.round(containerWidth), 'x', Math.round(containerHeight));
        console.log('Viewport:', viewportWidth, 'x', viewportHeight);

        magazine.empty();
        magazine.css({
            width: Math.round(containerWidth),
            height: Math.round(containerHeight)
        });

        try {
            // FIRST: Create hard cover front page (page 1)
            console.log('Creating hard cover front page as page 1...');
            const coverContent = $('#flipbook-cover .cover-content').clone();
            const hardCoverFront = $('<div />').addClass('hard-cover-front');

            // Add hard cover styling with enhanced texture
            hardCoverFront.css({
                'background': 'linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%)',
                'color': 'white',
                'position': 'relative',
                'overflow': 'hidden',
                'display': 'flex',
                'align-items': 'center',
                'justify-content': 'center',
                'box-shadow': 'inset -5px 0 15px rgba(0,0,0,0.4), 5px 0 20px rgba(0,0,0,0.5)',
                'border-right': '4px solid rgba(0,0,0,0.3)'
            });

            // Add enhanced texture overlay
            const texture = $('<div />').css({
                'position': 'absolute',
                'top': '0',
                'left': '0',
                'width': '100%',
                'height': '100%',
                'background-image': 'repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(255,255,255,0.05) 2px, rgba(255,255,255,0.05) 4px), repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.05) 2px, rgba(255,255,255,0.05) 4px)',
                'pointer-events': 'none',
                'z-index': '1'
            });

            hardCoverFront.append(texture);
            coverContent.css({ 'position': 'relative', 'z-index': '2' });
            hardCoverFront.append(coverContent);
            magazine.append(hardCoverFront);
            console.log('Hard cover front page added as page 1');

            // SECOND: Create blank page (page 2 - left side after cover opens)
            console.log('Creating blank page as page 2...');
            const blankPage = $('<div />').addClass('blank-page');
            blankPage.css({
                'background': '#fefefe',
                'position': 'relative',
                'box-shadow': 'inset 5px 0 10px rgba(0,0,0,0.1)',
                'border-left': '1px solid rgba(0,0,0,0.1)'
            });
            magazine.append(blankPage);
            console.log('Blank page added as page 2');

            // THIRD: Create all PDF page elements (starting from page 3)
            console.log('Creating PDF page elements...');
            for (let i = 1; i <= totalPages; i++) {
                console.log('Creating PDF page', i, 'as Turn.js page', i + 2);
                const pageElement = await addPageToMagazine(i, magazine);
                pageElement.attr('data-page', i + 2); // PDF page 1 becomes Turn.js page 3
                magazine.append(pageElement);
                console.log('PDF page', i, 'added to DOM as Turn.js page', i + 2);
            }

            // FOURTH: Create blank page before back cover (page after last PDF)
            console.log('Creating blank page before back cover...');
            const blankPageEnd = $('<div />').addClass('blank-page');
            blankPageEnd.css({
                'background': '#fefefe',
                'position': 'relative',
                'box-shadow': 'inset -5px 0 10px rgba(0,0,0,0.1)',
                'border-right': '1px solid rgba(0,0,0,0.1)'
            });
            magazine.append(blankPageEnd);
            console.log('Blank page before back cover added');

            // FIFTH: Add another blank page to make back cover appear on left (even page)
            console.log('Creating second blank page...');
            const blankPageEnd2 = $('<div />').addClass('blank-page');
            blankPageEnd2.css({
                'background': '#fefefe',
                'position': 'relative',
                'box-shadow': 'inset 5px 0 10px rgba(0,0,0,0.1)',
                'border-left': '1px solid rgba(0,0,0,0.1)'
            });
            magazine.append(blankPageEnd2);
            console.log('Second blank page added');

            // SIXTH: Create hard cover back page (last page - will be on left/even side)
            console.log('Creating hard cover back page...');
            const hardCoverBack = $('<div />').addClass('hard-cover-back');
            hardCoverBack.css({
                'background': 'linear-gradient(135deg, #3b82f6 0%, #1e3a8a 100%)',
                'position': 'relative',
                'overflow': 'hidden',
                'box-shadow': 'inset 5px 0 15px rgba(0,0,0,0.4), -5px 0 20px rgba(0,0,0,0.5)',
                'border-left': '4px solid rgba(0,0,0,0.3)'
            });

            // Add texture to back cover
            const backTexture = $('<div />').css({
                'position': 'absolute',
                'top': '0',
                'left': '0',
                'width': '100%',
                'height': '100%',
                'background-image': 'repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(255,255,255,0.05) 2px, rgba(255,255,255,0.05) 4px), repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.05) 2px, rgba(255,255,255,0.05) 4px)',
                'pointer-events': 'none'
            });
            hardCoverBack.append(backTexture);
            magazine.append(hardCoverBack);
            console.log('Hard cover back page added as last page');

            console.log('All pages added to DOM, now initializing Turn.js...');

            // THIRD: Initialize Turn.js with all pages
            magazine.turn({
                width: Math.round(containerWidth),
                height: Math.round(containerHeight),
                autoCenter: true,
                elevation: 50,
                gradients: true,
                acceleration: true,
                duration: 1000,
                page: 1, // Start at cover page
                display: 'double', // Use double page mode
                when: {
                    turning: function (event, page, view) {
                        updatePageIndicatorTurnJs(page, view);
                    },
                    turned: function (event, page, view) {
                        updatePageIndicatorTurnJs(page, view);
                        updateFlipbookNavTurnJs();
                    }
                }
            });

            console.log('Turn.js initialized successfully with', magazine.turn('pages'), 'pages');
            turnJsInitialized = true;

            // Set initial page indicator
            updatePageIndicatorTurnJs(1);
            updateFlipbookNavTurnJs();

            // Force Turn.js to center the book on page 1 (cover)
            magazine.turn('page', 1);
            magazine.turn('center');

            // Hide loader and fade in magazine after initialization
            setTimeout(() => {
                loader.fadeOut(300);
                // Set initial transform with zoom
                container.css({
                    'opacity': '1',
                    'transform': 'translate(-50%, -50%) scale(0.9)',
                    'transform-origin': 'center center'
                });
                magazine.css('opacity', '1');
                // Force center to trigger autoCenter
                setTimeout(() => {
                    magazine.turn('center');
                }, 100);
                console.log('Flipbook initialization complete - loader hidden, magazine visible');
            }, 300);

        } catch (error) {
            console.error('Error initializing Turn.js:', error);
            loader.hide();
        }
    }

    // Update page indicator for Turn.js - GLOBAL function
    function updatePageIndicatorTurnJs(page, view) {
        const magazine = $('#flipbook-magazine');

        if (!view) {
            if (magazine.turn('is')) {
                view = magazine.turn('view');
                page = magazine.turn('page');
            }
        }

        let currentPageText = '';
        let showTotal = false;
        const totalTurnPages = magazine.turn('pages');

        // Structure: Page 1=front cover, 2=blank, 3-15=PDF(13 pages), 16-17=blank pages, 18=back cover
        if (page === 1 || (view && view[0] === 1)) {
            // Front cover - don't show page numbers
            currentPageText = '';
            showTotal = false;
        } else if (page === totalTurnPages || (view && view.includes(totalTurnPages))) {
            // Back cover - don't show page numbers
            currentPageText = '';
            showTotal = false;
        } else if (page === 2 || (view && view.includes(2) && !view.includes(3))) {
            // First blank page alone - don't show numbers
            currentPageText = '';
            showTotal = false;
        } else if ((page >= totalTurnPages - 2 && page < totalTurnPages) ||
            (view && (view.includes(totalTurnPages - 1) || view.includes(totalTurnPages - 2)) && !view.some(p => p >= 3 && p <= 15))) {
            // Last blank pages alone - don't show numbers
            currentPageText = '';
            showTotal = false;
        } else {
            // For PDF pages (pages 3 to 15), subtract 2 to get actual PDF page number
            showTotal = true;
            if (view && view.length === 2 && view[0] > 0 && view[1] > 0) {
                const leftPage = view[0] >= 3 && view[0] <= 15 ? view[0] - 2 : null;
                const rightPage = view[1] >= 3 && view[1] <= 15 ? view[1] - 2 : null;

                if (leftPage && rightPage) {
                    currentPageText = leftPage + '-' + rightPage;
                } else if (leftPage) {
                    currentPageText = leftPage + '';
                } else if (rightPage) {
                    currentPageText = rightPage + '';
                } else {
                    currentPageText = '';
                    showTotal = false;
                }
            } else if (view && view.length === 1) {
                const pageNum = view[0] >= 3 && view[0] <= 15 ? view[0] - 2 : null;
                if (pageNum) {
                    currentPageText = pageNum + '';
                } else {
                    currentPageText = '';
                    showTotal = false;
                }
            } else {
                const pageNum = page >= 3 && page <= 15 ? page - 2 : null;
                if (pageNum) {
                    currentPageText = pageNum + '';
                } else {
                    currentPageText = '';
                    showTotal = false;
                }
            }
        }

        if (showTotal && currentPageText) {
            $('#current-page').text(currentPageText);
            $('#total-pages').text(totalPages);
            $('#top-current-page').text(currentPageText);
            $('#top-total-pages').text(totalPages);
        } else {
            $('#current-page').text('');
            $('#total-pages').text('');
            $('#top-current-page').text('');
            $('#top-total-pages').text('');
        }
    }

    // Update navigation buttons for Turn.js - GLOBAL function
    function updateFlipbookNavTurnJs() {
        const magazine = $('#flipbook-magazine');
        if (!magazine.turn('is')) return;

        const currentPage = magazine.turn('page');
        const totalPgs = magazine.turn('pages');

        $('#flipbook-prev, #flipbook-first').prop('disabled', currentPage === 1);
        $('#flipbook-next, #flipbook-last').prop('disabled', currentPage >= totalPgs);
    }

    function initializeFlipbook() {
        // Configure PDF.js
        if (typeof pdfjsLib !== 'undefined') {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.11.338/pdf.worker.min.js';
        }

        $(document).ready(function () {

            // Close button
            $('#flipbook-close').click(closeFlipbook);

            // Navigation buttons for Turn.js
            $('#flipbook-first').click(() => {
                stopAutoPlay();
                const magazine = $('#flipbook-magazine');
                if (magazine.turn('is')) {
                    magazine.turn('page', 1); // Go to cover page
                    updateFlipbookNavTurnJs();
                }
            });

            $('#flipbook-prev').click(() => {
                stopAutoPlay();
                const magazine = $('#flipbook-magazine');
                if (magazine.turn('is')) {
                    magazine.turn('previous');
                    updateFlipbookNavTurnJs();
                }
            });

            $('#flipbook-next').click(() => {
                stopAutoPlay();
                const magazine = $('#flipbook-magazine');
                if (magazine.turn('is')) {
                    magazine.turn('next');
                    updateFlipbookNavTurnJs();
                }
            });

            $('#flipbook-last').click(() => {
                stopAutoPlay();
                const magazine = $('#flipbook-magazine');
                if (magazine.turn('is')) {
                    const totalPgs = magazine.turn('pages');
                    magazine.turn('page', totalPgs);
                    updateFlipbookNavTurnJs();
                }
            });

            // Play/Pause button
            $('#flipbook-play').click(function () {
                if (isPlaying) {
                    stopAutoPlay();
                } else {
                    startAutoPlayTurnJs();
                }
            });

            // Speed slider
            $('#flipbook-speed').on('input', function () {
                const speed = $(this).val();
                playSpeed = 6000 - (speed * 1000);
                if (isPlaying) {
                    stopAutoPlay();
                    startAutoPlay();
                }
            });

            // Zoom In button
            $('#flipbook-zoom-in').click(function () {
                if (zoomLevel < 1.5) {
                    zoomLevel += 0.1;
                    $('.magazine-viewport .container').css({
                        'transform': `translate(-50%, -50%) scale(${zoomLevel})`,
                        'transform-origin': 'center center'
                    });
                }
            });

            // Zoom Out button
            $('#flipbook-zoom-out').click(function () {
                if (zoomLevel > 0.5) {
                    zoomLevel -= 0.1;
                    $('.magazine-viewport .container').css({
                        'transform': `translate(-50%, -50%) scale(${zoomLevel})`,
                        'transform-origin': 'center center'
                    });
                }
            });

            // Fullscreen toggle
            $('#flipbook-fullscreen').click(function () {
                const container = document.querySelector('.flipbook-container');

                if (!isFullscreen) {
                    // Enter fullscreen
                    if (container.requestFullscreen) {
                        container.requestFullscreen();
                    } else if (container.webkitRequestFullscreen) {
                        container.webkitRequestFullscreen();
                    } else if (container.msRequestFullscreen) {
                        container.msRequestFullscreen();
                    }
                    $(this).find('i').removeClass('fa-expand').addClass('fa-compress');
                    isFullscreen = true;
                } else {
                    // Exit fullscreen
                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                    } else if (document.webkitExitFullscreen) {
                        document.webkitExitFullscreen();
                    } else if (document.msExitFullscreen) {
                        document.msExitFullscreen();
                    }
                    $(this).find('i').removeClass('fa-compress').addClass('fa-expand');
                    isFullscreen = false;
                }
            });

            // Listen for fullscreen change events
            $(document).on('fullscreenchange webkitfullscreenchange mozfullscreenchange msfullscreenchange', function () {
                if (!document.fullscreenElement && !document.webkitFullscreenElement &&
                    !document.mozFullScreenElement && !document.msFullscreenElement) {
                    $('#flipbook-fullscreen i').removeClass('fa-compress').addClass('fa-expand');
                    isFullscreen = false;
                }
            });

            // ESC key to close
            $(document).keyup(function (e) {
                if (e.key === "Escape" && $('.flipbook-container').hasClass('active')) {
                    closeFlipbook();
                }
            });

        });

        // On load: hide cover/page containers
        $(document).ready(function () {
            $('#flipbook-cover').show();
            $('#flipbook-pages').hide();
            $('#flipbook-magazine').hide();
            currentSheet = 0;
        });
    } // End of initializeFlipbook function

</script>


