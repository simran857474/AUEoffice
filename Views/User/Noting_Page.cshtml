                                                        <option value="draft">Save as Draft</option>
                                                        <option value="final">Save as Final</option>
                                                    </select>
                                                    @*<button type="submit" class="btn au-btn-save-modern me-2">💾 Save Note</button>*@
                                                    <button type="submit" class="btn au-btn-confirm-modern me-2" id="btnConfirm">Confirm</button>
                                                    <button type="reset" class="btn au-btn-reset-modern" id="btnNotingReset">Reset</button>
                                                    @*<button type="button" class="btn btn-secondary me-2" id="btnShowDraft">Show Draft</button>*@
                                                </div>
                                            </div>
                                        </div>


                                        @*</form>*@
                                    </div>
                                </div>
                            </div>
                            <!-- Attachment Sheet Section -->
                            <div class="col-md-6 d-flex">
                                <div class="card h-100 w-100 d-flex flex-column">

                                    @*<div class="card-header bg-primary text-center font-weight-bold text-white">
                                            <i class="fa fa-paperclip"></i> Attachment Sheet
                                        </div>*@
                                    @*<div class="card-header text-center font-weight-bold text-white" style="background-color: #119AB2;">
                                            <i class="fa fa-paperclip"></i> Attachment Sheet
                                            <button id="btnPrintAttachment" class="btn btn-sm btn-light float-right">
