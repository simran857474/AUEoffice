        border-radius: 5px;
        font-weight: 500;
    }

    .au-btn-confirm-modern {
        background: #2563eb;
        color: #fff;
        border-radius: 5px;
        font-weight: 500;
    }

    .au-btn-reset-modern {
        background: #f87171;
        color: #fff;
        border-radius: 5px;
        font-weight: 500;
    }

    .au-btn-save-modern:hover {
        background: #16a34a;
    }

    .au-btn-confirm-modern:hover {
        background: #1e40af;
    }

    .au-btn-reset-modern:hover {
        background: #dc2626;
    }
    /* CKEditor should have a scrollbar when content grows */
    .ck-editor__editable {
        min-height: 220px;
        max-height: 220px; /* Or whatever you like */
        overflow-y: auto !important;
        box-sizing: border-box;
        /* Remove vertical resizing by user if you want fixed scroll instead of resize */
        resize: none !important;
    }

    /* Optional: Remove outer card's scroll for the left column */
    .col-md-6 {
        overflow: visible !important;
        height: auto !important;
    }

    .note-frame {
        width: 100%;
        min-height: 300px;
        height: auto !important;
        overflow: hidden;
        border: none;
        background-color: #f8f9fa;
        font-family: 'Source Sans Pro', sans-serif;
        display: block;
    }

    @@media (max-width: 991px) {
        .au-card-body-modern {
            padding: 14px 10px 16px 10px;
        }

        @@media (max-width: 991px) {
            .au-note-list-modern {
                max-height: 300px; /* or higher */
            }
        }
    }

    #highlight-canvas {
        background: transparent;
        pointer-events: none; /* Disabled except in highlight mode */
    }


    .draft-highlight {
        border: 2px solid #f1c40f !important;
        border-radius: 4px;
    }

    .draft-badge {
        display: inline-block;
        padding: 3px 8px;
        background: #f39c12;
        color: #fff;
        font-size: 12px;
        font-weight: bold;
        border-radius: 3px;
        margin-bottom: 5px;
    }

    /* Draft Indicator - Prominent and Blinking */
    .draft-indicator {
        position: fixed;
        top: 120px;
        right: 20px;
        z-index: 1000;
        background: linear-gradient(135deg, #f39c12, #e67e22);
        color: #fff;
        padding: 12px 20px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(243, 156, 18, 0.4);
        font-weight: bold;
        font-size: 14px;
        display: none;
        animation: pulse-glow 2s infinite;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

        .draft-indicator:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(243, 156, 18, 0.6);
        }

        .draft-indicator i {
            margin-right: 8px;
            font-size: 18px;
            animation: bounce 1s infinite;
        }

    @@keyframes pulse-glow {
        0%, 100% {
            box-shadow: 0 4px 15px rgba(243, 156, 18, 0.4);
            opacity: 1;
        }

        50% {
            box-shadow: 0 4px 25px rgba(243, 156, 18, 0.8);
            opacity: 0.9;
        }
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .draft-indicator {
            top: 80px;
            right: 10px;
            padding: 10px 15px;
            font-size: 12px;
        }
    }

    /* Hide the powered-by CKEditor branding balloon */
    .ck.ck-balloon-panel {
        display: none !important;
        visibility: hidden !important;
    }


    @@font-face {
        font-family: 'KrutiDev010';
        src: url('/fonts/Kruti_Dev_010_Regular.ttf') format('truetype');
    }

    .ck-content.kruti-dev {
        font-family: 'KrutiDev010', Arial, sans-serif !important;
        font-size: 18px;
    }


    #attachmentTable thead th {
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 2;
    }
</style>

<!-- Draft Indicator - Fixed Position -->
