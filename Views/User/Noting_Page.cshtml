    /* Loader styles - Override magazine.css loader */
    .magazine-viewport .loader {
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        z-index: 10002 !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        width: auto !important;
        height: auto !important;
        background-image: none !important;
        margin: 0 !important;
    }

        .magazine-viewport .loader::before {
            content: '';
            width: 60px;
            height: 60px;
            border: 6px solid rgba(255, 255, 255, 0.2);
            border-top-color: #BB1E3D;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        .magazine-viewport .loader::after {
            content: 'Loading Flipbook...';
            color: white;
            font-size: 18px;
            font-weight: 600;
            text-align: center;
        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Magazine viewport should fill the flipbook container */
    .flipbook-container .magazine-viewport {
        position: absolute;
        width: 100%;
        height: calc(100% - 80px);
        top: 0;
        left: 0;
        overflow: hidden;
    }

    /* Container positioning - centered, allows zoom */
    .magazine-viewport .container {
        position: absolute;
        width: auto;
        height: auto;
        margin: 0;
        top: 50%;
        left: 50%;
        transform-origin: center center;
    }

    /* Magazine positioning - Turn.js will handle autoCenter */
    .magazine-viewport .magazine {
        position: relative;
        margin: 0;
        display: block;
        z-index: 2;
    }

    /* Page dimensions - will be calculated by Turn.js */
    .magazine-viewport .page {
        background-color: white;
        background-repeat: no-repeat;
        background-size: 100% 100%;
    }

    /* Enhanced shadows for realistic book crease */
    .magazine-viewport .turn-page {
        box-shadow: 0 0 20px rgba(0,0,0,0.2);
    }

    /* Left page (even) - shadow on right edge */
    .magazine-viewport .even .turn-page {
        box-shadow: inset -10px 0 20px -8px rgba(0,0,0,0.4), 0 0 20px rgba(0,0,0,0.2);
    }

    /* Right page (odd) - shadow on left edge */
    .magazine-viewport .odd .turn-page {
        box-shadow: inset 10px 0 20px -8px rgba(0,0,0,0.4), 0 0 20px rgba(0,0,0,0.2);
    }

    /* Center crease shadow effect */
    .magazine-viewport .magazine::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 0;
        width: 8px;
        height: 100%;
        background: linear-gradient(to right, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.35) 50%, rgba(0,0,0,0.2) 100% );
        transform: translateX(-50%);
        z-index: 1000;
        pointer-events: none;
        box-shadow: 0 0 15px rgba(0,0,0,0.4);
    }

    /* Hide crease when showing single page (cover) */
    .magazine-viewport .magazine.turn-page-1::before {
        display: none;
    }

    /* Blank page styling */
    .blank-page {
        background: linear-gradient(to right, #fefefe 0%, #ffffff 100%);
    }

    /* Hard cover pages - thicker appearance */
    .hard-cover-front,
    .hard-cover-back {
        position: relative;
    }

        .hard-cover-front::after {
            content: '';
            position: absolute;
            right: 0;
            top: 0;
            width: 8px;
            height: 100%;
            background: linear-gradient(to right, transparent, rgba(0,0,0,0.3));
            pointer-events: none;
        }

        .hard-cover-back::after {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 8px;
            height: 100%;
            background: linear-gradient(to left, transparent, rgba(0,0,0,0.3));
            pointer-events: none;
        }

    /* Responsive scaling for smaller screens */
    @@media (max-width: 1280px) or (max-height: 920px) {
        .magazine-viewport .container {
            transform: translate(-50%, -50%) scale(0.8);
        }
    }

    @@media (max-width: 1024px) or (max-height: 768px) {
        .magazine-viewport .container {
            transform: translate(-50%, -50%) scale(0.65);
        }
    }

    @@media (max-width: 768px) {
        .magazine-viewport .container {
            transform: translate(-50%, -50%) scale(0.5);
        }
    }

    /* Page dimensions - will be set by Turn.js */
    .magazine-viewport .page {
        background-color: white;
        background-repeat: no-repeat;
        background-size: 100% 100%;
    }

