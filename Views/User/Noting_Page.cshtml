                                                <h3 class="card-title"><span class="me-2"></span> Add New Note</h3>
                                                <div class="card-tools">
                                                    <button type="button" class="btn btn-tool" data-card-widget="maximize">
                                                        <i class="fas fa-expand"></i>
                                                    </button>
                                                </div>

                                            </div>

                                            <div class="card-body">
