        border-radius: 7px;
        border: 1px solid #cbd5e1;
        background: #fff;
        margin-bottom: 10px;
        font-size: 1em;
    }

    .gap-2 {
        gap: 0.5rem;
    }

    .au-sel-modern {
        border-radius: 4px;
        border: 1px solid #d1d5db;
        background: #f1f5f9;
        color: #475569;
        font-size: 1em;
    }

    /* Buttons */
    .au-btn-save-modern {
        background: #22c55e;
