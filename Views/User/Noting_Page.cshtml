<!-- Flipbook scripts moved to section scripts at the end of the file -->

<script>
    // Defer execution until jQuery is loaded
    window.addEventListener('DOMContentLoaded', function() {
        var checkJQuery2 = setInterval(function() {
            if (typeof jQuery !== 'undefined') {
                clearInterval(checkJQuery2);
                initializeNotingPage();
            }
        }, 50);
    });

    function initializeNotingPage() {
    $(document).ready(function () {

        var activeTab = '@ViewBag.ActiveTab';

        if (activeTab === "history") {
            $('#noting-tabs a[href="#pane-history"]').tab('show');
        }
        else {
            $('#noting-tabs a[href="#pane-noting"]').tab('show');
        }


        // Disable enable noting buttons

        var disableButtons = '@ViewBag.DisableButtons'

        if (disableButtons === "ok") {
            $("#ActionType").hide();               // hide dropdown
            $("#btnConfirm").hide();               // hide confirm button
            $("#btnNotingReset").hide();           // hide reset button
            $("#btnShowDraft").hide();              // hide Draft button
        }

        var loggedInUser = '@(Session["UserName"] ?? "")'.trim().toLowerCase();
        var des_code = '@Session["Des_Code"].ToString().Trim()';
        var isforwarded = '@Session["forwarded"].ToString()';

        if (loggedInUser !== "vcsec_vco") {
            // Hide internal tab and its content
            $("#tab-internal").closest("li").hide();
            $("#pane-internal").removeClass("show active");

            // Show file movement tab and content instead
            $("#tab-file-move").addClass("active");
            $("#pane-file-move").addClass("show active");

            // Also hide file movement tab
            $("#tab-file-move").closest("li").hide();
        }

        if (des_code === "001" || des_code === "033" || loggedInUser === "vcsec_vco") {
            $("#btnApprovedRevert, #divCheckApproved").show();
            $("#divRemark").hide();
        }
        else {
            $("#btnApprovedRevert, #divCheckApproved").hide();
            $("#divRemark").show();
        }

        if (isforwarded === "ok") {
            $("#btnForward").prop("disabled", true);
            $("#btnRevert").prop("disabled", true);
            $("#btnApprovedRevert").prop("disabled", true);
        }
        else {
            $("#btnForward").prop("disabled", false);
            $("#btnRevert").prop("disabled", false);
            $("#btnApprovedRevert").prop("disabled", false);
        }

        var docurl = "@ViewBag.MergedDocURL";
        if (docurl) {

            // strip ../Master/CreatedFile/ part
            var fileName = docurl.replace("../Master/CreatedFile/", "");
            var url = "@Url.Content("~/Uploads/CreatedFile/")" + fileName;

            $("#pdfFrame").attr("src", url);

            // store for flipbook use
            $("#pdfFrame").data("pdf-url", url);
            //$("#ddlMergedDoc").val(defaultDocId);
        }
        else {
            $("#pdfFrame").attr("src", "");
        }

        // show flipbook in fullscreen
        $("#toggleFlipbook").on("click", function () {
            const pdfViewer = $('#pdfViewer');
            const flipbookContainer = $('.flipbook-container');

            if (!flipbookContainer.hasClass('active')) {
                // Show flipbook fullscreen
                pdfViewer.hide();
                flipbookContainer.show();

                // Add body class to hide scrollbar
                $('body').addClass('flipbook-active');

                // Trigger reflow to ensure transition works
                flipbookContainer[0].offsetHeight;

                setTimeout(() => {
                    flipbookContainer.addClass("active");
                }, 50);

                const pdfUrl = $("#pdfFrame").data("pdf-url");
                console.log('PDF URL:', pdfUrl);
                console.log('pdfDoc:', pdfDoc);
                console.log('pdfjsLib available:', typeof pdfjsLib);

                if (pdfUrl && !pdfDoc) {
                    if (typeof pdfjsLib === 'undefined') {
                        console.error('pdfjsLib is not loaded!');
                        Swal.fire("Error", "PDF library not loaded", "error");
                        return;
                    }

                    pdfjsLib.getDocument(pdfUrl).promise.then(async function (pdf) {
                        pdfDoc = pdf;
                        totalPages = pdf.numPages;

                        // Set initial page indicators to Cover
                        $('#current-page, #top-current-page').text('Cover');
                        $('#total-pages, #top-total-pages').text(totalPages);

                        // Hide standalone cover, initialize Turn.js magazine directly
                        $('#flipbook-cover').hide();
                        $('#flipbook-magazine').show();

                        // Initialize Turn.js with cover as first page
                        await initTurnJsMagazine();

                    }).catch(function(error) {
                        console.error("Error loading PDF:", error);
                        Swal.fire("Error", "Failed to load PDF document", "error");
                        $('body').removeClass('flipbook-active');
                        closeFlipbook();
                    });
                } else if (pdfDoc) {
                    // PDF already loaded, initialize Turn.js directly
                    $('#current-page, #top-current-page').text('Cover');
                    $('#total-pages, #top-total-pages').text(totalPages);
                    $('#flipbook-cover').hide();
                    $('#flipbook-magazine').show();
                    initTurnJsMagazine();
                }
            } else {
                closeFlipbook();
            }
        });

        // show draft noting in ckeditor
        $(document).on("click", "#btnShowDraft", function () {
            let fileCode = "@ViewBag.FileCode";

            $.ajax({
                url: '@Url.Action("JsonDraftNoting", "User")',
                type: "GET",
                data: { fileCode: fileCode },
                success: function (res) {
                    if (res && res.success && res.data[0].Note_Desc) {

                        console.log(res);

                        // Load HTML into CKEditor
                        if (ckEditorInstance) {
                            ckEditorInstance.setData(res.data[0].Note_Desc);
                        }

                        // Add highlight + badge
                        $("#noteText").next(".note-editor").addClass("draft-highlight");
                        $("#draftBadgeContainer").html('<span class="draft-badge">Draft Mode</span>');

                        // Hide the draft indicator
                        $("#draftIndicator").fadeOut(300);

                        Swal.fire({
                            icon: 'success',
                            title: 'Draft Loaded!',
                            text: 'Your saved draft has been loaded into the editor.',
                            confirmButtonColor: '#3085d6'
                        });
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'No Draft',
                            text: 'No draft found for this file.',
                            confirmButtonColor: '#3085d6'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Unable to load draft. Please try again.',
                        confirmButtonColor: '#d33'
                    });
                }
            });
    });


        // save as final/draft noting

        $(document).on("click", "#btnConfirm", function (e) {
            e.preventDefault();

            let noteContent = ckEditorInstance.getData();
            let actionType = $("#ActionType").val();  // draft / final

            if (noteContent.trim() === "") {
                Swal.fire("Alert!", "Please enter a note before saving!", "warning");
                return;
            }

            if (actionType == '') {
                Swal.fire("Alert!", "Please select an option!", "warning");
                return;
            }

            // Disable button and show spinner
            var $btn = $("#btnConfirm");
            var originalHtml = $btn.html();
            $btn.prop('disabled', true);
            $btn.html('<span class="spinner-border spinner-border-sm mr-2"></span>Saving...');
            $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});

            $.ajax({

              url: '@Url.Action("SaveNoting", "User")',

                type: 'POST',
                data: { noting: noteContent, fileCode: '@ViewBag.FileCode', action: actionType },
                success: function (res) {
                    if (res.success) {
                        Swal.fire("Success!", res.message, "success").then((result) => {
                            if (result.isConfirmed) {
                                location.reload();
                            }
                        });
                    } else {
                        Swal.fire("Error!", res.message, "error");
                        // Re-enable button on error
                        $btn.prop('disabled', false);
                        $btn.html(originalHtml);
                        $btn.css({'opacity': '', 'cursor': ''});
                    }
                },
                error: function (xhr) {
                    Swal.fire("Error!", "Something went wrong while saving noting.", "error");
                    // Re-enable button on error
                    $btn.prop('disabled', false);
                    $btn.html(originalHtml);
                    $btn.css({'opacity': '', 'cursor': ''});
                }
            });
        });


        // Forward the file

        $("#btnForward").click(function () {


            var esttype = $("#ddlEstablishmentType").val();
            var dept = $("#ddlDepartment").val();
            var sec = $("#ddlSection").val();
            var forwardedTo = $("#ddlForwardTo").val();

            // Validation checks
            if (!esttype || esttype === "0") {
                Swal.fire("Validation Error", "Please select Establishment Type", "warning");
                return;
            }
            if (!dept || dept === "0") {
                Swal.fire("Validation Error", "Please select Department", "warning");
                return;
            }
            if (!sec || sec === "0") {
                Swal.fire("Validation Error", "Please select Section", "warning");
                return;
            }
            if (!forwardedTo || forwardedTo === "0") {
                Swal.fire("Validation Error", "Please select an Employee to forward", "warning");
                return;
            }

            // Disable button and show spinner
            var $btn = $("#btnForward");
            var originalHtml = $btn.html();
            $btn.prop('disabled', true);
            $btn.html('<span class="spinner-border spinner-border-sm mr-2"></span>Forwarding...');
            $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});

            $.ajax({

                   url: '@Url.Action("ForwardFile", "User")',
                type: 'POST',
                data: {
                    fileCode: '@ViewBag.FileCode',
                    forwardedTo: $("#ddlForwardTo").val(),
                    remark: $("#txtRemark").val(),
                    remarkType: $("#ddlRemarkType").val(),
                    //selectedRemarkType: $("#ddlRemarkType option:selected").text(),
                    selectedRemarkType: $("#ddlRemarkType option:selected").text() === "Select" ? "" : $("#ddlRemarkType option:selected").text(),
                    dept: $("#ddlDepartment").val(),
                    sec: $("#ddlSection").val(),
                    isApproved: $("#chkApprovedInternal").is(":checked"),
                    esttype: $("#ddlEstablishmentType").val()
                },
                success: function (res) {
                    if (res.success) {
                        Swal.fire("Success!", res.message, "success").then((result) => {
                            if (result.isConfirmed) {
                                location.reload();
                            }
                        });
                    } else {
                        Swal.fire("Error!", res.message, "error");
                        // Re-enable button on error
                        $btn.prop('disabled', false);
                        $btn.html(originalHtml);
                        $btn.css({'opacity': '', 'cursor': ''});
                    }
                },
                error: function (xhr) {
                    Swal.fire("Error!", "Something went wrong while forwarding the file", "error");
                    // Re-enable button on error
                    $btn.prop('disabled', false);
                    $btn.html(originalHtml);
                    $btn.css({'opacity': '', 'cursor': ''});
                }
            });
        });


        // On click of revert button show modal containing emp dropdown to revert
        // When clicking the Revert button
        $("#btnRevert").click(function () {
            $.ajax({

   url: '@Url.Action("GetRevertToList", "User")',
                type: 'POST',
                data: { fileCode: '@ViewBag.FileCode' },
                success: function (res) {

                    //console.log(res);

                    var ddl = $("#ddlRevertTo");
                    ddl.empty();

                    if (res && res.length > 0) {
                        ddl.append('<option value="">--Select Employee To Revert For--</option>');
                        $.each(res, function (i, item) {
                            ddl.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                        });
                    } else {
                        ddl.append('<option value="">--No Record Found--</option>');
                    }

                    // Show the modal after binding
                    $("#revertModal").modal("show");
                },
                error: function (xhr) {
                    Swal.fire("Error!", "Something went wrong while fetching revert list.", "error");
                }
            });
        });


        // Revert to employee
        // Confirm revert
        $("#btnConfirmRevert").click(function () {
            var revertTo = $("#ddlRevertTo").val();
            var remark = $('#ddlRemarkType').val();
            var remarktext = $('#txtRemark').val();
            //var selectedRemarkText = $("#ddlRemarkType option:selected").text();
