                                </button>
                                <button class="flipbook-btn" id="flipbook-prev" title="Previous Page">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <button class="flipbook-btn play-pause" id="flipbook-play" title="Auto Play">
                                    <i class="fas fa-play"></i>
                                </button>
                                <div class="page-indicator">
                                    <span id="current-page">0</span> / <span id="total-pages">0</span>
                                </div>
                                <button class="flipbook-btn" id="flipbook-next" title="Next Page">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                                <button class="flipbook-btn" id="flipbook-last" title="Last Page">
                                    <i class="fas fa-step-forward"></i>
                                </button>
                                <button class="flipbook-btn" id="flipbook-zoom-out" title="Zoom Out">
                                    <i class="fas fa-search-minus"></i>
                                </button>
