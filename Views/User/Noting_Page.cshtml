@model System.Data.DataTable

@{
    ViewBag.Title = "Noting_Page";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";

    var mergedDocsJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MergedDocs); // for sending it to controller

    var attachedDocs = ViewBag.AttachedDocs as System.Data.DataTable;

    var filedt = ViewBag.Filedt as System.Data.DataTable;

    var docCode = "";

    if (attachedDocs != null && attachedDocs.Rows.Count > 0)
    {
        docCode = attachedDocs.Rows[0]["Doc_Code"].ToString();
    }
}

