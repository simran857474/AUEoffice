        padding: 20px;
    }

    .au-note-block-modern {
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e3e6ee;
        box-shadow: 0 3px 12px rgba(100,140,180,0.08);
        margin-bottom: 15px;
        padding: 12px;
        transition: all 0.3s ease;
    }

        .au-note-block-modern:hover {
            box-shadow: 0 5px 20px rgba(100,140,180,0.15);
