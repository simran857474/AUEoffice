                                                        <td style="padding:6px; text-align:left; width:50%;"><strong>File Category:</strong> @row["FileCat_Name"]</td>
                                                        <td style="padding:6px; text-align:left; width:50%;"><strong>Sub Category:</strong> @row["FileSubCat_Name"]</td>
                                                    </tr>
                                                    <tr>
                                                        <td style="padding:6px; text-align:left;"><strong>Description:</strong> @row["File_Desc"]</td>
                                                        <td style="padding:6px; text-align:left;"><strong>Priority:</strong> @row["DocPrior_Name"]</td>
                                                    </tr>
                                                    <tr>
                                                        <td style="padding:6px; text-align:left;"><strong>Created By:</strong> @row["Name"]</td>
                                                        <td style="padding:6px; text-align:left;">
                                                            <strong>Date:</strong> @row["date"] / @row["time"]
