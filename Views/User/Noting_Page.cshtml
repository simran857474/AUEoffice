// send for internal movement
$("#btnSendInternal").click(function () {
    var forwardTo = $("#ddlForwardToInternal").val();
    var approved = $("#chkApprovedInternal").is(":checked");
    var fileCode = "@ViewBag.FileCode";

    if (forwardTo == '') {
        Swal.fire({
            icon: 'warning',
            title: 'Selection Required',
            text: 'Please select an option',
            confirmButtonColor: '#3085d6'
        });
        return;
    }

    $.ajax({
        url: '@Url.Action("SendInternalMovement", "User")',
        type: 'POST',
        data: { fileCode: fileCode, forwardTo: forwardTo, approved: approved, docCode: '@docCode' },
        success: function (res) {
            if (res.success) {

                // reset the dropdown
                $('#ddlEstablishmentType').val('');
                resetDropdown('#ddlDepartment');
                resetDropdown('#ddlSection');
                resetDropdown('#ddlForwardTo');

                // disable the buttons
                $("#btnForward").prop("disabled", true);
                $("#btnRevert").prop("disabled", true);
                $("#btnApprovedRevert").prop("disabled", true);

                Swal.fire("Success!", res.message, "success").then(() => {
                    location.reload();
                });

            } else {
                swal("Alert", res.message, "warning");
            }
        },
        error: function () {
            swal("Error", "Something went wrong.", "error");
        }
    });
});


        $(document).on("click", "#btnPrintAttachment", function () {
            let pdfUrl = $("#pdfFrame").attr("src");
            if (!pdfUrl) {
                Swal.fire("No Document", "Please load a document before printing.", "warning");
                return;
            }
            // Open the PDF in new tab with print dialog
            let printWindow = window.open(pdfUrl, "_blank");
            printWindow.addEventListener("load", function () {
                // Wait for images & content to load
                printWindow.onload = function () {
                    setTimeout(() => {
                        printWindow.print();
                    }, 200); //  0.2 sec delay for image loading
                };

                // Close tab after printing OR canceling
                printWindow.onafterprint = function () {
                    printWindow.close();
                };
            });
        });


        $(document).on("click", "#btnPrintNoteSheet", function () {
    let printContent = "";

    let logoUrl = $("#flipbook-cover img").attr("src");
    let filedt = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Filedt));

    // 1. Cover Page (full page layout)
    if (filedt && filedt.length > 0) {
        let row = filedt[0];

        let coverHtml = `
            <div style="display:flex; flex-direction:column; justify-content:center; align-items:center; height:100vh; font-family:Arial, sans-serif; padding:40px; box-sizing:border-box;">

                <!-- Logo -->
                <img src="${logoUrl}" alt="Logo" style="max-width:120px; margin-bottom:20px;">

                <!-- Department & Section -->
                <h2 style="margin:5px 0; font-size:24px; font-weight:bold; text-align:center;">${row.Dep_Name}</h2>
                <h3 style="margin:5px 0; font-size:18px; font-weight:normal; color:#444; text-align:center;">${row.Section}</h3>
                <h3 style="margin:5px 0; font-size:18px; font-weight:normal; color:#444; text-align:center;"><b>File Code: </b>@ViewBag.FileCode</h3>

                <!-- File Details -->
                <table style="width:100%; margin-top:30px; border-collapse:collapse; font-size:16px;">
                    <tr>

                        <td style="padding:10px; text-align:left; width:50%;"><strong>File Category:</strong> ${row.FileCat_Name}</td>
                        <td style="padding:10px; text-align:left; width:50%;"><strong>Sub Category:</strong> ${row.FileSubCat_Name}</td>
                    </tr>
                    <tr>
                        <td style="padding:10px; text-align:left;"><strong>Description:</strong> ${row.File_Desc}</td>
                        <td style="padding:10px; text-align:left;"><strong>Priority:</strong> ${row.DocPrior_Name}</td>
                    </tr>
                    <tr>
                        <td style="padding:10px; text-align:left;"><strong>Created By:</strong> ${row.Name}</td>
                        <td style="padding:10px; text-align:left;"><strong>Date:</strong> ${row.date} / ${row.time}</td>
                    </tr>
                </table>
            </div>
        `;
        printContent += `<div style="page-break-after:always;">${coverHtml}</div>`;
    }

    // 2. Notings
    $("#notingContainer .note-frame").each(function () {
        try {
            let noteHtml = this.contentDocument.body.innerHTML;
            printContent += `
                <div style="page-break-after:always; padding:40px; font-family:Arial, sans-serif;">
                    <h2 style="text-align:center; margin-bottom:20px;">Notings</h2>
                    ${noteHtml}
                </div>`;
        } catch (e) {
            console.error("Error reading note iframe:", e);
        }
    });

    // 3. Movement History
    let historyHtml = $("#historyTable").clone();
    historyHtml.find("button, .no-print").remove(); // cleanup
    printContent += `
        <div style="padding:40px; font-family:Arial, sans-serif;">
            <h2 style="text-align:center; margin-bottom:20px;">Movement History</h2>
            ${historyHtml.prop("outerHTML")}
        </div>`;

    // Open in new window for printing
    let printWindow = window.open("", "_blank");
    printWindow.document.write(`
        <html>
        <head>
            <title>Note Sheet Print</title>
            <style>
                body { font-family: Arial, sans-serif; margin:0; padding:0; }
                table { border-collapse: collapse; width: 100%; margin-top: 10px; }
                th, td { border: 1px solid #000; padding: 8px; text-align: left; }
                h2 { font-size: 22px; }
            </style>
        </head>
        <body>${printContent}</body>
        </html>
    `);
    printWindow.document.close();
    //printWindow.focus();
            //printWindow.print();

            // Wait for images & content to load
            printWindow.onload = function () {
                setTimeout(() => {
                    printWindow.print();
                }, 200); //  0.2 sec delay for image loading
            };

            // Close tab after printing OR canceling
            printWindow.onafterprint = function () {
                printWindow.close();
            };
});
    });
