<script>
    // Global variable - must be declared outside function
    var ckEditorInstance;

    // Defer execution until jQuery is loaded
    window.addEventListener('DOMContentLoaded', function() {
        // Remove flipbook-active class from body if it exists (in case it got stuck)
        document.body.classList.remove('flipbook-active');

        // Wait for jQuery to be available
        var checkJQuery = setInterval(function() {
            if (typeof jQuery !== 'undefined') {
                clearInterval(checkJQuery);
                initializeSummernote();
            }
        }, 50);
    });

    function initializeSummernote() {
    //ClassicEditor
    //    .create(document.querySelector('#noteText'), {
    //        toolbar: [
    //            'heading',
    //            '|', 'bold', 'italic', 'underline',
    //            '|', 'fontColor', 'fontSize', 'fontFamily',
    //            '|', 'bulletedList', 'numberedList',
    //            '|', 'link', 'insertTable', 'undo', 'redo'
    //        ],
    //        fontFamily: {
    //            options: [
    //                'default',
    //                'Arial, sans-serif',
    //                'Times New Roman, serif',
    //                'KrutiDev010'
    //            ]
    //        },
    //        fontSize: {
    //            options: [10, 12, 14, 'default', 18, 20, 24, 28]
    //        }
    //    })
    //    .then(editor => {
    //        ckEditorInstance = editor;
    //    })
    //    .catch(error => {
    //        console.error("CKEditor load error:", error);
    //    });

    $(document).ready(function () {
        $('#noteText').summernote({
            height: 220,
            minHeight: 150,
            maxHeight: 500,
            dialogsInBody: true,
            dialogsFade: true,
            placeholder: 'Write your noting here...',
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'underline', 'clear']],
                ['fontname', ['fontname']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
                ['insert', ['link', 'picture']],
                ['view', ['fullscreen', 'codeview', 'help']]
            ]
        });

        // Summernote ke liye getData/setData wrapper
        // Baaki code mein ckEditorInstance.getData() aur setData() use ho raha hai
        // Isliye yeh wrapper banaya — koi aur change nahi lagega
        ckEditorInstance = {
            getData: function () {
                return $('#noteText').summernote('code');
            },
            setData: function (html) {
                $('#noteText').summernote('code', html);
            },
            model: {
                change: function () { },
                document: { selection: null },
                insertContent: function () { }
            },
            data: {
                processor: { toView: function () { return null; } },
                toModel: function () { return null; }
            }
        };

        // Check for draft on page load
        checkForDraft();
    });

    } // End of initializeSummernote function

    // Function to check if draft exists
    function checkForDraft() {
        let fileCode = "@ViewBag.FileCode";

        $.ajax({
            url: '@Url.Action("JsonDraftNoting", "User")',
            type: "GET",
            data: { fileCode: fileCode },
            success: function (res) {
                //console.log("Draft check response:", res);

                // Check multiple response formats
                let hasDraft = false;

                if (res && res.success && res.data && res.data.length > 0) {
                    let note = Object.values(res.data[0])[8];

                    if (note && note.trim() !== "") {
                        hasDraft = true;
                    }
                }

                if (hasDraft) {
                    //console.log("Draft found! Showing indicator...");
                    $("#draftIndicator").fadeIn(500);
                } else {
                    //console.log("No draft found");
                }
            },
            error: function (xhr, status, error) {
                //console.log("Could not check for draft:", error);
            }
        });
    }

    // Function to load draft noting
    function loadDraftNoting() {
        let fileCode = "@ViewBag.FileCode";

        $.ajax({
            url: '@Url.Action("JsonDraftNoting", "User")',
            type: "GET",
            data: { fileCode: fileCode, performedEvent: 'clicked' },
            success: function (res) {
                if (res && res.success && res.data && res.data.length > 0) {
                    if (typeof ckEditorInstance !== 'undefined' && ckEditorInstance) {
                        ckEditorInstance.setData(Object.values(res.data[0])[8]);
                    }

                    $("#noteText").next(".note-editor").addClass("draft-highlight");
                    $("#draftBadgeContainer").html('<span class="draft-badge">Draft Mode</span>');
                    $("#draftIndicator").fadeOut(300);

                    Swal.fire({
                        icon: 'success',
                        title: 'Draft Loaded!',
                        text: 'Your saved draft has been loaded into the editor.',
                        confirmButtonColor: '#3085d6'
                    });
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Draft',
                        text: 'No draft found for this file.',
                        confirmButtonColor: '#3085d6'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Unable to load draft. Please try again.',
                    confirmButtonColor: '#d33'
                });
            }
        });
    }
</script>




