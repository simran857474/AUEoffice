                                <h5></h5>
                                <button class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#attachmentModal" id="btnAttachments">
                                    <i class="fa fa-paperclip"></i> Add Documents
                                </button>
                            </div>*@

                        <div class="row">
                            <!-- Note Sheet Section -->
                            <div class="col-md-6 d-flex">
                                <div class="au-card-modern h-100 w-100 d-flex flex-column">
                                    @*@*<div class="au-card-header-modern">
                                            <i class="fa fa-sticky-note"></i> Note Sheet
                                        </div>*@
                                    <div class="card-header text-center font-weight-bold text-white" style="background-color: #119AB2;">
                                        <i class="fa fa-sticky-note"></i> Note Sheet
                                        <button id="btnPrintNoteSheet" class="btn btn-sm btn-light float-right">
                                            <i class="fa fa-print"></i> Print
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        <!-- Noting Header -->
                                        <div class="au-noting-header-modern d-flex align-items-center mb-3">
                                            <img src="~/themeassets/demo.dashboardpack.com/architectui-html-pro/assets/images/logo-inverse.png" alt="Logo" class="au-logo-modern me-3" />
                                            <div>
                                                <div>
                                                    <strong>File No :</strong>
                                                    <span class="text-danger fw-bold">
                                                        @(ViewBag.FileCode)
                                                    </span>
                                                </div>
                                                <div>
                                                    <strong>Department / Section :</strong>
                                                    <span class="fw-bold">
                                                        @(ViewBag.DepSecName)
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Existing Notes -->
                                        <div id="notingContainer" class="au-note-list-modern mb-3 " style="max-height: 450px; overflow-y: auto;">
                                            @if (Model != null && Model.Rows.Count > 0)
                                            {
                                                foreach (System.Data.DataRow row in Model.Rows)
                                                {
                                                    <div class="au-note-block-modern">
                                                        <div class="note-wrapper">
                                                            <iframe class="note-frame bg-light" style="width: 100%; height: 300px; background-color: #D4DD7A; font-family: Source Sans Pro; overflow: auto; border: none; border-radius: 6px;"></iframe>
                                                        </div>
                                                        <script>
                                                            (function() {
                                                                var noteHtml = @Html.Raw(Json.Encode(row["Note_Desc"].ToString()));
                                                                var iframeList = document.querySelectorAll(".note-frame");
                                                                var el = iframeList[iframeList.length - 1];
                                                                var doc = el.contentDocument || el.contentWindow.document;

                                                                doc.open();
                                                                doc.write(`<body style="background-color:#D4DD7A; padding:10px; margin:0;">${noteHtml}</body>`);
                                                                doc.close();

                                                                // Auto-resize
                                                                setTimeout(function() {
                                                                    el.style.height = el.contentWindow.document.body.scrollHeight + 'px';
                                                                }, 50);

                                                                doc.addEventListener('click', function (e) {
                                                                    var a = e.target.closest('a.pdf-ref-link');
                                                                    if (a) {
                                                                        e.preventDefault();
                                                                        window.open(a.href, "_blank");
                                                                    }
                                                                });
                                                            })();
                                                        </script>

                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="au-empty-notes-modern">No notings are saved yet. Saved notes will appear here if any.</div>
                                            }
                                        </div>
                                        <!-- Add New Note -->
                                        @*<form method="post" class="au-add-note-modern no-print mb-0">*@
                                        @*@Html.AntiForgeryToken()*@
                                        @*<input type="hidden" name="fileNo" value="@(Model.Rows.Count > 0 ? Model.Rows[0]["File_Code"].ToString() : "")" />
                                            <input type="hidden" name="docCode" value="@(Model.Rows.Count > 0 ? Model.Rows[0]["Doc_Code"].ToString() : "")" />*@

                                        <div class="card">

