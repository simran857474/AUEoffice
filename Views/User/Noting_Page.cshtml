$(document).on("click", "#btnDeleteDoc", function () {
    var docCode = $(this).data("doccode");

    if (!docCode) { alert("Please select document"); return; }

    var docurl = "@ViewBag.MergedDocURL";

    // strip ../Master/CreatedFile/ part
    var fileName = docurl.replace("../Master/CreatedFile/", "");

    var fullHtml = $("#docInfo").html();
    var firstPart = fullHtml.split('<br/>')[0] + '<br/>';

    Swal.fire({
        title: 'Are you sure?',
        text: "This will permanently delete the document!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, delete it!',
        cancelButtonText: 'Cancel'
    }).then((result) => {
        if (result.isConfirmed) {
            // Disable delete button
            var $btn = $("#btnDeleteDoc");
            var originalHtml = $btn.html();
            $btn.prop('disabled', true);
            $btn.html('<span class="spinner-border spinner-border-sm mr-2"></span>Deleting...');
            $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});

            $.ajax({
                url: '@Url.Action("DeleteDocument", "User")',
                type: 'POST',
                //data: { docCode: docCode, fileCode: '@ViewBag.FileCode', docLists: '@Html.Raw(mergedDocsJson)', mergedFile: fileName, htmlText: firstPart },
                data: JSON.stringify({
                    docCode: docCode,
                    fileCode: '@ViewBag.FileCode',
                    docLists: @Html.Raw(mergedDocsJson),
                    mergedFile: fileName,
                    htmlText: firstPart
                }),
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: res.message,
                            confirmButtonColor: '#28a745',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            // Reload page after user clicks OK
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', res.message, 'error');
                        // Re-enable button on error
                        $btn.prop('disabled', false);
                        $btn.html(originalHtml);
                        $btn.css({'opacity': '', 'cursor': ''});
                    }
                },
                error: function () {
                    Swal.fire('Error!', 'Something went wrong!', 'error');
                    // Re-enable button on error
                    $btn.prop('disabled', false);
                    $btn.html(originalHtml);
                    $btn.css({'opacity': '', 'cursor': ''});
                }
            });
        }
    });
});


// Load file history on page load (for when page opens directly to history tab)
function loadFileHistory() {
    // Show loader and hide table
    $('#historyLoader').show();
    $('#historyTableContainer').hide();

    $.ajax({
        url: '@Url.Action("GetFileHistory", "User")',
        type: 'GET',
        data: { fileCode: '@ViewBag.FileCode' },
        success: function (data) {
            // Hide loader and show table
            $('#historyLoader').hide();
            $('#historyTableContainer').show();

            console.log(data);

            if (data.length > 0) {
                // Populate table
                var rows = '';
                $.each(data, function (i, item) {
                    rows += `<tr>
                    <td>${item.SNo}</td>
                    <td>@ViewBag.FileCode</td>
                    <td>${item.FileDescription}</td>
                    <td>${item.SentFrom}</td>
                    <td>${item.SentTo}</td>
                    <td>${item.ForwardedDT}</td>
                    <td>${item.Status}</td>
                    <td>${item.Remark}</td>
                </tr>`;
                });
                $("#historyTable tbody").html(rows);
            } else {
                var rows = `<tr>
                    <td colspan="8" style="text-align:center; color: gray; padding: 40px;">
                        <i class="fa fa-inbox" style="font-size: 48px; color: #ccc; display: block; margin-bottom: 10px;"></i>
                        No history found for this file.
                    </td>
                </tr>`;
                $("#historyTable tbody").html(rows);
            }
        },
        error: function () {
            // Hide loader and show table on error
            $('#historyLoader').hide();
            $('#historyTableContainer').show();

            console.log(data);

            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error fetching data.',
                confirmButtonColor: '#d33'
            });
        }
    });
}

// Call on page load
$(document).ready(function() {
    loadFileHistory();
});


$('#tab-history').on('click', function (e) {
    // Reload file history when tab is clicked
    loadFileHistory();
});



