        am5.ready(function () {

            // Create root element
            // https://www.amcharts.com/docs/v5/getting-started/#Root_element
            var root = am5.Root.new("piechart");

            // Set themes
            // https://www.amcharts.com/docs/v5/concepts/themes/
            root.setThemes([
                am5themes_Animated.new(root)
            ]);

            // hide amcharts logo
            root._logo.dispose();

            // Create chart
            // https://www.amcharts.com/docs/v5/charts/percent-charts/pie-chart/
            var chart = root.container.children.push(
                am5percent.PieChart.new(root, {
                    endAngle: 270,
                    radius: am5.percent(55)
                })
            );

            // Create series
            // https://www.amcharts.com/docs/v5/charts/percent-charts/pie-chart/#Series
            var series = chart.series.push(
                am5percent.PieSeries.new(root, {
                    valueField: "value",
                    categoryField: "category",
                    alignLabels: true,
                    legendLabelText: "{category}[/]",
                    legendValueText: "([bold]{value}[/])"
                })
            );

            series.states.create("hidden", {
                endAngle: -90
            });

            series.ticks.template.setAll({
                location: 0.5,
                //strokeWidth: 1.5
            });
            // align and wrap series name
            series.labels.template.setAll({
                fontSize: 13,
                maxWidth: 80,
                oversizedBehavior: "wrap"
            });

            // Set data
            // https://www.amcharts.com/docs/v5/charts/percent-charts/pie-chart/#Setting_data
            series.data.setAll([{
                category: "InBox",
                value: @Model.Tables[0].Rows[0]["inbox"]
            }, {
                category: "OutBox",
                value: @Model.Tables[0].Rows[0]["outbox"]
            }, {
                category: "Openend Files",
                value: @Model.Tables[0].Rows[0]["opened_files"]
            }, {
                category: "Approved Files",
                value:@Model.Tables[0].Rows[0]["approved_files"]
            }, {
                category: "Returned Files",
                value: @Model.Tables[0].Rows[0]["returned_files"]
            }, {
                    category: "Callback Files",
                    value: @Model.Tables[0].Rows[0]["callbacked_files"]
                }
            // {
            //    category: "UK",
            //    value: 99
            //}
            ]);
            // Set custom colors for each slice
            series.slices.each(function (slice, index) {
                var colors = ["#d30000", "#ffcf00", "#F18B44", "#A6009D", "#009640", "#18898D", "#B64678"];
                var sliceColor = colors[index % colors.length];
                slice.set("fill", am5.color(sliceColor));

            });

            // Create legend
            // https://www.amcharts.com/docs/v5/charts/percent-charts/legend-percent-series/
            var legend = chart.children.push(am5.Legend.new(root, {
                centerX: am5.percent(50),
                x: am5.percent(50),
                centerY: am5.percent(50),
                y: am5.percent(90)
            }));

            legend.data.setAll(series.dataItems);
            legend.markerRectangles.template.setAll({
                cornerRadiusTL: 10,
                cornerRadiusTR: 10,
                cornerRadiusBL: 10,
                cornerRadiusBR: 10
            });

            // Tooltip Customization
            series.slices.template.set("tooltipText", "{category} : [bold]{valuePercentTotal.formatNumber('0.00')}%[/] ({value})");


            series.appear(1000, 100);

        }); // end am5.ready()

        am5.ready(function () {

            // Create root element
            // https://www.amcharts.com/docs/v5/getting-started/#Root_element
            var root = am5.Root.new("donutchart");


            // Set themes
            // https://www.amcharts.com/docs/v5/concepts/themes/
            root.setThemes([
                am5themes_Animated.new(root)
            ]);

            // hide amcharts logo
            root._logo.dispose();

            // Create chart
            // https://www.amcharts.com/docs/v5/charts/percent-charts/pie-chart/
            var chart = root.container.children.push(am5percent.PieChart.new(root, {
                layout: root.verticalLayout,
                innerRadius: am5.percent(50),
                radius: am5.percent(60)
            }));


            // Create series
            // https://www.amcharts.com/docs/v5/charts/percent-charts/pie-chart/#Series
            var series = chart.series.push(
                am5percent.PieSeries.new(root, {
                    valueField: "value",
                    categoryField: "category",
                    alignLabels: true,
                    legendLabelText: "{category}[/]",
                    legendValueText: "([bold]{value}[/])"
                })
            );

            series.labels.template.setAll({
                textType: "circular",
                centerX: 0,
                centerY: 0
            });

            series.ticks.template.setAll({
                location: 0.5,
                //strokeWidth: 1.5
            });
            // align and wrap series name
            series.labels.template.setAll({
                fontSize: 13,
                maxWidth: 80,
                oversizedBehavior: "wrap"
            });

            // Set data
            // https://www.amcharts.com/docs/v5/charts/percent-charts/pie-chart/#Setting_data
            series.data.setAll([
               /* { value: 10, category: "One" },*/
                { value: @Model.Tables[0].Rows[0]["handover_files"], category: "Handover Files" },
                { value: @Model.Tables[0].Rows[0]["created_files"], category: "Created File" },
                { value: @Model.Tables[0].Rows[0]["vc_signed_files"], category: "Signed File from VC" },
                { value: @Model.Tables[0].Rows[0]["internal_movement"], category: "Internal Movement" },
                { value:@Model.Tables[0].Rows[0]["document_count"], category: "Created Document" },
                { value:@Model.Tables[0].Rows[0]["file_history"], category: "File History" },
            ]);

            // Set custom colors for each slice
            series.slices.each(function (slice, index) {
                var colors = ["#d30000", "#ffcf00", "#F18B44", "#A6009D", "#009640", "#18898D", "#B64678"];
                var sliceColor = colors[index % colors.length];
                slice.set("fill", am5.color(sliceColor));

            });

            // Create legend
            // https://www.amcharts.com/docs/v5/charts/percent-charts/legend-percent-series/
            var legend = chart.children.push(am5.Legend.new(root, {
                centerX: am5.percent(50),
                x: am5.percent(50),
                centerY: am5.percent(50),
                y: am5.percent(90)
            }));

            legend.data.setAll(series.dataItems);
            legend.markerRectangles.template.setAll({
                cornerRadiusTL: 10,
                cornerRadiusTR: 10,
                cornerRadiusBL: 10,
                cornerRadiusBR: 10
            });

            // Tooltip Customization
            series.slices.template.set("tooltipText", "{category} : [bold]{valuePercentTotal.formatNumber('0.00')}%[/] ({value})");



            // Play initial series animation
            // https://www.amcharts.com/docs/v5/concepts/animations/#Animation_of_series
            series.appear(1000, 100);

            //// Tooltip Customization
            //series.slices.template.set("tooltipText", "{category} : [bold]{valuePercentTotal.formatNumber('0.00')}%[/] ({value})");


            //series.appear(1000, 100);
        }); // end am5.ready()

    </script>
