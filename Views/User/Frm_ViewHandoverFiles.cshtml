
@{
    ViewBag.Title = "Frm_ViewHandoverFiles";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";


    var inbox = ViewBag.PendingFiles as System.Data.DataTable;
    var opened = ViewBag.OpenedFiles as System.Data.DataTable;
    var approved = ViewBag.ApprovedFiles as System.Data.DataTable;
}

<style>
    .table-scroll-wrapper {
        max-height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
    }

    .table-scroll-wrapper table {
        margin-bottom: 0;
    }

    .table-scroll-wrapper thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 10;
        box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1);
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="tabs-animation">
            <!-- Top Note -->
            <!--<div class="alert alert-warning text-center mb-4">
                <strong>Note:</strong> This page is only for those persons who have retired or have been transferred.
            </div>-->

            <div id="accordionMain" class="accordion-wrapper mb-3">

                <!-- Accordion 1 - Inbox -->
                <div class="card">
                    <div class="card-header" id="headingInbox">
                        <button type="button" class="btn btn-link btn-block text-left m-0 p-0" data-toggle="collapse" data-target="#collapseInbox" aria-expanded="true" aria-controls="collapseInbox">
                            <h5 class="m-0 p-0 card-title">Inbox Files - @ViewBag.InboxCount<i class="float-right pe-7s-angle-down"></i></h5>
                        </button>
                    </div>
                    <div id="collapseInbox" class="collapse" aria-labelledby="headingInbox" data-parent="#accordionMain">
                        <div class="card-body p-0">
                            @if (inbox != null && inbox.Rows.Count > 0)
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table table-hover table-condensed table-head-fixed">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <input type="checkbox" onclick="checkAll(this, 'chkInbox')" />
                                                </th>
                                                <th>S.No</th>
                                                <th>File No</th>
                                                <th>Description</th>
                                                <th>Category</th>
                                                <th>Sub Category</th>
                                                <th>Section</th>
                                                <th>Sent From</th>
                                                <th>Sent To</th>
                                                <th>Sending Date</th>
                                                <th>Priority</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int sno = 1;
                                                foreach (System.Data.DataRow row in inbox.Rows)
                                                {
                                                    <tr>
                                                        <td><input type="checkbox" name="chkInbox" value="@row["File_Code"]" /></td>
                                                        <td>@sno</td>
                                                        <td>@row["File_Code"]</td>
                                                        <td>@row["File_Desc"]</td>
                                                        <td>@row["FileCat_Name"]</td>
                                                        <td>@row["FileSubCat_Name"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["F_From"]</td>
                                                        <td>@row["F_To"]</td>
                                                        <td>@row["sent_dt"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["File_status"]</td>
                                                    </tr>
                                                    sno++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="p-3">No inbox records available.</p>
                            }
                        </div>
                    </div>
                </div>


                <!-- Accordion 3 - Opened Files -->
                <div class="card">
                    <div class="card-header" id="headingOpened">
                        <button type="button" class="btn btn-link btn-block text-left m-0 p-0" data-toggle="collapse" data-target="#collapseOpened" aria-expanded="false" aria-controls="collapseOpened">
                            <h5 class="m-0 p-0 card-title">Opened Files - @ViewBag.OpenFileCount<i class="float-right pe-7s-angle-down"></i></h5>
                        </button>
                    </div>
                    <div id="collapseOpened" class="collapse" aria-labelledby="headingOpened" data-parent="#accordionMain">
                        <div class="card-body p-0">
                            @if (opened != null && opened.Rows.Count > 0)
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table table-hover table-condensed table-head-fixed">
                                        <thead>
                                            <tr>
                                                <th><input type="checkbox" onclick="checkAll(this, 'chkOpened')" /></th>
                                                <th>S.No</th>
                                                <th>File No</th>
                                                <th>Description</th>
                                                <th>Category</th>
                                                <th>Sub Category</th>
                                                <th>Section</th>
                                                <th>Priority</th>
                                                <th>Created Date</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int sno = 1;
                                                foreach (System.Data.DataRow row in opened.Rows)
                                                {
                                                    <tr>
                                                        <td><input type="checkbox" name="chkOpened" value="@row["File_Code"]" /></td>
                                                        <td>@sno</td>
                                                        <td>@row["File_Code"]</td>
                                                        <td>@row["File_Desc"]</td>
                                                        <td>@row["FileCat_Name"]</td>
                                                        <td>@row["FileSubCat_Name"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["Created_DT"]</td>
                                                        <td>@row["File_status"]</td>
                                                    </tr>
                                                    sno++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="p-3">No opened records available.</p>
                            }
                        </div>
                    </div>
                </div>


                <!-- Accordion 2 - Approved -->
                <div class="card">
                    <div class="card-header" id="headingApproved">
                        <button type="button" class="btn btn-link btn-block text-left m-0 p-0" data-toggle="collapse" data-target="#collapseApproved" aria-expanded="false" aria-controls="collapseApproved">
                            <h5 class="m-0 p-0 card-title">Approved Files - @ViewBag.ApproveFileCount<i class="float-right pe-7s-angle-down"></i></h5>
                        </button>
                    </div>
                    <div id="collapseApproved" class="collapse" aria-labelledby="headingApproved" data-parent="#accordionMain">
                        <div class="card-body p-0">
                            @if (approved != null && approved.Rows.Count > 0)
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table table-hover table-condensed table-head-fixed">
                                        <thead>
                                            <tr>
                                                <th><input type="checkbox" onclick="checkAll(this, 'chkApproved')" /></th>
                                                <th>S.No</th>
                                                <th>File No</th>
                                                <th>Description</th>
                                                <th>Category</th>
                                                <th>Sub Category</th>
                                                <th>Section</th>
                                                <th>Sent From</th>
                                                <th>Sent To</th>
                                                <th>Sent Date</th>
                                                <th>Priority</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int sno = 1;
                                                foreach (System.Data.DataRow row in approved.Rows)
                                                {
                                                    <tr>
                                                        <td><input type="checkbox" name="chkApproved" value="@row["File_Code"]" /></td>
                                                        <td>@sno</td>
                                                        <td>@row["File_Code"]</td>
                                                        <td>@row["File_Desc"]</td>
                                                        <td>@row["FileCat_Name"]</td>
                                                        <td>@row["FileSubCat_Name"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["F_From"]</td>
                                                        <td>@row["F_To"]</td>
                                                        <td>@row["sent_dt"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["File_status"]</td>
                                                    </tr>
                                                    sno++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="p-3">No approved records available.</p>
                            }
                        </div>
                    </div>
                </div>


            </div>

            <!-- HandOver Section -->
            <div class="card mt-4">
                <div class="card-body">
                    @*<h5>Hand Over</h5>*@

                    <div class="form-row">
                        <div class="col-md-3">
                            <label for="handoverTo">Establishment Type:</label>
                            @Html.DropDownList("ddlEstablishmentType", new SelectList(ViewBag.EstType as List<SelectListItem>, "Value", "Text"), "Select", new { @class = "form-control mb-3", id = "ddlEstablishmentType" })
                        </div>

                        <div class="col-md-3">
                            <label for="handoverTo">Department:</label>
                            <select id="ddlDepartment" name="Dep_Code" class="form-control mb-3">
                                <option value="">--Select--</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="handoverTo">Section:</label>
                            <select name="Sec_Code" id="ddlSection" class="form-control mb-3">
                                <option value="">--Select--</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="handoverTo">Forwarded To:</label>
                            <select id="ddlForwardTo" class="form-control mb-3">
                                <option value="">--Select--</option>
                            </select>
                        
                        </div>
                    </div>
                    


                    <button type="button" class="btn btn-primary" id="btnForward">Forward</button>
                    <button type="button" class="btn btn-danger" id="btnCancel">Cancel</button>
                </div>
            </div>
        </div>

    </div>
</section>


<script src="~/Scripts/jquery-3.7.1.min.js"></script>

<script>

    // Check All function for select all checkboxes
    function checkAll(source, name) {
        var checkboxes = document.getElementsByName(name);
        for (var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].checked = source.checked;
        }
    }

    // Bind department on estype change
    $('#ddlEstablishmentType').change(function () {
        var estTypeCode = $(this).val();

        // Reset all dependent dropdowns when establishment type changes
        resetDropdown('#ddlDepartment');
        resetDropdown('#ddlSection');
        resetDropdown('#ddlForwardTo');

        if (estTypeCode) {
            $.ajax({
                //url: '/User/GetDepartmentsByEstType',
                 url: '@Url.Action("GetDepartmentsByEstType", "User")',
                type: 'POST',
                data: { estTypeCode: estTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlDepartment');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: '--Select--'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading departments.');
                }
            });
        }
    });

    // Bind section on department change
    $('#ddlDepartment').change(function () {
        var Dep_Code = $(this).val();
        var EstTypeCode = $('#ddlEstablishmentType').val();

        // Reset dependent dropdowns when department changes
        resetDropdown('#ddlSection');
        resetDropdown('#ddlForwardTo');

        if (EstTypeCode && Dep_Code) {
            $.ajax({
                //url: '/User/GetSectionsByDepartment',
                     url: '@Url.Action("GetSectionsByDepartment", "User")',
                type: 'POST',
                data: { Dep_Code: Dep_Code, EstTypeCode: EstTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlSection');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: '--Select--'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading sections.');
                }
            });
        }
    });

    // Bind forward to employee on section change
    $('#ddlSection').change(function () {
        var secCode = $(this).val();
        var deptCode = $('#ddlDepartment').val();

        // Reset forward to dropdown when section changes
        resetDropdown('#ddlForwardTo');

        if (secCode && deptCode) {
            $.ajax({
                //url: '/User/GetHandoverForwardToList',
                    url: '@Url.Action("GetHandoverForwardToList", "User")',
                type: 'POST',
                data: { secCode: secCode, deptCode: deptCode },
                success: function (data) {
                    var forwardDropdown = $('#ddlForwardTo');
                    forwardDropdown.empty();
                    forwardDropdown.append($('<option/>', {
                        value: '',
                        text: '--Select--'
                    }));

                    $.each(data, function (i, item) {
                        forwardDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading forward-to list.');
                }
            });
        }
    });

    // Reset dropdown on reset button click
    $('#btnCancel').click(function () {
        $('#ddlEstablishmentType').val('');
        resetDropdown('#ddlDepartment');
        resetDropdown('#ddlSection');
        resetDropdown('#ddlForwardTo');
    });


    function resetDropdown(dropdownId) {
        $(dropdownId).empty().append($('<option/>', {
            value: '',
            text: '--Select--'
        }));
    }

    $("#btnForward").click(function () {

        var esttype = $("#ddlEstablishmentType").val();
        var dept = $("#ddlDepartment").val();
        var sec = $("#ddlSection").val();
        var forwardedTo = $("#ddlForwardTo").val();

        // Validation checks
        if (!esttype || esttype === "0") {
            Swal.fire("Validation Error", "Please select Establishment Type", "warning");
            return;
        }
        if (!dept || dept === "0") {
            Swal.fire("Validation Error", "Please select Department", "warning");
            return;
        }
        if (!sec || sec === "0") {
            Swal.fire("Validation Error", "Please select Section", "warning");
            return;
        }
        if (!forwardedTo || forwardedTo === "0") {
            Swal.fire("Validation Error", "Please select an Employee to forward", "warning");
            return;
        }

        var files = [];

        // Inbox
        $("input[name='chkInbox']:checked").each(function () {
            files.push({ fileCode: $(this).val(), flag: "I" });
        });

        // Opened
        $("input[name='chkOpened']:checked").each(function () {
            files.push({ fileCode: $(this).val(), flag: "O" });
        });

        // Approved
        $("input[name='chkApproved']:checked").each(function () {
            files.push({ fileCode: $(this).val(), flag: "A" });
        });

        if (files.length === 0) {
            alert("Please select at least one file.");
            return;
        }

        // Disable button and show spinner
        var $btn = $("#btnForwardHandover");
        var originalHtml = $btn.html();
        $btn.prop('disabled', true);
        $btn.html('<span class="spinner-border spinner-border-sm mr-2"></span>Forwarding...');
        $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});

        $.ajax({
            url: '@Url.Action("ForwardReceivedHandOverFiles", "User")',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            //headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            data: JSON.stringify({ forwardedTo: forwardedTo, files: files }),
            success: function (data) {
                if (data.success) {
                    Swal.fire("Success!", data.message, "success").then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                } else {
                    Swal.fire("Error!", data.message, "error");
                    // Re-enable button on error
                    $btn.prop('disabled', false);
                    $btn.html(originalHtml);
                    $btn.css({'opacity': '', 'cursor': ''});
                }
            },
            error: function (xhr, status, error) {
                Swal.fire("Error!", "Something went wrong while forwarding the files.", "error");
                // Re-enable button on error
                $btn.prop('disabled', false);
                $btn.html(originalHtml);
                $btn.css({'opacity': '', 'cursor': ''});
            }
        });
    });

</script>
