@{
    ViewBag.Title = "HandOverFile";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";

    var inbox = ViewBag.PendingFiles as System.Data.DataTable;
    var opened = ViewBag.OpenedFiles as System.Data.DataTable;
    var approved = ViewBag.ApprovedFiles as System.Data.DataTable;
}

<style>
    .table-scroll-wrapper {
        max-height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
    }

    .table-scroll-wrapper table {
        margin-bottom: 0;
    }

    .table-scroll-wrapper thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 10;
        box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1);
    }
</style>


<section class="content">
    <div class="container-fluid">

        <div class="tabs-animation">
            <!-- Top Note -->
            <div class="alert alert-warning text-center mb-4">
                <strong>Note:</strong> This page is only for those persons who have retired or have been transferred.
            </div>

            <div id="accordionMain" class="accordion-wrapper mb-3">

                <!-- Accordion 1 - Inbox -->
                <div class="card">
                    <div class="card-header" id="headingInbox">
                        <button type="button" class="btn btn-link btn-block text-left m-0 p-0" data-toggle="collapse" data-target="#collapseInbox" aria-expanded="true" aria-controls="collapseInbox">
                            <h5 class="m-0 p-0 card-title">Inbox Files - @ViewBag.InboxCount<i class="float-right pe-7s-angle-down"></i></h5>
                        </button>
                    </div>
                    <div id="collapseInbox" class="collapse" aria-labelledby="headingInbox" data-parent="#accordionMain">
                        <div class="card-body p-0">
                            @if (inbox != null && inbox.Rows.Count > 0)
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table table-hover table-condensed table-head-fixed">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <input type="checkbox" onclick="checkAll(this, 'chkInbox')" />
                                                </th>
                                                <th>S.No</th>
                                                <th>File No</th>
                                                <th>Description</th>
                                                <th>Category</th>
                                                <th>Sub Category</th>
                                                <th>Section</th>
                                                <th>Sent From</th>
                                                <th>Sent To</th>
                                                <th>Sending Date</th>
                                                <th>Priority</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int sno = 1;
                                                foreach (System.Data.DataRow row in inbox.Rows)
                                                {
                                                    <tr>
                                                        <td><input type="checkbox" name="chkInbox" value="@row["File_Code"]" /></td>
                                                        <td>@sno</td>
                                                        <td>@row["File_Code"]</td>
                                                        <td>@row["File_Desc"]</td>
                                                        <td>@row["FileCat_Name"]</td>
                                                        <td>@row["FileSubCat_Name"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["F_From"]</td>
                                                        <td>@row["F_To"]</td>
                                                        <td>@row["sent_dt"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["File_status"]</td>
                                                    </tr>
                                                    sno++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="p-3">No inbox records available.</p>
                            }
                        </div>
                    </div>
                </div>


                <!-- Accordion 3 - Opened Files -->
                <div class="card">
                    <div class="card-header" id="headingOpened">
                        <button type="button" class="btn btn-link btn-block text-left m-0 p-0" data-toggle="collapse" data-target="#collapseOpened" aria-expanded="false" aria-controls="collapseOpened">
                            <h5 class="m-0 p-0 card-title">Opened Files - @ViewBag.OpenFileCount<i class="float-right pe-7s-angle-down"></i></h5>
                        </button>
                    </div>
                    <div id="collapseOpened" class="collapse" aria-labelledby="headingOpened" data-parent="#accordionMain">
                        <div class="card-body p-0">
                            @if (opened != null && opened.Rows.Count > 0)
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table table-hover table-condensed table-head-fixed">
                                        <thead>
                                            <tr>
                                                <th><input type="checkbox" onclick="checkAll(this, 'chkOpened')" /></th>
                                                <th>S.No</th>
                                                <th>File No</th>
                                                <th>Description</th>
                                                <th>Category</th>
                                                <th>Sub Category</th>
                                                <th>Section</th>
                                                <th>Priority</th>
                                                <th>Created Date</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int sno = 1;
                                                foreach (System.Data.DataRow row in opened.Rows)
                                                {
                                                    <tr>
                                                        <td><input type="checkbox" name="chkOpened" value="@row["File_Code"]" /></td>
                                                        <td>@sno</td>
                                                        <td>@row["File_Code"]</td>
                                                        <td>@row["File_Desc"]</td>
                                                        <td>@row["FileCat_Name"]</td>
                                                        <td>@row["FileSubCat_Name"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["Created_DT"]</td>
                                                        <td>@row["File_status"]</td>
                                                    </tr>
                                                    sno++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="p-3">No opened records available.</p>
                            }
                        </div>
                    </div>
                </div>


                <!-- Accordion 2 - Approved -->
                <div class="card">
                    <div class="card-header" id="headingApproved">
                        <button type="button" class="btn btn-link btn-block text-left m-0 p-0" data-toggle="collapse" data-target="#collapseApproved" aria-expanded="false" aria-controls="collapseApproved">
                            <h5 class="m-0 p-0 card-title">Approved Files - @ViewBag.ApproveFileCount<i class="float-right pe-7s-angle-down"></i></h5>
                        </button>
                    </div>
                    <div id="collapseApproved" class="collapse" aria-labelledby="headingApproved" data-parent="#accordionMain">
                        <div class="card-body p-0">
                            @if (approved != null && approved.Rows.Count > 0)
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table table-hover table-condensed table-head-fixed">
                                        <thead>
                                            <tr>
                                                <th><input type="checkbox" onclick="checkAll(this, 'chkApproved')" /></th>
                                                <th>S.No</th>
                                                <th>File No</th>
                                                <th>Description</th>
                                                <th>Category</th>
                                                <th>Sub Category</th>
                                                <th>Section</th>
                                                <th>Sent From</th>
                                                <th>Sent To</th>
                                                <th>Sent Date</th>
                                                <th>Priority</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int sno = 1;
                                                foreach (System.Data.DataRow row in approved.Rows)
                                                {
                                                    <tr>
                                                        <td><input type="checkbox" name="chkApproved" value="@row["File_Code"]" /></td>
                                                        <td>@sno</td>
                                                        <td>@row["File_Code"]</td>
                                                        <td>@row["File_Desc"]</td>
                                                        <td>@row["FileCat_Name"]</td>
                                                        <td>@row["FileSubCat_Name"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["F_From"]</td>
                                                        <td>@row["F_To"]</td>
                                                        <td>@row["sent_dt"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["File_status"]</td>
                                                    </tr>
                                                    sno++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="p-3">No approved records available.</p>
                            }
                        </div>
                    </div>
                </div>


            </div>

            <!-- HandOver Section -->
            <div class="card mt-4">
                <div class="card-body">
                    @*<h5>Hand Over</h5>*@
                    <div class="form-group">
                        <label for="handoverTo">Hand Over To</label>
                        @Html.DropDownList("ddlSectionHeads", new SelectList(ViewBag.SectionHeads as List<SelectListItem>, "Value", "Text"), "Select", new { @class = "form-control mb-3", id = "ddlSectionHead" })
                    </div>

                    <div class="form-check my-3">
                        <input type="checkbox" class="form-check-input" id="confirmHandover">
                        <label class="form-check-label" for="confirmHandover">I confirm that I am handing over the files.</label>
                    </div>

                    <button type="button" class="btn btn-primary" id="btnHandover" disabled>Hand Over</button>
                </div>
            </div>
        </div>

    </div>
</section>


<script src="~/Scripts/jquery-3.7.1.min.js"></script>

<script>
            // Enable button only if checkbox is checked
            document.getElementById("confirmHandover").addEventListener("change", function () {
                document.getElementById("btnHandover").disabled = !this.checked;
            });

            function checkAll(source, name) {
                var checkboxes = document.getElementsByName(name);
                for (var i = 0; i < checkboxes.length; i++) {
                    checkboxes[i].checked = source.checked;
                }
            }

    $("#btnHandover").click(function () {
        var handoverTo = $("#ddlSectionHead").val();
        if (!handoverTo) {
            alert("Please select Hand Over To");
            return;
        }

        var files = [];

        // Inbox
        $("input[name='chkInbox']:checked").each(function () {
            files.push({ fileCode: $(this).val(), flag: "I" });
        });

        // Opened
        $("input[name='chkOpened']:checked").each(function () {
            files.push({ fileCode: $(this).val(), flag: "O" });
        });

        // Approved
        $("input[name='chkApproved']:checked").each(function () {
            files.push({ fileCode: $(this).val(), flag: "A" });
        });

        if (files.length === 0) {
            alert("Please select at least one file.");
            return;
        }

        // Disable button and show spinner
        var $btn = $("#btnHandOver");
        var originalHtml = $btn.html();
        $btn.prop('disabled', true);
        $btn.html('<span class="spinner-border spinner-border-sm mr-2"></span>Processing...');
        $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});

        $.ajax({
            url: '@Url.Action("HandOverFiles", "User")',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            //headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            data: JSON.stringify({ handoverTo: handoverTo, files: files }),
            success: function (data) {
                if (data.success) {
                    Swal.fire("Success!", data.message, "success").then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                } else {
                    Swal.fire("Error!", data.message, "error");
                    // Re-enable button on error
                    $btn.prop('disabled', false);
                    $btn.html(originalHtml);
                    $btn.css({'opacity': '', 'cursor': ''});
                }
            },
            error: function (xhr, status, error) {
                Swal.fire("Error!", "Something went wrong while handing over the files.", "error");
                // Re-enable button on error
                $btn.prop('disabled', false);
                $btn.html(originalHtml);
                $btn.css({'opacity': '', 'cursor': ''});
            }
        });
    });

</script>

