@model System.Data.DataTable

@{
    ViewBag.Title = "Files_History";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<section class="content">
    <div class="container-fluid">

        @*@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <strong>Notice:</strong> @ViewBag.ErrorMessage
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }*@

        <!--  Search Section -->
        <div id="accordionSearch" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div class="card-header">
                    <h5 class="m-0 p-0">Search Files</h5>
                </div>
                <div class="card-body">
                    <!-- 🔹 Nav tabs -->
                    <ul class="nav nav-tabs mb-3" id="searchTabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="tabFinYear-tab" data-toggle="tab" href="#searchFinYear" role="tab" aria-controls="searchFinYear" aria-selected="true">Search by Financial Year</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="tabDate-tab" data-toggle="tab" href="#searchDate" role="tab" aria-controls="searchDate" aria-selected="false">Search by Date</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="tabFileNo-tab" data-toggle="tab" href="#searchFileNo" role="tab" aria-controls="searchFileNo" aria-selected="false">Search by File No</a>
                        </li>
                    </ul>

                    <!-- 🔹 Tab panes -->
                    <div class="tab-content" id="searchTabsContent">
                        <!--  Financial Year Search -->
                        <div class="tab-pane fade show active" id="searchFinYear" role="tabpanel" aria-labelledby="tabFinYear-tab">
                            <div class="d-flex align-items-end mb-3">
                                <div class=" mr-3">
                                    <label>Select Financial Year</label>
                                    @Html.DropDownList("FinYear", new SelectList(ViewBag.FinancialYear as List<SelectListItem>, "Value", "Text"),
                                     new { @class = "form-control", id = "Fin_Year" })
                                </div>
                                <div>
                                    <button type="button" class="btn btn-primary" id="btnFinYearSearch">Search</button>
                                </div>
                            </div>
                        </div>

                        <!--  Date Range Search -->
                        <div class="tab-pane fade" id="searchDate" role="tabpanel" aria-labelledby="tabDate-tab">
                            <div class="d-flex align-items-end mb-3">
                                <div class=" mr-3">
                                    <label>From Date</label>
                                    <input type="date" id="FromDate" class="form-control" />
                                </div>
                                <div class=" mr-3">
                                    <label>To Date</label>
                                    <input type="date" id="ToDate" class="form-control" />
                                </div>
                                <div>
                                    <button type="button" class="btn btn-success" id="btnDateSearch">Search</button>
                                </div>
                            </div>
                        </div>

                        <!--  File No Search -->
                        <div class="tab-pane fade" id="searchFileNo" role="tabpanel" aria-labelledby="tabFileNo-tab">
                            <div class="d-flex align-items-end mb-3">
                                <div class=" mr-3">
                                    <label>File No</label>
                                    <input type="text" id="txtFileNo" class="form-control" placeholder="Enter File Number" />
                                </div>
                                <div>
                                    <button type="button" class="btn btn-info" id="btnFileNoSearch">Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

