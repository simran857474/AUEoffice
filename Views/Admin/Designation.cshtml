@model List<Eoffice.Models.ModelDesignation>
@{
    ViewBag.Title = "Designation";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
@{
    var editDes = ViewBag.EditDesignation as Eoffice.Models.ModelDesignation;
    bool isEdit = editDes != null;
}
<div class="app-page-title app-page-title-simple">
    <div class="page-title-wrapper">
        <div class="page-title-heading">
            <div>
                <div class="page-title-head center-elem">
                    <span class="d-inline-block pr-2">
                        <i class="lnr-apartment opacity-6"></i>
                    </span>
                    @*<span class="d-inline-block">Add Designation</span>*@
                </div>

            </div>
        </div>

    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div id="accordion5" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingfive" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne5" aria-expanded="true" aria-controls="collapseOne5" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">Add Designation<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion5" id="collapseOne5" aria-labelledby="headingfive" class="collapse @(isEdit ? "show" : "")">
                    <div class="card-body">
                        @*<h5 class="card-title">Add Department</h5>*@
                        @using (Html.BeginForm(isEdit ? "EditDesignation" : "Designation", "Admin", FormMethod.Post, new { id = "designationForm" }))
                        {
                            <input type="hidden" name="DesCode" value="@(isEdit?editDes.DesCode:"")" />
                            <div class="form-row">

                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleDesination111" class="">Designation Name</label>
                                        <input name="DesName" id="ddlDesignation" placeholder="Enter Designation Name" type="Text" class="form-control" value="@(isEdit ? editDes.DesName : "")">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleShortName111" class="">Designation Short Name </label>
                                        <input name="Shrt_Name" id="Desshortname" placeholder="Enter Designation Short Name" type="text" class="form-control" value="@(isEdit ? editDes.Shrt_Name : "")">
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <input type="submit" class="mt-2 ml-2 btn btn-primary" value="@(isEdit ? "Update" : "Submit")" />
                                <input type="reset" class="mt-2 ml-2 btn btn-success" value="Reset" />
                            </div>

                        }

                    </div>
                    <br />
                </div>
            </div>
        </div>
 

        <div id="accordion6" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingSix" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne6" aria-expanded="true" aria-controls="collapseOne6" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">Designation List<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion6" id="collapseOne6" aria-labelledby="headingSix" class="collapse show">

                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails" >
                                <div>

                                    <table style="width: 100%;" id="scr-vtr-dynamic" class="example1 table table-striped table-bordered  table-hover text-center">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th>Designation Name</th>
                                                <th>Designation Short Name</th>
                                                <th>Status</th>
                                                <th>Edit</th>

                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model != null && Model.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@item.DesName</td>
                                                        <td>@item.Shrt_Name</td>
                                                        <td>@(item.Active == "False" ? "Active" : "InActive")</td>
                                                        <td>
                                                            @Html.ActionLink("Edit", "Designation", "Admin", new { Des_Code = item.DesCode }, new { @class = "btn btn-sm btn-warning" })
                                                            @*@Html.ActionLink("Delete", "DeleteDesignation", "Admin", new { Des_Code = item.DesCode }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this designation?');" })*@

                                                        </td>


                                                    </tr>
                                                    i++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="6">No records found</td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script>
    $("#designationForm").validate({
        errorClass: "text-danger",
        validClass: "is-valid",
        errorElement: "span",
        rules: {
            DesName: { required: true },
            Shrt_Name: { required: true },

        },
        messages: {
            DesName: { required: "Please enter designation " },
            Shrt_Name: { required: "Please enter short name" },
        },
        highlight: function (element) {
            $(element).removeClass("is-valid").addClass("error");
        },
        unhighlight: function (element) {
            $(element).removeClass("error").addClass("is-valid");
        },
        errorPlacement: function (error, element) {
            error.insertAfter(element);
        },
        submitHandler: function(form) {
            // Disable button and show spinner
            var $btn = $('#designationForm input[type="submit"]');
            var originalVal = $btn.val();
            $btn.prop('disabled', true);
            $btn.val('Processing...');
            $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});
            form.submit();
        }
    });
</script>

@section Scripts {
    <script>
        $(document).ready(function () {
            var message = '@TempData["insertmsg"]';

            if (message) {
                switch (message) {
                    case "1":
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Designation inserted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "2":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to insert Designation.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updated":
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: 'Designation updated successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updatefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to update Designation.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deleted":
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Designation deleted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deletefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to delete Designation.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    default:
                        // Optional: handle other messages
                        break;
                }
            }
        });
    </script>
}
