    <script>
        function showValidation(input, condition, message) {
            const $input = $(input);
            $input.removeClass("is-valid is-invalid");

            if (condition) {
                $input.addClass("is-valid");
                $input.next('.invalid-feedback').remove();
            } else {
                $input.addClass("is-invalid");
                if ($input.next('.invalid-feedback').length === 0) {
                    $input.after(`<div class="invalid-feedback">${message}</div>`);
                }
            }
        }

        $(document).ready(function () {
            // Contact Number validation (Indian numbers only)
            $('#Contact').on('input blur', function () {
                const pattern = /^[6-9]\d{9}$/;
                const isValid = pattern.test(this.value);
                showValidation(this, isValid, "Please enter a valid Indian mobile number (10 digits starting with 6-9).");
            });

            // Email validation
            $('#Email').on('input blur', function () {
                const pattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                const isValid = pattern.test(this.value);
                showValidation(this, isValid, "Please enter a valid email address.");
            });

            // Name validation (alphabetical only)
            $('#EmpName').on('input blur', function () {
                const pattern = /^[A-Za-z\s]{2,}$/;
                const isValid = pattern.test(this.value);
                showValidation(this, isValid, "Name should contain only alphabets.");
            });

            $('#EmpCode').on('input blur', function () {
                const isValid = this.value.trim().length > 0;
                showValidation(this, isValid, "Employee code is required.");
            });

            $('#EmpFather').on('input blur', function () {
                const pattern = /^[A-Za-z\s]{2,}$/;
                const isValid = pattern.test(this.value);
                showValidation(this, isValid, "Father's name should contain only alphabets.");
            });

            //$('#SpouseName').on('input blur', function () {
            //    if (this.value.trim() === "") return;
            //    const pattern = /^[A-Za-z\s]{2,}$/;
            //    const isValid = pattern.test(this.value);
            //    showValidation(this, isValid, "Spouse name should contain only alphabets.");
            //});

            $('#DOB').on('blur', function () {
                const isValid = this.value !== "";
                showValidation(this, isValid, "Date of birth is required.");
            });

            //$('#Adhar').on('input blur', function () {
            //    const pattern = /^\d{12}$/;
            //    const isValid = pattern.test(this.value);
            //    showValidation(this, isValid, "Adhar number must be 12 digits.");
            //});

            //$('#Address').on('input blur', function () {
            //    const isValid = this.value.trim().length >= 5;
            //    showValidation(this, isValid, "Address should be at least 5 characters.");
            //});

            //$('#Remark').on('input blur', function () {
            //    const isValid = this.value.trim().length >= 3;
            //    showValidation(this, isValid, "Remark should be at least 3 characters.");
            //});

            // Form submission validation
            $('#employeeForm').on('submit', function (e) {
                $(this).find('input, select').trigger('blur');

                if ($(this).find('.is-invalid').length > 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Validation Error!',
                        text: 'Please fix validation errors before submitting.',
                        timer: 3000,
                        showConfirmButton: false
                    });
                    return;
                }

                if ($('#comboTable tbody tr').length === 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Missing Information!',
                        text: 'Please add at least one Establishment Type - Department - Section - Designation combination.',
                        timer: 3000,
                        showConfirmButton: false
                    });
                    return;
                }

                // Update hidden field before submission
                updateHiddenField();

                // Disable button and show spinner
                var $btn = $('#employeeForm input[type="submit"]');
                var originalVal = $btn.val();
                $btn.prop('disabled', true);
                $btn.val('Processing...');
                $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});
            });
        });
