<section class="content">
    <div class="container-fluid">

        <div id="accordion3" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingthree" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne3" aria-expanded="true" aria-controls="collapseOne3" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">Add department<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion3" id="collapseOne3" aria-labelledby="headingthree" class="collapse @(isEdit ? "show" : "")">


                    <div class="card-body">
                        @*<h5 class="card-title">Add Department</h5>*@

                        @using (Html.BeginForm(isEdit ? "EditDepartment" : "Department", "Admin", FormMethod.Post, new { id = "departmentForm" }))
                        {
                            <input type="hidden" name="Dep_Code" value="@(isEdit?editDept.Dep_Code:"")" />
                            <input type="hidden" name="Dep_Type" id="Dep_Type" />


                            <div class="form-row">
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleSelect" class="">Establishment Type</label>
                                        @Html.DropDownList("Est_typeCode", new SelectList(ViewBag.EstTypeList as List<SelectListItem>, "Value", "Text", editDept?.Est_typeCode), "Select", new { @class = "form-control", id = "Est_typeCode" })

                                        @Html.ValidationMessage("Est_typeCode", "", new { @class = "text-danger" })


                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleEmail111" class="">Department</label>

                                        <input name="Dep_Name" id="Dep_Name" type="text" class="form-control" placeholder="Enter Department Name" value="@(isEdit ? editDept.Dep_Name : "")" />
                                        @Html.ValidationMessage("Dep_Name", "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="examplePassword111" class="">Department Short Name </label>


                                        @Html.ValidationMessage("Short_Name", "", new { @class = "text-danger" })
                                        <input name="Short_Name" id="Short_Name" type="text" class="form-control" placeholder="Enter Department Short Name" value="@(isEdit ? editDept.Short_Name : "")" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <input type="submit" class="mt-2 ml-2 btn btn-primary" value="@(isEdit ? "Update" : "Submit")" />
                                <input type="reset" class="mt-2 ml-2 btn btn-success" value="Reset" />
                            </div>
                        }
                    </div>
                    <br />
                </div>
            </div>
        </div>

        <div id="accordion4" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingfour" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne4" aria-expanded="true" aria-controls="collapseOne4" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title"> List<i class="float-right pe-7s-angle-down"></i></h5>
                    </button>
                </div>
                <div data-parent="#accordion4" id="collapseOne4" aria-labelledby="headingfour" class="collapse show">

                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails">
                                <div class="">

                                    <table style="width: 100%; " id="scr-vtr-dynamic" class="example1 table table-striped table-bordered  table-hover text-left">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th>Establishment</th>
                                                <th>Department/Faculty</th>
                                                <th class="center">Short Name</th>
                                                <th class="center">Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@item.Dep_Type</td>
                                                        <td>@item.Dep_Name</td>
                                                        <td>@item.Short_Name</td>
                                                        <td>@(item.Active == "False" ? "Active" : "InActive")</td>
                                                        <td>
                                                            @Html.ActionLink("Edit", "Department", "Admin", new { DepCode = item.Dep_Code }, new { @class = "btn btn-sm btn-warning" })
                                                            @*@Html.ActionLink("Delete", "DeleteDepartment", "Admin", new { DepCode = item.Dep_Code }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this department?');" })*@
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script>

      var isEdit = '@(isEdit.ToString().ToLower())';
        //if (isEdit === 'true') {
        //    $('#collapseOne3').collapse('show'); // Ensure it opens
        //}

    $('#departmentForm').submit(function (e) {
        //debugger;
          //// Validate first
          //if (!$(this).valid()) {
          //    return false;
          //}

          var selectedOption = $('#Est_typeCode option:selected');
          var value = selectedOption.val();
          var text = selectedOption.text();

          if (value) {
              $('#Dep_Type').val(value + '-' + text);
          }

          // Disable button and show spinner
          var $btn = $('#departmentForm input[type="submit"]');
          var originalVal = $btn.val();
          $btn.prop('disabled', true);
          $btn.val('Processing...');
          $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});
      });

</script>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>


<script>
    
    $("#departmentForm").validate({
        errorClass: "text-danger",
        validClass: "is-valid",
        errorElement: "span",
        rules: {
            Est_typeCode: { required: true },
            Dep_Name: { required: true },
            Short_Name: { required: true }   // make sure the casing matches your input's name attribute!
        },
        messages: {
            Est_typeCode: { required: "Please select establishment type" },
            Dep_Name: { required: "Please enter department name" },
            Short_Name: { required: "Please enter short name" }
        },
        highlight: function (element) {
            $(element).removeClass("is-valid").addClass("error");
        },
        unhighlight: function (element) {
            $(element).removeClass("error").addClass("is-valid");
        },
        errorPlacement: function (error, element) {
            error.insertAfter(element);
        }
    });


</script>
@section Scripts {
    <script>
        $(document).ready(function () {
            var message = '@TempData["insertmsg"]';

            if (message) {
                switch (message) {
                    case "1":
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Department inserted successfully.',
                            timer: 4000,      
                            showConfirmButton: false
                        });
                        break;
                    case "2":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to insert department.',
                            timer: 4000, 
                            showConfirmButton: false
                        });
                        break;
                    case "updated":
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: 'Department updated successfully.',
                            timer: 4000, 
                            showConfirmButton: false
                        });
                        break;
                    case "updatefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to update department.',
                            timer: 4000, 
                            showConfirmButton: false
                        });
                        break;
                    case "deleted":
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Department deleted successfully.',
                            timer: 4000, 
                            showConfirmButton: false
                        });
                        break;
                    case "deletefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to delete department.',
                            timer: 4000, 
                            showConfirmButton: false
                        });
                        break;
                    default:
                        // Optional: handle other messages
                        break;
                }
            }
        });
    </script>

  
}
