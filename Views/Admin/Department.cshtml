@model List<Eoffice.Models.ModelDepartment>


@{
    ViewBag.Title = "Department";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

@{
    var editDept = ViewBag.EditDepartment as Eoffice.Models.ModelDepartment;
    bool isEdit = editDept != null;
}

<style>
    .text-danger {
        color: red;
        font-size: 0.9em;
    }

    input.error,
    select.error {
        border-color: red;
    }

    input.is-valid,
    select.is-valid {
        border-color: green;
    }


    
</style>


