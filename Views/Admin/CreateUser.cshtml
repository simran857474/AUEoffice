        function bindSection(selected = "", cb) {
            $.ajax({
                //url: '/Admin/GetSectionsByDepartment',
                  url: '@Url.Action("GetSectionsByDepartment", "Admin")',
                type: 'POST',
                data: {
                    Dep_Code: $('#ddlDepartment').val(),
                    EstTypeCode: $('#EstType').val()
                },
                success: function (data) {
                    const ddl = $('#ddlSection');
                    ddl.empty().append('<option value="">Select Section</option>');

                    $.each(data, function (i, item) {
                        ddl.append(`<option value="${item.Value}">${item.Text}</option>`);
                    });

                    if (selected) ddl.val(selected);
                    if (cb) cb();
                }
            });
        }

        function bindEmployee(selected = "", cb) {
            $.ajax({
                //url: '/Admin/GetEmployeeBySection',
                  url: '@Url.Action("GetEmployeeBySection", "Admin")',
                type: 'POST',
                data: {
                    Sec_Code: $('#ddlSection').val(),
                    Dep_Code: $('#ddlDepartment').val(),
                    EstTypeCode: $('#EstType').val()
                },
                success: function (data) {
                    const ddl = $('#ddlEmployee');
                    ddl.empty().append('<option value="">Select Employee</option>');

                    $.each(data, function (i, item) {
                        ddl.append(`<option value="${item.Value}">${item.Text}</option>`);
                    });

                    // ✅ STEP 1: Try to set selected value
                    if (selected && ddl.find(`option[value="${selected}"]`).length > 0) {
                        ddl.val(selected);
                    }
                    else {
                        // ✅ STEP 2: If no valid selected value
                        if (ddl.find('option').length > 1) {
                            // Select first option after default
                            ddl.prop('selectedIndex', 1);
                        } else {
                            // Only default exists → keep default
                            ddl.prop('selectedIndex', 0);
                        }
                    }

                    if (cb) cb();
                }
            });
        }

