@model List<Eoffice.Models.ModelUser>
@{
    ViewBag.Title = "CreateUser";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    var edituser = ViewBag.EditCreateUser as Eoffice.Models.ModelUser;
    bool isEdit = edituser != null;
}


<style>
    .text-danger {
        font-size: 0.875em;
        display: block;
        margin-top: 5px;
    }

    .is-invalid {
        border-color: red;
    }
</style>

