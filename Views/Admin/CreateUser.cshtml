        $(function () {

    const isEdit = '@isEdit'.toLowerCase() === 'true';

    const selEst = '@(isEdit ? edituser.EstType : "")';
    const selDep = '@(isEdit ? edituser.EstDep : "")';
    const selSec = '@(isEdit ? edituser.EstSec : "")';
    const selEmp = '@(isEdit ? edituser.EmpID : "")';
    const selType = '@(isEdit ? edituser.EmpType : "")';
    const selRole = '@(isEdit ? edituser.CategoryID : "")';

    if (isEdit) {

        // Step 1: Set EstType
        $('#EstType').val(selEst).trigger('change');

        $('#EstType').prop('disabled', true);

        // Step 2: Bind Department
        bindDepartments(selDep, function () {
            $('#ddlDepartment').prop('disabled', true);

            // Step 3: Bind Section
            bindSection(selSec, function () {
                $('#ddlSection').prop('disabled', true);

                // Step 4: Bind Employee
                bindEmployee(selEmp, function () {
                    $('#ddlEmployee').prop('disabled', true);

                    // Step 5: Set other dropdowns
                    $('#EmpType').val(selType);
                    $('#CategoryID').val(selRole);

                    // Make User ID readonly
                    $('#LoginName').prop('readonly', true);
                });
            });
        });
    }


    $('#EstType').change(function () {
        var estTypeCode = $(this).val();

        if (estTypeCode) {
            $.ajax({
                //url: '/Admin/GetDepartmentsByEstType',
                  url: '@Url.Action("GetDepartmentsByEstType", "Admin")',
                type: 'POST',
                data: { estTypeCode: estTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlDepartment');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: 'Select Department'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading departments.');
                }
            });
        } else {
            $('#ddlDepartment').empty().append($('<option/>', {
                value: '',
                text: 'Select Department'
            }));
        }
    });


    $('#ddlDepartment').change(function () {
        var Dep_Code = $(this).val();
        var EstTypeCode = $('#EstType').val();

        if (EstTypeCode && Dep_Code) {
            $.ajax({
                //url: '/Admin/GetSectionsByDepartment',
                  url: '@Url.Action("GetSectionsByDepartment", "Admin")',
                type: 'POST',
                data: { Dep_Code: Dep_Code, EstTypeCode: EstTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlSection');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: 'Select Section'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading sections.');
                }
            });
        } else {
            $('#ddlSection').empty().append($('<option/>', {
                value: '',
                text: 'Select Section'
            }));
        }
    });


    $('#ddlSection').change(function () {
        var Sec_Code = $(this).val();
        var Dep_Code = $('#ddlDepartment').val();
        var EstTypeCode = $('#EstType').val();

        if (EstTypeCode && Dep_Code) {
            $.ajax({
                //url: '/Admin/GetEmployeeBySection',
                  url: '@Url.Action("GetEmployeeBySection", "Admin")',
                type: 'POST',
                data: { Sec_Code: Sec_Code, Dep_Code: Dep_Code, EstTypeCode: EstTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlEmployee');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: 'Select Employee'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading employees.');
                }
            });
        } else {
            $('#ddlEmployee').empty().append($('<option/>', {
                value: '',
                text: 'Select Employee'
            }));
        }
    });


    $('#ddlEmployee').change(function () {
        var empId = $(this).val();
        var estType = $('#EstType').val();
        var depCode = $('#ddlDepartment').val();
        var secCode = $('#ddlSection').val();

        if (empId && depCode && secCode) {
            $.ajax({
                //url: '/Admin/GetEmployeeDetails',
                url: '@Url.Action("GetEmployeeDetails", "Admin")',
                type: 'POST',
                data: {
                    empId: empId,
                    estType: estType,
                    depCode: depCode,
                    secCode: secCode
                },
                success: function (res) {
                    if (res.success) {
                        $('#Name').val(res.empName);
                        $('#Address').val(res.address);
                        $('#Email').val(res.email);
                        $('#Mobile').val(res.mobile);
                        $('#des_code').val(res.desigCode);
                        $('#ED_RowID').val(res.edRowId);
                    } else {
                        $('#Name').val('');
                        $('#Address').val('');
                        $('#Email').val('');
                        $('#Mobile').val('');
                        $('#des_code').val('');
                        $('#ED_RowID').val('');
                    }
                },
                error: function () {
                    alert('Error loading employee details.');
                }
            });
        }
    });


});

