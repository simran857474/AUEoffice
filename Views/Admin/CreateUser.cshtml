<section class="content">
    <div class="container-fluid">
        <div class="main-card mb-3 card">
            <div class="card-body">
                @using (Html.BeginForm(isEdit ? "EditUser" : "CreateUser", "Admin", FormMethod.Post, new { id = "createUserForm" }))
                {
                    <input type="hidden" name="EmpIDEdit" value="@(isEdit ? edituser.EmpID : "")" />
                    <input type="hidden" name="Name" value="@(isEdit ? edituser.Name : "")" id="Name" />
                    <input type="hidden" name="Address" value="@(isEdit ? edituser.Address : "")" id="Address" />
                    <input type="hidden" name="des_code" value="@(isEdit ? edituser.des_code : "")" id="des_code" />
                    <input type="hidden" name="ED_RowID" value="@(isEdit ? edituser.ED_RowID : "")" id="ED_RowID" />

                    <div class="form-row">
                        <div class="col-md-3">
                            <label>Establishment Type</label>
                            @Html.DropDownList("EstType", new SelectList(ViewBag.EstTypeList as List<SelectListItem>, "Value", "Text", edituser?.EstType), "Select", new { @class = "form-control", id = "EstType" })

                        </div>
                        <div class="col-md-3">
                            <label>Department</label>
                            <select id="ddlDepartment" name="EstDep" class="form-control">
                                <option value="">Select Department</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Section</label>
                            <select name="EstSec" id="ddlSection" class="form-control">
                                <option value="">Select Section</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Employee Name</label>
                            <select name="EmpID" id="ddlEmployee" class="form-control">
                                <option value="">Select Employee</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row mt-3">
                        <div class="col-md-3">
                            <label>User Type</label>
                            @Html.DropDownList("EmpType", new SelectList(ViewBag.EmpTypeList as List<SelectListItem>, "Value", "Text", edituser?.EmpType), "Select", new { @class = "form-control", id = "EmpType" })

                        </div>
                        <div class="col-md-3">
                            <label>User Role</label>
                            @Html.DropDownList("CategoryID", new SelectList(ViewBag.UserRoleList as List<SelectListItem>, "Value", "Text", edituser?.RoleCode), "Select", new { @class = "form-control", id = "CategoryID" })
                        </div>
                        <div class="col-md-3">
                            <label>User ID</label>
                            <input name="LoginName" id="LoginName" class="form-control" autocomplete="off" placeholder="Enter User Id" value="@(isEdit ? edituser.LoginName : "")" />
                        </div>
                        <div class="col-md-3">
                            <label>Email</label>
                            <input name="Email" id="Email" type="email" class="form-control" placeholder="Enter Email" value="@(isEdit ? edituser.Email : "")" />
                        </div>
                    </div>

                    <div class="form-row mt-3">
                        @*<div class="col-md-3">
            <label>Password</label>
            <input name="Password" id="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Enter Password" value="@(isEdit ? edituser.Password : "")" />
        </div>*@


                        <div class="col-md-3">
                            <label>Password</label>
                            <div style="position:relative;">
                                <input name="Password" id="Password" type="password" class="form-control" placeholder="Enter Password" value="@(isEdit ? edituser.Password : "")"/>
                                <i class="fa fa-eye toggle-password"
                                   toggle="#Password"
                                   style="position:absolute; left:250px; top:10px; cursor:pointer;"></i>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Confirm Password</label>
                            <input name="ConfirmPassword" id="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" value="@(isEdit ? edituser.Password : "")" />
                            <i class="fa fa-eye toggle-password"
                               toggle="#ConfirmPassword"
                               style="position:absolute; left:250px; top:45px; cursor:pointer;"></i>
                        </div>
                        <div class="col-md-3">
                            <label>Mobile</label>
                            <input name="Mobile" id="Mobile" type="text" maxlength="10" class="form-control" placeholder="Enter Mobile Number" value="@(isEdit ? edituser.Mobile : "")" />
                        </div>
                    </div>

                    <div class="form-row mt-2">
                        <input type="submit" class="btn btn-primary" value="@(isEdit ? "Update" : "Submit")" />
                        <input type="reset" class="btn btn-success ml-2" value="Reset" />
                    </div>
                }
            </div>
        </div>

        <div class="main-card mb-3 card">
            <div class="card-body">

                <div class="row">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails" >
                        <div class="">
                            <table style="width:100%" id="scr-vtr-dynamic" class="example1 table table-striped table-bordered nowrap table-hover text-center">
                                <thead>
                                    <tr>
                                        <th>S.No</th>
                                        <th>UserId</th>
                                        <th>EmpCode</th>
                                        <th>Name</th>
                                        <th>Est Type</th>
                                        <th>Department</th>
                                        <th>Section</th>
                                        <th>Designation</th>
                                        <th>Email</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null)
{
    int i = 1;
    foreach (var item in Model)
    {
                                            <tr>
                                                <td>@i</td>
                                                <td>@item.LoginName</td>
                                                <td>@item.EmpID</td>
                                                <td>@item.Name</td>
                                                <td>@item.EstType</td>
                                                <td>@item.EstDep</td>
                                                <td>@item.EstSec</td>
                                                <td>@item.des_code</td>
                                                <td>@item.Email</td>
                                                <td>
                                                    @Html.ActionLink("Edit", "CreateUser", new { TableID = item.EmpID }, new { @class = "btn btn-sm btn-warning" })
                                                    @*@Html.ActionLink("Delete", "DeleteUser", "Admin", new { TableID = item.EmpID }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete?');" })*@
                                                </td>
                                            </tr>
                                            i++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    $(document).ready(function () {
        var message = '@TempData["msg"]';

        if (message) {
            switch (message) {
                case "1":
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: 'User inserted successfully.',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    break;
                case "2":
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed!',
                        text: 'User with this login name already exists.',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    break;
                case "3":
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed!',
                        text: 'User already exists.',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    break;
                case "4":
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed!',
                        text: 'Some error.',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    break;
                case "5":
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: 'User updated successfully.',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    break;
                case "deleted":
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: 'Document Type deleted successfully.',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    break;
                case "deletefail":
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed!',
                        text: 'Failed to delete Document Type.',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    break;
                default:
                    // Optional: handle other messages
                    break;
            }
        }
    });
    </script>

    <script>
        $(document).ready(function () {
            $("#createUserForm").validate({
                rules: {
                    EstType: { required: true },
                    EstDep: { required: true },
                    EstSec: { required: true },
                    EmpID: { required: true },
                    EmpType: { required: true },
                    CategoryID: { required: true },
                    LoginName: { required: true },
                    Email: {
                        required: true,
                        email: true
                    },
                    Password: {
                        required: true,
                        minlength: 6
                    },
                    ConfirmPassword: {
                        required: true,
                        equalTo: "#Password"
                    },
                    Mobile: {
                        required: true,
                        digits: true,
                        minlength: 10,
                        maxlength: 10
                    }
                },
                messages: {
                    EstType: "Please select establishment type",
                    EstDep: "Please select department",
                    EstSec: "Please select section",
                    EmpID: "Please select employee",
                    EmpType: "Please select user type",
                    CategoryID: "Please select user role",
                    LoginName: "Please enter User ID",
                    Email: {
                        required: "Please enter email",
                        email: "Enter a valid email"
                    },
                    Password: {
                        required: "Please enter password",
                        minlength: "At least 6 characters"
                    },
                    ConfirmPassword: {
                        required: "Confirm your password",
                        equalTo: "Passwords must match"
                    },
                    Mobile: {
                        required: "Please enter mobile number",
                        digits: "Only digits allowed",
                        minlength: "Must be 10 digits",
                        maxlength: "Must be 10 digits"
                    }
                },
                errorClass: "text-danger",
                errorElement: "span",
                highlight: function (element) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function (element) {
                    $(element).removeClass('is-invalid');
                },
                submitHandler: function(form) {
                    // Disable button and show spinner
                    var $btn = $('#createUserForm input[type="submit"]');
                    var originalVal = $btn.val();
                    $btn.prop('disabled', true);
                    $btn.val('Processing...');
                    $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});
                    form.submit();
                }
            });
        });
    </script>

