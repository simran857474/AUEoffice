@model Eoffice.Models.ModelChangePassword
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="main-card mb-3 card">
            <div class="card-body">
                @using (Html.BeginForm("ChangePassword", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.UserId)

                    <div class="modal-header text-center">
                        <h4 class="modal-title w-100 font-weight-bold mt-2 mb-4">
                            <i class="fa fa-key mr-2"></i>Update Your Account Password
                        </h4>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">
                            <i class="fa fa-lock mr-1"></i>Current Password
                        </label>
                        <div class="input-group">
                            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", placeholder = "Enter current password", id = "CurrentPassword" })
                            <div class="input-group-append">
                                <span class="input-group-text toggle-password" data-target="#CurrentPassword" style="cursor: pointer;">
                                    <i class="fa fa-eye-slash"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">
                            <i class="fa fa-lock mr-1"></i>New Password
                        </label>
                        <div class="input-group">
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter new password", id = "NewPassword" })
                            <div class="input-group-append">
                                <span class="input-group-text toggle-password" data-target="#NewPassword" style="cursor: pointer;">
                                    <i class="fa fa-eye-slash"></i>
                                </span>
                            </div>
                        </div>
                        <div id="passwordStrength" class="mt-2" style="display: none;">
                            <div class="progress" style="height: 5px;">
                                <div id="strengthBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                            </div>
                            <small id="strengthText" class="form-text"></small>
                        </div>
                        <small class="form-text text-muted">
                            <i class="fa fa-info-circle mr-1"></i>Must be 8+ characters with uppercase, lowercase, number, and special character
                        </small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">
                            <i class="fa fa-lock mr-1"></i>Confirm Password
                        </label>
                        <div class="input-group">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password", id = "ConfirmPassword" })
                            <div class="input-group-append">
                                <span class="input-group-text toggle-password" data-target="#ConfirmPassword" style="cursor: pointer;">
                                    <i class="fa fa-eye-slash"></i>
                                </span>
                            </div>
                        </div>
                        <small id="matchText" class="form-text" style="display: none;"></small>
                    </div>

                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-sm px-4">
                            <span class="btn-text">Change Password</span>
                        </button>
                        <button type="reset" class="btn btn-secondary btn-sm px-4 ml-2">
                            <i class="fa fa-undo mr-1"></i>Reset
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .input-group-text {
            background-color: #f8f9fa;
            border-left: 0;
        }
        
        .form-control:focus + .input-group-append .input-group-text {
            border-color: #80bdff;
        }
        
        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
        }
        
        .strength-weak { color: #dc3545; }
        .strength-fair { color: #ffc107; }
        .strength-good { color: #17a2b8; }
        .strength-strong { color: #28a745; }
        
        .match-success { color: #28a745; }
        .match-error { color: #dc3545; }
    </style>
    <script>
        $(function () {
            // Toggle password visibility
            $('.toggle-password').on('click', function() {
                var target = $(this).data('target');
                var $input = $(target);
                var $icon = $(this).find('i');
                
                if ($input.attr('type') === 'password') {
                    $input.attr('type', 'text');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                } else {
                    $input.attr('type', 'password');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                }
            });

            // Password strength checker
            function checkPasswordStrength(password) {
                let strength = 0;
                let feedback = '';
                
                if (password.length >= 8) strength++;
                if (password.length >= 12) strength++;
                if (/[a-z]/.test(password)) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[0-9]/.test(password)) strength++;
                if (/[^a-zA-Z0-9]/.test(password)) strength++;
                
                if (strength <= 2) {
                    return { level: 'weak', percent: 25, text: 'Weak', class: 'bg-danger strength-weak' };
                } else if (strength <= 4) {
                    return { level: 'fair', percent: 50, text: 'Fair', class: 'bg-warning strength-fair' };
                } else if (strength <= 5) {
                    return { level: 'good', percent: 75, text: 'Good', class: 'bg-info strength-good' };
                } else {
                    return { level: 'strong', percent: 100, text: 'Strong', class: 'bg-success strength-strong' };
                }
            }

            // Password strength indicator
            $('#NewPassword').on('input', function() {
                var password = $(this).val();
                
                if (password.length > 0) {
                    $('#passwordStrength').show();
                    var strength = checkPasswordStrength(password);
                    
                    $('#strengthBar')
                        .removeClass('bg-danger bg-warning bg-info bg-success')
                        .addClass(strength.class.split(' ')[0])
                        .css('width', strength.percent + '%');
                    
                    $('#strengthText')
                        .removeClass('strength-weak strength-fair strength-good strength-strong')
                        .addClass(strength.class.split(' ')[1])
                        .html('<i class="fa fa-shield mr-1"></i>Password Strength: ' + strength.text);
                } else {
                    $('#passwordStrength').hide();
                }
                
                // Check match if confirm password has value
                checkPasswordMatch();
            });

            // Password match checker
            function checkPasswordMatch() {
                var newPwd = $('#NewPassword').val();
                var confirmPwd = $('#ConfirmPassword').val();
                
                if (confirmPwd.length > 0) {
                    if (newPwd === confirmPwd) {
                        $('#matchText')
                            .removeClass('match-error')
                            .addClass('match-success')
                            .html('<i class="fa fa-check-circle mr-1"></i>Passwords match')
                            .show();
                    } else {
                        $('#matchText')
                            .removeClass('match-success')
                            .addClass('match-error')
                            .html('<i class="fa fa-times-circle mr-1"></i>Passwords do not match')
                            .show();
                    }
                } else {
                    $('#matchText').hide();
                }
            }

            $('#ConfirmPassword').on('input', checkPasswordMatch);

            // Password strength regex
            function isStrongPassword(password) {
                return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,}$/.test(password);
            }

            // Form submission validation
            $('form').on('submit', function (e) {
                e.preventDefault();

                let errors = [];

                let currentPwd = $('#CurrentPassword').val().trim();
                let newPwd = $('#NewPassword').val().trim();
                let confirmPwd = $('#ConfirmPassword').val().trim();

                if (!currentPwd) {
                    errors.push("Current password is required.");
                }

                if (!newPwd) {
                    errors.push("New password is required.");
                } else if (!isStrongPassword(newPwd)) {
                    errors.push("New password must be at least 8 characters long and include uppercase, lowercase, number, and special character.");
                }

                if (!confirmPwd) {
                    errors.push("Confirm password is required.");
                } else if (newPwd !== confirmPwd) {
                    errors.push("Confirm password does not match new password.");
                }

                if (errors.length > 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Validation Error',
                        html: errors.join("<br>"),
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Disable button and show spinner
                var $btn = $('form button[type="submit"]');
                var $btnText = $btn.find('.btn-text');
                $btn.prop('disabled', true);
                $btnText.html('<span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>Changing...');
                $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});

                // No errors, submit form
                this.submit();
            });

            // Reset button logic
            $('button[type="reset"]').on('click', function () {
                $('#CurrentPassword, #NewPassword, #ConfirmPassword').val('');
                $('#passwordStrength, #matchText').hide();
                
                // Reset password visibility
                $('.toggle-password').each(function () {
                    var target = $(this).data('target');
                    $(target).attr('type', 'password');
                    $(this).find('i').removeClass('fa-eye').addClass('fa-eye-slash');
                });
            });

            // Handle TempData success message
            var msg = '@(TempData["Success"] ?? "")';
            if (msg) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: msg,
                    confirmButtonText: 'Login'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Login", "Home")';
                    }
                });
            }
        });
    </script>
}
