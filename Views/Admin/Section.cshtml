<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script> 
<script>
    function validateForm() {
        let isValid = true;

        // Get fields
        const estType = document.getElementById("DeptypeCode");
        const dept = document.getElementById("ddlDepartment");
        const secName = document.getElementById("Sec_Name");
        const secShort = document.getElementById("SecShortName");

        // Clear previous errors
        document.getElementById("DeptypeCodeError").innerText = "";
        document.getElementById("ddlDepartmentError").innerText = "";
        document.getElementById("SecNameError").innerText = "";
        document.getElementById("SecShortNameError").innerText = "";

        // Validate each field
        if (estType.value.trim() === "") {
            document.getElementById("DeptypeCodeError").innerText = "Please select Establishment Type.";
            isValid = false;
        }
        if (dept.value.trim() === "") {
            document.getElementById("ddlDepartmentError").innerText = "Please select Department.";
            isValid = false;
        }
        if (secName.value.trim() === "") {
            document.getElementById("SecNameError").innerText = "Please enter Section Name.";
            isValid = false;
        }
        if (secShort.value.trim() === "") {
            document.getElementById("SecShortNameError").innerText = "Please enter Section Short Name.";
            isValid = false;
        }

        // If valid, disable button and show spinner
        if (isValid) {
            var $btn = $('#sectionForm input[type="submit"]');
            var originalVal = $btn.val();
            $btn.prop('disabled', true);
            $btn.val('Processing...');
            $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});
        }

        return isValid;
    }
</script>


@section Scripts {
    <script>
        $(document).ready(function () {
            var message = '@TempData["insertmsg"]';

            if (message) {
                switch (message) {
                    case "1":
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Section inserted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "2":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to insert Section.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updated":
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: 'Section updated successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updatefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to update Section.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deleted":
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Section deleted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deletefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to delete Section.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    default:
                        Swal.fire({
                            icon: 'error',
                            title: 'Validation Failed!',
                            text: message,
                            timer: 4000, 
                            showConfirmButton: false
                        });
                        break;
                }
            }
        });
    </script>
}







