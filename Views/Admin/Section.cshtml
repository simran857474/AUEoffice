                                            <tr>
                                                <th>S.No</th>
                                                <th>Sec_Code</th>
                                                <th>Establishment</th>
                                                <th>Department/Faculty</th>
                                                <th>Section Name</th>
                                                <th>Sec Short Name</th>
                                                <th>Status</th>
                                                <th>Action</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@item.Sec_Code</td>
                                                        <td>@item.EstType</td>
                                                        <td>@item.DepName</td>
                                                        <td>@item.Sec_Name</td>
                                                        <td> @item.sec_short_name</td>
                                                        <td>@(item.Active == "False" ? "Active" : "InActive")</td>
                                                        <td>
                                                            @Html.ActionLink("Edit", "Section", "Admin", new { Sec_Code = item.Sec_Code }, new { @class = "btn btn-sm btn-warning" })
                                                            @*@Html.ActionLink("Delete", "DeleteSection", "Admin", new { Sec_Code = item.Sec_Code }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this section?');" })*@

                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="6">No records found</td>
                                                </tr>
                                            }
                                        <tbody />
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
