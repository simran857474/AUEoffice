<script>
  $(document).ready(function () {
        var isEdit = '@(isEdit.ToString().ToLower())' === 'true';
        var estType = '@(isEdit ? editSec.DeptypeCode : "")';
        var selectedDept = '@(isEdit ? editSec.Dep_Code : "")';

        if (isEdit && estType !== '') {
            $('#DeptypeCode').val(estType); // Set Est. Type dropdown
            $('#DeptypeCode').trigger('change'); // This will trigger the AJAX call

            // Wait for AJAX to complete then set department
            setTimeout(function () {
                $.ajax({
                    //url: '/Admin/GetDepartmentsByEstType',
                        url: '@Url.Action("GetDepartmentsByEstType", "Admin")',
                    type: 'POST',
                    data: { estTypeCode: estType },
                    success: function (data) {
                        var deptDropdown = $('#ddlDepartment');
                        deptDropdown.empty();
                        deptDropdown.append($('<option/>', {
                            value: '',
                            text: 'Select Department'
                        }));

                        $.each(data, function (i, item) {
                            deptDropdown.append($('<option/>', {
                                value: item.Value,
                                text: item.Text
                            }));
                        });

                        // Set selected department after dropdown is populated
                        if (selectedDept !== '') {
                            deptDropdown.val(selectedDept);
                        }
                    },
                    error: function () {
                        alert('Error loading departments.');
                    }
                });
            }, 100); // Slight delay ensures EstType is set before AJAX
        }


      $('#DeptypeCode').change(function () {
          var estTypeCode = $(this).val();

          if (estTypeCode) {
              $.ajax({
                  //url: '/Admin/GetDepartmentsByEstType',
                      url: '@Url.Action("GetDepartmentsByEstType", "Admin")',
                  type: 'POST',
                  data: { estTypeCode: estTypeCode },
                  success: function (data) {
                      var deptDropdown = $('#ddlDepartment');
                      deptDropdown.empty();
                      deptDropdown.append($('<option/>', {
                          value: '',
                          text: 'Select Department'
                      }));

                      $.each(data, function (i, item) {
                          deptDropdown.append($('<option/>', {
                              value: item.Value,
                              text: item.Text
                          }));
                      });
                  },
                  error: function () {
                      alert('Error loading departments.');
                  }
              });
          } else {
              $('#ddlDepartment').empty().append($('<option/>', {
                  value: '',
                  text: 'Select Department'
              }));
          }
      });

      //bindDepartments('ddlDepartment', -1);


      //$('#DeptypeCode').on('change', function () {
      //    bindDepartments('ddlDepartment', -1);
      //});

      @*@if (editSec!=null)
          {
              <text>
      var depcode = '@editSec.Dep_Code';
      if (depcode !== null && depcode !== '') {
          bindDepartments('ddlDepartment', depcode);
      }
      </text>
          }*@
  });

  function bindDepartments(id, defaultvalue) {

      if (defaultvalue == -1 || defaultvalue == undefined || defaultvalue == "") {
          defaultvalue = -1;
      }

      var obj = new Object();
      //obj.Action = "bindDepartments";
      obj.DeptypeCode = $('#DeptypeCode').val();


      $.ajax({
          type: 'POST',
          //url: '/Admin/fillDropdown',
              url: '@Url.Action("fillDropdown", "Admin")',
          data: { DeptypeCode: obj.DeptypeCode },
          success: function (Data) {

              var ddl = $('#' + id);
              ddl.empty();

              ddl.append($('<option/>', {
                  value: "",
                  text: "Select"
              }));
              $.each(Data, function (index, rowData) {
                  ddl.append($('<option/>', {
                      value: rowData.id,
                      text: rowData.value
                  }));
              });
              ddl.val(defaultvalue);
          },
          error: function (Data) {
              console.error("Some error while binding");
          },
      });

  }
</script>


