@model List<Eoffice.Models.ModelConstituentCollege>
@{
    ViewBag.Title = "ConstituentCollege";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

@{
    var editClg = ViewBag.EditConstituentCollege as Eoffice.Models.ModelConstituentCollege;
    bool isEdit = editClg != null;
}
