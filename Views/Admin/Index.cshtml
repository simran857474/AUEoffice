<style>
    #piechart, #barchart, #donutchart {
        width: 100%;
        height: 500px;
    }
    
    /* Enhanced chart card styling */
    .chart-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        overflow: hidden;
    }
    
    .chart-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }

    .chart-header {
      /*  background: linear-gradient(135deg, #BB1E3D 0%, #8B1530 100%);*/
        background: linear-gradient(135deg, #1ebbae 0%, #154f8b 100% 100% );
        color: white;
        padding: 20px;
        border-radius: 15px 15px 0 0;
        position: relative;
        overflow: hidden;
    }
    
    .chart-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: pulse 3s ease-in-out infinite;
    }
    
    @@keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }
    
    .chart-title {
        font-size: 20px;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
    }
    
    .chart-title i {
        margin-right: 10px;
        font-size: 24px;
    }
    
    .chart-body {
        padding: 30px 20px;
        background: white;
    }
    
    /* Chart container styling */
    .chart-container {
        position: relative;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 10px;
        margin-top: 10px;
    }
    
    /* Accordion improvements */
    .accordion-wrapper .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin-bottom: 20px;
    }

    .accordion-wrapper .card-header {
        /*background: linear-gradient(135deg, #BB1E3D 0%, #8B1530 100%);*/
        background: linear-gradient(135deg, #1ebbae 0%, #154f8b 100% 100% );
        border-radius: 12px 12px 0 0;
        border: none;
    }
    
    .accordion-wrapper .card-header button {
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 18px;
    }
    
    .accordion-wrapper .card-header button:hover {
        text-decoration: none;
        color: white;
    }
    
    .accordion-wrapper .card-header i {
        transition: transform 0.3s ease;
    }
    
    .accordion-wrapper .card-header button[aria-expanded="true"] i {
        transform: rotate(180deg);
    }
</style>
