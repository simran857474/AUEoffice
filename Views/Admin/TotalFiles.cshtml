@model System.Data.DataTable
@{
    ViewBag.Title = "TotalFiles";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<style>
    #divDetails {
        position: relative;
    }

    #attachmentLoader {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.7); /* transparent overlay */
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 20;
    }

        #attachmentLoader .loader-content {
            text-align: center;
        }
</style>

<section class="content">
    <div class="container-fluid">

        <div id="accordionSearch" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div class="card-header">
                    <h5 class="m-0 p-0">Files Details</h5>
                </div>
                <div class="card-body">

                    @*Button Group*@
                    <div class="btn-group mb-3">
                        <button type="button" class="btn btn-outline-success" id="btnSearchFinYear">Search by Financial Year</button>
                        <button type="button" class="btn btn-outline-primary" id="btnSearchOthers">Search by Department/Section</button>
                        @*<button type="button" class="btn btn-outline-success" id="btnSearchFileNo">Search by File No</button>*@
                    </div>
                    <!--  Financial Year Search -->
                    <div id="searchOthers" class="search-box" style="display:none;">
                        <div class="form-row">
                            <div class="col-md-3">
                                <label>Establishment Type</label>
                                @Html.DropDownList("EstType", new SelectList(ViewBag.EstTypeList as List<SelectListItem>, "Value", "Text"), "Select", new { @class = "form-control", id = "EstType" })

                            </div>
                            <div class="col-md-3">
                                <label>Department</label>
                                <select id="ddlDepartment" name="EstDep" class="form-control">
                                    <option value="">Select</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label>Section</label>
                                <select name="EstSec" id="ddlSection" class="form-control">
                                    <option value="">Select</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label>Created By</label>
                                <select name="EmpID" id="ddlEmployee" class="form-control">
                                    <option value="">Select</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <button type="button" class="btn btn-info mt-4" id="btnOthersSearch">Search</button>
                            </div>
                        </div>

                    </div>

                    <!--  Section Search -->
                    <div id="searchFileNo" class="search-box" style="display:none;">
                        <label>File No</label>
                        <input type="text" id="txtFileNo" class="form-control" placeholder="Enter File Number" />
                        <button type="button" class="btn btn-info mt-2" id="btnFileNoSearch">Search</button>
                    </div>

                    <!--  Financial Year Search -->
                    <div id="searchFinYear" class="search-box" style="display:none;">
                        <label>Select Financial Year</label>
                        @Html.DropDownList("FinYear", new SelectList(ViewBag.FinancialYear as List<SelectListItem>, "Value", "Text"), 
                         new { @class = "form-control", id = "Fin_Year" })
                        <button type="button" class="btn btn-primary mt-2" id="btnFinYearSearch">Search</button>
                    </div>

                </div>
            </div>
        </div>

        <div id="accordiontwenty5" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingtwenty5" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapsetwenty5" aria-expanded="true" aria-controls="collapsetwenty5" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title"> Total Files<i class="float-right pe-7s-angle-down"></i></h5>
                    </button>
                </div>
                <div data-parent="#accordiontwenty5" id="collapsetwenty5" aria-labelledby="headingtwenty5" class="collapse show">

                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails">
                                <div class="">

                                    <!--  Full overlay loader -->
                                    <div id="attachmentLoader" style="display:none;">
                                        <div class="loader-content">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="sr-only">Loading...</span>
                                            </div>
                                            <p>Loading...</p>
                                        </div>
                                    </div>
                                    <img src="~/theme/dist/img/logo-inverse.png" alt="Department Logo" class="department-logo" style="display:none;" />
                                    <table style="width: 100%; " id="scr-vtr-dynamic" class="example1 table table-striped table-bordered nowrap table-hover text-left">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th class="text-left">File_Code</th>
                                                <th class="text-left">File_Des</th>
                                                <th class="text-left">Category</th>
                                                <th class="text-left">Sub Category	</th>
                                                <th class="text-left">Priority</th>
                                                <th class="text-left">Created By Section</th>
                                                <th class="text-left">Created Date/Time</th>
                                                <th class="text-left">File History</th>
                                                <th class="text-left">Noting Details </th>
                                                <th class="text-left">Attached Documents</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Rows.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (System.Data.DataRow row in Model.Rows)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@row["File_Code"]</td>
                                                        <td style="white-space: normal !important; word-wrap: break-word; min-width: 300px; ">@row["File_Desc"]</td>
                                                        <td>@row["File_CategoryName"]</td>
                                                        <td>@row["File_sub_CategoryName"]</td>
                                                        <td>@row["DocPrior_Name"]</td>
                                                        <td>@row["Sec_Name"]</td>
                                                        <td>@row["Created_DT"]</td>
                                                        <td>
                                                            <i class="fa fa-eye text-primary history-icon" data-filecode="@row["File_Code"]" style="cursor:pointer"></i>
                                                        </td>
                                                        @*<td>Noting Details</td>*@
                                                        <td>
                                                            <i class="fa fa-print text-success print-icon"
                                                               title="Print File"
                                                               data-filecode="@row["File_Code"]"
                                                               style="cursor:pointer"></i>
                                                        </td>
                                                        <td>
                                                            <i class="fa fa-file text-danger"
                                                               style="cursor:pointer"
                                                               title="View Attached Document"
                                                               onclick="viewAttachedDocument('@row["File_Code"]')"></i>
                                                        </td>
                                                        @*<td>
                                                                 @Html.ActionLink("Edit", "Department", "Admin", new { DepCode = item.Dep_Code }, new { @class = "btn btn-sm btn-warning" })
                                                                 @Html.ActionLink("Delete", "DeleteDepartment", "Admin", new { DepCode = item.Dep_Code }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this department?');" })
                                                            </td>*@
                                                    </tr>
                                                    i++;
                                                }
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="modal-lg" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">File Movement Details</h4>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div id="fileDetails" class="mb-3"></div>
                <div class="table-responsive" style="max-height: 50vh; overflow-y: auto; display: block;">
                    <table class="table table-bordered table-striped" id="historyTable">
                        <thead style="position: sticky; top: 0; background-color: #fff; z-index: 10;">
                            <tr>
                                <th>S.No</th>
                                <th>Forwarded From</th>
                                <th>Forwarded To</th>
                                <th>Forwarded/Called Back Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5" style="text-align:center; color: gray; padding: 40px;">
                                    <i class="fa fa-inbox" style="font-size: 48px; color: #ccc; display: block; margin-bottom: 10px;"></i>
                                    No records found
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.7.1.min.js"></script>

<script>
    $(document).on("click", ".history-icon", function () {
        var fileCode = $(this).data("filecode");

        $.ajax({
           /* url: '/User/GetOutBoxFileHistory',*/
              url: '@Url.Action("GetOutBoxFileHistory", "User")',
            type: 'GET',
            data: { fileCode: fileCode },
            success: function (data) {
                if (data.length > 0) {
                    // Show file name & section name
                    var fileDetails = `<strong>File No:</strong> ${data[0].FileName} <br/>
                                   <strong>File Created Section:</strong> ${data[0].SectionName}`;
                    $("#fileDetails").html(fileDetails);

                    // Populate table
                    var rows = '';
                    $.each(data, function (i, item) {
                        rows += `<tr>
                        <td>${item.SNo}</td>
                        <td>${item.ForwardedFrom}</td>
                        <td>${item.ForwardedTo}</td>
                        <td>${item.Date}</td>
                        <td>${item.Action}</td>
                    </tr>`;
                    });
                    $("#historyTable tbody").html(rows);

                    // Show modal
                    $("#modal-lg").modal("show");
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'No History',
                        text: 'No history found for this file.',
                        confirmButtonColor: '#3085d6'
                    });

                    // Show empty state in table
                    var emptyRow = `<tr>
                        <td colspan="5" style="text-align:center; color: gray; padding: 40px;">
                            <i class="fa fa-inbox" style="font-size: 48px; color: #ccc; display: block; margin-bottom: 10px;"></i>
                            No history found for this file.
                        </td>
                    </tr>`;
                    $("#historyTable tbody").html(emptyRow);
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error fetching data.',
                    confirmButtonColor: '#d33'
                });
            }
        });
    });


    function viewAttachedDocument(fileCode) {
        $.ajax({

            url: '@Url.Action("GetAttachedDocument", "User")',

        type: 'GET',
        data: { fileCode: fileCode },
        success: function (data) {
            if (data && data.url) {

                // Build virtual path and open in a new tab
                var fileUrl = '@Url.Content("~/Uploads/")' + data.url;
                window.open(fileUrl, '_blank');

            } else {
                Swal.fire({
                    icon: 'info',
                    title: 'No Document Found',
                    text: 'No attached document exists for this file.'
                });
            }
        },
        error: function () {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Could not fetch document.'
            });
        }
    });
    }


    $(document).ready(function () {
        // Hide all search boxes initially
        $(".search-box").hide();


        // Toggle search sections
        $("#btnSearchOthers").click(function () {
            $(".search-box").hide();
            $("#searchOthers").show();
        });

        $("#btnSearchFinYear").click(function () {
            $(".search-box").hide();
            $("#searchFinYear").show();
        });

        //$("#searchOthers").show();

        // Show Financial Year box
        //$("#btnSearchOthers").click(function () {
        //    $(".search-box").hide();
        //    $("#searchOthers").show();
        //});

        //// Show Section box
        //$("#btnSearchFileNo").click(function () {
        //    $(".search-box").hide();
        //    $("#searchFileNo").show();
        //});
    });

    $('#EstType').change(function () {
        var estTypeCode = $(this).val();
        debugger;
        if (estTypeCode) {
            $.ajax({
                /* url: '/Admin/GetDepartmentsByEstType',*/
               url: '@Url.Action("GetDepartmentsByEstType", "Admin")',

                type: 'POST',
                data: { estTypeCode: estTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlDepartment');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: 'Select'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading departments.');
                }
            });
        } else {
            $('#ddlDepartment').empty().append($('<option/>', {
                value: '',
                text: 'Select'
            }));
        }
    });


    $('#ddlDepartment').change(function () {
        var Dep_Code = $(this).val();
        var EstTypeCode = $('#EstType').val();

        if (EstTypeCode && Dep_Code) {
            $.ajax({
           /*     url: '/Admin/GetSectionsByDepartment',*/
                url: '@Url.Action("GetSectionsByDepartment", "Admin")',
                type: 'POST',
                data: { Dep_Code: Dep_Code, EstTypeCode: EstTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlSection');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: 'Select'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading sections.');
                }
            });
        } else {
            $('#ddlSection').empty().append($('<option/>', {
                value: '',
                text: 'Select'
            }));
        }
    });


    $('#ddlSection').change(function () {
        var Sec_Code = $(this).val();
        var Dep_Code = $('#ddlDepartment').val();
        var EstTypeCode = $('#EstType').val();

        if (EstTypeCode && Dep_Code) {
            $.ajax({
             /*   url: '/Admin/GetCreatedByEmployeesBySection',*/
                url: '@Url.Action("GetCreatedByEmployeesBySection", "Admin")',
                type: 'POST',
                data: { Sec_Code: Sec_Code, Dep_Code: Dep_Code, EstTypeCode: EstTypeCode },
                success: function (data) {
                    var deptDropdown = $('#ddlEmployee');
                    deptDropdown.empty();
                    deptDropdown.append($('<option/>', {
                        value: '',
                        text: 'Select'
                    }));

                    $.each(data, function (i, item) {
                        deptDropdown.append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading employees.');
                }
            });
        } else {
            $('#ddlEmployee').empty().append($('<option/>', {
                value: '',
                text: 'Select'
            }));
        }
    });

    $("#btnFinYearSearch").click(function () {

     var finYear = $("#Fin_Year option:selected").text();

      $("#attachmentLoader").show();

      $.ajax({
          url: '@Url.Action("TotalFilesSearchByFinYear", "Admin")',
          type: 'POST',
          data: { finYear: finYear },
          success: function (res) {
              $("#attachmentLoader").hide();
              
              table.clear().draw();
              $.each(res.data, function (i, item) {
                  table.row.add([
                      item.SNo,
                      item.File_Code,
                      item.File_Desc,
                      item.FileCat_Name,
                      item.FileSubCat_Name,
                      item.Sec_Name,
                      item.DocPrior_Name,
                      item.Created_DT,
                      `<i class="fa fa-eye text-primary history-icon" data-filecode="${item.File_Code}" style="cursor:pointer"></i>`,
                      `<i class="fa fa-print text-success print-icon" title="Print File" data-filecode="${item.File_Code}" style="cursor:pointer"></i>`,
                      `<i class="fa fa-file text-danger" style="cursor:pointer" title="View Attached Document" onclick="viewAttachedDocument('${item.File_Code}')"></i>`
                  ]).draw(false);
              });
          },
          error: function() {
              $("#attachmentLoader").hide();
          }
      });
 });


    $("#btnOthersSearch").click(function () {
        var estType = $("#EstType").val();
        var deptCode = $("#ddlDepartment").val();
        var secCode = $("#ddlSection").val();
        var empCode = $("#ddlEmployee").val();

        $("#attachmentLoader").show();

        $.ajax({
            url: '@Url.Action("SearchTotalFiles", "Admin")',
            type: 'POST',
            data: { estType: estType, deptCode: deptCode, secCode: secCode, empCode: empCode },
            success: function (res) {
                $("#attachmentLoader").hide();

                table.clear().draw();
                $.each(res.data, function (i, item) {
                    table.row.add([
                        item.SNo,
                        item.File_Code,
                        item.File_Desc,
                        item.FileCat_Name,
                        item.FileSubCat_Name,
                        item.DocPrior_Name,
                        item.Sec_Name,
                        item.Created_DT,
                        `<i class="fa fa-eye text-primary history-icon" data-filecode="${item.File_Code}" style="cursor:pointer"></i>`,
                        `<i class="fa fa-print text-success print-icon" title="Print File" data-filecode="${item.File_Code}" style="cursor:pointer"></i>`,
                        `<i class="fa fa-file text-danger" style="cursor:pointer" title="View Attached Document" onclick="viewAttachedDocument('${item.File_Code}')"></i>`
                        //item.File_status,
                        //item.file_Remark
                    ]).draw(false);
                });
            },
            error: function() {
                $("#attachmentLoader").hide();
            }
        });
    });

        $(document).on("click", ".print-icon", function () {
    let printContent = "";
        let logoUrl = $(".department-logo").attr("src");
        @*let fileCode = '@ViewBag.FileCode';*@

        var fileCode = $(this).data("filecode");

        // 1. First get file details
        $.ajax({
           // url: '/User/GetFileDetails',
            url:  '@Url.Action("GetFileDetails", "User")',
            type: 'GET',
            data: { fileCode: fileCode },
            success: function (filedt) {
                if (filedt && filedt.length > 0) {
                    let row = filedt[0];
                    //let logoUrl = $("#flipbook-cover img").attr("src");

                    let coverHtml = `
                    <div style="display:flex; flex-direction:column; justify-content:center; align-items:center; height:100vh; font-family:Arial, sans-serif; padding:40px; box-sizing:border-box;">
                        <img src="${logoUrl}" alt="Logo" style="max-width:120px; margin-bottom:20px;">
                        <h2>${row.Dep_Name}</h2>
                        <h3>${row.Section}</h3>
                        <h3><b>File Code: </b>${fileCode}</h3>
                        <table style="width:100%; margin-top:30px; border-collapse:collapse; font-size:16px;">
                            <tr><td><strong>File Category:</strong> ${row.FileCat_Name}</td>
                                <td><strong>Sub Category:</strong> ${row.FileSubCat_Name}</td></tr>
                            <tr><td><strong>Description:</strong> ${row.File_Desc}</td>
                                <td><strong>Priority:</strong> ${row.DocPrior_Name}</td></tr>
                            <tr><td><strong>Created By:</strong> ${row.Name}</td>
                                <td><strong>Date:</strong> ${row.date} / ${row.time}</td></tr>
                        </table>
                    </div>`;
                    printContent += `<div style="page-break-after:always;">${coverHtml}</div>`;
                }

                // 2. Then get noting details
                $.ajax({
                   /* url: '/User/GetNotingDetails',*/
                    url: '@Url.Action("GetNotingDetails", "User")',
                    type: 'GET',
                    data: { fileCode: fileCode },
                    success: function (notings) {
                        if (notings && notings.length > 0) {
                            $.each(notings, function (i, note) {
                                printContent += `
                                <div style="page-break-after:always; padding:40px; font-family:Arial, sans-serif;">
                                    <h2 style="text-align:center; margin-bottom:20px;">Notings</h2>
                                    <div style="background-color:#D4DD7A; padding:10px;">${note.Note_Desc}</div>
                                </div>`;
                            });
                        }

                        // 3. Finally get file history
                        $.ajax({
                            //url: '/User/GetFileHistory',
                            url: '@Url.Content("~/User/GetFileHistory")',
                            type: 'GET',
                            data: { fileCode: fileCode },
                            success: function (history) {
                                if (history && history.length > 0) {
                                    let rows = "";
                                    $.each(history, function (i, item) {
                                        rows += `<tr>
                                        <td>${item.SNo}</td>
                                        <td>${fileCode}</td>
                                        <td>${item.FileDescription}</td>
                                        <td>${item.SentFrom}</td>
                                        <td>${item.SentTo}</td>
                                        <td>${item.ForwardedDT}</td>
                                        <td>${item.Status}</td>
                                        <td>${item.Remark}</td>
                                    </tr>`;
                                    });

                                    let historyHtml = `
                                    <div style="padding:40px; font-family:Arial, sans-serif;">
                                        <h2 style="text-align:center; margin-bottom:20px;">Movement History</h2>
                                        <table style="width:100%; border-collapse:collapse;">
                                            <thead>
                                                <tr>
                                                    <th>SNo</th><th>File Code</th><th>Description</th>
                                                    <th>Sent From</th><th>Sent To</th>
                                                    <th>Date</th><th>Status</th><th>Remark</th>
                                                </tr>
                                            </thead>
                                            <tbody>${rows}</tbody>
                                        </table>
                                    </div>`;
                                    printContent += historyHtml;
                                }

                                // 4. Open print window
                                let printWindow = window.open("", "_blank");
                                printWindow.document.write(`
                                <html><head><title>Note Sheet Print</title>
                                <style>
                                    body { font-family: Arial, sans-serif; margin:0; padding:0; }
                                    table { border-collapse: collapse; width: 100%; margin-top: 10px; }
                                    th, td { border: 1px solid #000; padding: 8px; text-align: left; }
                                    h2 { font-size: 22px; }
                                </style></head>
                                <body>${printContent}</body></html>
                            `);
                                printWindow.document.close();
                                printWindow.onload = function () {
                                    setTimeout(() => { printWindow.print(); }, 200);
                                };
                                printWindow.onafterprint = function () {
                                    printWindow.close();
                                };
                            }
                        });
                    }
                });
            }
        });
});

</script>
