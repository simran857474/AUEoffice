                                <div class="table-responsive">
                                    <table style="width: 100%;" id="scr-vtr-dynamic" class="table table-striped table-bordered  table-hover text-center">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th>Emp Code</th>
                                                <th>Emp Name</th>
                                                <th>Login Name</th>
                                                <th>Est type</th>
                                                <th>Department</th>
                                                <th>Section</th>
                                                <th>Designation</th>
                                                <th>Old Est type</th>
                                                <th>Old Department</th>
                                                <th>Old Section</th>
                                                <th>Old Designation</th>
