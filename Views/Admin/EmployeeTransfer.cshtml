                                                        <td>@item.Est_Type</td>
                                                        <td>@item.Department</td>
                                                        <td>@item.Section</td>
                                                        <td>@item.Designation</td>
                                                        <td>@item.Old_Est_Type</td>
                                                        <td>@item.Old_Department</td>
                                                        <td>@item.Old_Section</td>
                                                        <td>@item.Old_Designation</td>
                                                        <td>@item.Transfer_From_Dt</td>
