<section class="content">
    <div class="container-fluid">
        <div id="accordion9" class="accordion-wrapper mb-3">
            <div class=" main-card mb-3 card">
                <div id="headingnine" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne9" aria-expanded="true" aria-controls="collapseOne9" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">Add File Category<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion9" id="collapseOne9" aria-labelledby="headingnine" class="collapse @(isEdit? "show":"")">
                    <div class="card-body">
                        @using (Html.BeginForm(isEdit ? "EditFileCategory" : "FileCategory", "Admin", FormMethod.Post, new { id = "filecategoryForm", onsubmit = "return validateForm()" }))
                        {
                            <input type="hidden" name="FileCat_Code" value="@(isEdit?editFilecat.FileCat_Code:"")" />

                            <div class="form-row">
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleEmail111" class="">File Category Name</label>
                                        <input name="FileCat_Name" id="FileCatName" placeholder="Enter Document Priority Name" type="Text" class="form-control" value="@(isEdit ? editFilecat.FileCat_Name : "")">
                                        <span id="FileCatNameError" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-md-4">
                                    <input type="submit" class="mt-2 ml-2 btn btn-primary" value="@(isEdit ? "Update" : "Submit")" />
                                    <input type="reset" class="mt-2 ml-2 btn btn-success" value="Reset" />
                                </div>
                            </div>
                        }
                    </div>
                    <br />

                </div>
            </div>
        </div>

        <div id="accordion10" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingten" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne10" aria-expanded="true" aria-controls="collapseOne10" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">FileCategory List<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion10" id="collapseOne10" aria-labelledby="headingten" class="collapse show">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails" >
                                <div class="">

                                    <table style="width: 100%;" id="scr-vtr-dynamic" class="example1 table table-striped table-bordered  table-hover text-center">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th>File Category Name</th>
                                                <th>Action</th>

                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model != null && Model.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@item.FileCat_Name</td>
                                                        <td>
                                                            @Html.ActionLink("Edit", "FileCategory", "Admin", new { FileCat_Code = item.FileCat_Code }, new { @class = "btn btn-sm btn-warning" })
                                                            @Html.ActionLink("Delete", "DeleteFileCategory", "Admin", new { FileCat_Code = item.FileCat_Code }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this file category?');" })
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="6">No records found</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            var message = '@TempData["insertmsg"]';

            if (message) {
                switch (message) {
                    case "1":
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'FileCategory inserted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "2":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to insert FileCategory.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updated":
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: 'FileCategory updated successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updatefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to update FileCategory.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deleted":
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'FileCategory deleted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deletefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to delete FileCategory.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    default:
                        Swal.fire({
                            icon: 'error',
                            title: 'Validation Failed!',
                            text: message,
                            timer: 4000, 
                            showConfirmButton: false
                        });
                        break;
                }
            }

            $("#filecategoryForm").validate({
                rules: {
                    FileCat_Name: {
                        required: true
                    }
                },
                messages: {
                    FileCat_Name: {
                        required: "Please enter File Category Name."
                    }
                },
                highlight: function (element) {
                    $(element).removeClass("is-valid").addClass("error");
                },
                unhighlight: function (element) {
                    $(element).removeClass("error").addClass("is-valid");
                },
                errorPlacement: function (error, element) {
                    error.insertAfter(element);
                },
                submitHandler: function(form) {
                    // Disable button and show spinner
                    var $btn = $('#filecategoryForm input[type="submit"]');
                    var originalVal = $btn.val();
                    $btn.prop('disabled', true);
                    $btn.val('Processing...');
                    $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});
                    form.submit();
                }

            });

        });
        
    </script>
}
