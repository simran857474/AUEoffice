@model List<Eoffice.Models.ModelFileCategory>
@{
    ViewBag.Title = "FileCategory";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

@{
    var editFilecat = ViewBag.EditFileCategory as Eoffice.Models.ModelFileCategory;
    bool isEdit = editFilecat != null;
}
<style>
    .error {
        color: #dc3545;
        font-weight:initial;
        font-size: 0.860rem;
        margin-top: 4px;
        display: block;
    }
</style>


