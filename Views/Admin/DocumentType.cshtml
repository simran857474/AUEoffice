<section class="content">
    <div class="container-fluid">
        <div id="accordion13" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingelthirteen" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne13" aria-expanded="true" aria-controls="collapseOne13" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">Add  Document Type<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion13" id="collapseOne13" aria-labelledby="headingelthirteen" class="collapse @(isEdit ? "show":"")">

                    <div class="card-body">
                        @using (Html.BeginForm(isEdit ? "EditDocumentType" : "DocumentType", "Admin", FormMethod.Post, new { id = "documenttypeForm" }))
                        {
                            <input type="hidden" name="DocType_Code" value="@(isEdit?editDocType.DocType_Code:"")" />
                            <div class="form-row">
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleEmail111" class="">Document Type Name</label>
                                        <input name="DocType_Name" id="DocType" placeholder="Enter Document Type  Name" type="text" class="form-control" value="@(isEdit ? editDocType.DocType_Name : "")">
                                        <span id="DocTypeError" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleEmail111" class="">Short Document Type Name</label>
                                        <input name="Short_Name" id="ShortDocType" placeholder="Enter Short Document Type Name" type="text" class="form-control" value="@(isEdit ? editDocType.Short_Name : "")">
                                        <span id="ShortDocTypeError" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-md-4">
                                    <input type="submit" class="mt-2 ml-2 btn btn-primary" value="@(isEdit ? "Update" : "Submit")" />
                                    <input type="reset" class="mt-2 ml-2 btn btn-success" value="Reset" />
                                </div>
                            </div>
                        }
                    </div>
                    <br />
                </div>
            </div>
        </div>



        <div id="accordion14" class="accordion-wrapper mb-3">
            <div class=" main-card mb-3 card">
                <div id="headingfouteen" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne14" aria-expanded="true" aria-controls="collapseOne14" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">Document Type List<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion14" id="collapseOne14" aria-labelledby="headingfouteen" class="collapse show">

                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails">
                                <div class="">

                                    <table style="width: 100%;" id="scr-vtr-dynamic" class="example1 table table-striped table-bordered  table-hover text-center">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th>Document Type Name</th>
                                                <th>Document Short Type </th>
                                                <th>Status</th>
                                                <th>Edit</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model != null && Model.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@item.DocType_Name</td>
                                                        <td>@item.Short_Name</td>
                                                        <td>@(item.Active == "True" ? "Active" : "InActive")</td>
                                                        <td>
                                                            @Html.ActionLink("Edit", "DocumentType", "Admin", new { DocType_Code = item.DocType_Code }, new { @class = "btn btn-sm btn-warning" })
                                                            @Html.ActionLink("Delete", "DeleteDocumentType", "Admin", new { DocType_Code = item.DocType_Code }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this document type?');" })
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="6">No records found</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>







@section Scripts {

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            var message = '@TempData["insertmsg"]';

            if (message) {
                switch (message) {
                    case "1":
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Document Type inserted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "2":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to insert Document Type.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updated":
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: 'Document Type updated successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updatefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to update Document Type.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deleted":
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Document Type deleted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deletefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to delete Document Type.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    default:
                        // Optional: handle other messages
                        break;
                }
            }

            $("#documenttypeForm").validate({
                rules: {
                    DocType_Name: {
                        required: true
                    },
                    Short_Name: {
                        required: true
                    }
                },
                messages: {
                    DocType_Name: {
                        required: "Please enter Document Type Name."
                    },
                    Short_Name: {
                        required: "Please enter Short Document Type Name."
                    }
                },
                errorPlacement: function (error, element) {
                    var errorId = element.attr("id") + "Error";
                    $("#" + errorId).html(error);
                },
                submitHandler: function (form) {
                    // Disable button and show spinner
                    var $btn = $('#documenttypeForm input[type="submit"]');
                    var originalVal = $btn.val();
                    $btn.prop('disabled', true);
                    $btn.val('Processing...');
                    $btn.css({'opacity': '0.7', 'cursor': 'not-allowed'});
                    form.submit();
                }
            });
        });


    </script>
}


