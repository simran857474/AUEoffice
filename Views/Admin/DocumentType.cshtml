@model List<Eoffice.Models.ModelDocType>
@{
    ViewBag.Title = "DocumentType";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
@{
    var editDocType = ViewBag.EditDocumentType as Eoffice.Models.ModelDocType;
    bool isEdit = editDocType != null;
}
<style>
    .error {
        color: #dc3545; /* Red */
        font-weight: normal; /* Not bold */
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>

