
@{
    ViewBag.Title = "UserDetails";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<section class="content mt-1">
    <!-- Added top margin here -->
    <div class="container-fluid">
        @*<div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Search Employee</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <input type="text" id="loginName" placeholder="Enter Login Name" class="form-control" />
                    </div>
                    <button id="searchBtn" class="btn btn-primary mt-2">Search</button>
                </div>
            </div>*@
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Search Employee</h5>
            </div>
            <div class="card-body">
                <!-- 🔹 Nav tabs -->
                <ul class="nav nav-tabs mb-3" id="searchTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="tabLogin-tab" data-toggle="tab" href="#searchLogin" role="tab" aria-controls="searchLogin" aria-selected="true">Search by Login Name</a>
                    </li>
                </ul>

                <!-- 🔹 Tab panes -->
                <div class="tab-content" id="searchTabsContent">
                    <div class="tab-pane fade show active" id="searchLogin" role="tabpanel" aria-labelledby="tabLogin-tab">
                        <div class="d-flex align-items-end mb-3">
                            <div class=" mr-3">
                                <label class="mb-1 d-block">Login Name</label>
                                <input type="text" id="loginName" placeholder="Enter Login Name" class="form-control" />
                            </div>
                            <div>
                                <button id="searchBtn" class="btn btn-primary">Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Bootstrap Modal -->
        <!-- Bootstrap Modal -->
        <div class="modal fade" id="resultModal" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Employee Details</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span>&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <!-- Loader (optional) -->
                        <div id="employeeLoader" class="text-center my-3" style="display:none;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                            <p>Loading employee data...</p>
                        </div>

                        <!-- Responsive Table -->
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="resultTable">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>EmpID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Mobile</th>
                                        <th>Type</th>
                                        <th>Dept</th>
                                        <th>Section</th>
                                        <th>Designation</th>
                                        <th>Password</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $('#searchBtn').click(function () {
        var loginName = $('#loginName').val().trim();

        if (loginName === '') {
            alert("Please enter a login name.");
            return;
        }

        $.ajax({

           url: '@Url.Action("GetUserDetails", "Admin")',
            type: 'POST',
            data: { loginName: loginName },
            success: function (data) {
                var tbody = $('#resultTable tbody');
                tbody.empty();

                if (data.length === 0) {
                    tbody.append('<tr><td colspan="9">No data found</td></tr>');
                } else {
                    $.each(data, function (i, item) {
                        var row = '<tr>' +
                            '<td>' + item.EmpID + '</td>' +
                            '<td>' + item.Name + '</td>' +
                            '<td>' + item.Email + '</td>' +
                            '<td>' + item.Mobile + '</td>' +
                            '<td>' + item.Est_TypeName + '</td>' +
                            '<td>' + item.Est_deptName + '</td>' +
                            '<td>' + item.Est_secName + '</td>' +
                            '<td>' + item.Est_desigName + '</td>' +
                            '<td>' + item.Password + '</td>' +
                            '</tr>';
                        tbody.append(row);
                    });
                }

                $('#resultModal').modal('show');
            },
            error: function () {
                alert("Error retrieving user data.");
            }
        });
    });
</script>
