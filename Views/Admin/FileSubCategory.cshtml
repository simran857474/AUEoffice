@model List<Eoffice.Models.ModelFileSubCategory>
@{
    ViewBag.Title = "FileSubCategory";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
@{
    var editfilesubcat = ViewBag.EditFileSubCat as Eoffice.Models.ModelFileSubCategory;
    bool isEdit = editfilesubcat != null;
}
@*<div class="app-page-title app-page-title-simple">
    <div class="page-title-wrapper">
        <div class="page-title-heading">
            <div>
                <div class="page-title-head center-elem">
                    <span class="d-inline-block pr-2">
                        <i class="lnr-apartment opacity-6"></i>
                    </span>
                    <span class="d-inline-block">File SubCategory </span>
                </div>
            </div>
        </div>

    </div>
</div>*@

<section class="content">
    <div class="container-fluid">
        <div id="accordion15" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingfifteen" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne15" aria-expanded="true" aria-controls="collapseOne15" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title">Add  File SubCategory<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion15" id="collapseOne15" aria-labelledby="headingfifteen" class="collapse @(isEdit? "show":"")">
                    <div class="card-body">
                        @using (Html.BeginForm(isEdit ? "EditFileSubCat" : "FileSubCategory", "Admin", FormMethod.Post, new { id = "filesubcatForm" }))
                        {
                            <input type="hidden" name="FileSubCat_Code" value="@(isEdit?editfilesubcat.FileSubCat_Code:"")" />

                            <div class="form-row">
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleSelect" class="">File Category Name</label>

                                        @Html.DropDownList("FileCat_Name", new SelectList(ViewBag.FileCategoryList as List<SelectListItem>, "Value", "Text", editfilesubcat?.FileCat_Code), "Select", new { @class = "form-control", id = "FileCat_Name" })


                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="position-relative form-group">
                                        <label for="exampleEmail111" class="">File SubCategory Name</label>
                                        <input name="FileSubCat_Name" id="FileSubCat_Name" placeholder="Enter Short Document Type Name" type="Text" class="form-control" value="@(isEdit ? editfilesubcat.FileSubCat_Name: "")">
                                        <span id="FileSubCatNameError" class="text-danger"></span>
                                    </div>
                                </div>

                            </div>
                            <div class="form-row">
                                <div class="col-md-4">
                                    <input type="submit" class="mt-2 ml-2 btn btn-primary" value="@(isEdit ? "Update" : "Submit")" />
                                </div>
                            </div>
                        }
                    </div>
                    <br />
                </div>
            </div>
        </div>

        <div id="accordion16" class="accordion-wrapper mb-3">
            <div class="main-card mb-3 card">
                <div id="headingsixteen" class="card-header">
                    <button type="button" data-toggle="collapse" data-target="#collapseOne16" aria-expanded="true" aria-controls="collapseOne16" class="text-left m-0 p-0 btn btn-link btn-block">
                        <h5 class="m-0 p-0 card-title"> File SubCategory List<i class="float-right pe-7s-angle-down"></i></h5>

                    </button>
                </div>
                <div data-parent="#accordion16" id="collapseOne16" aria-labelledby="headingsixteen" class="collapse show">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divDetails" >
                                <div class="">

                                    <table style="width: 100%;" id="scr-vtr-dynamic" class="example1 table table-striped table-bordered nowrap table-hover text-center">
                                        <thead>
                                            <tr>
                                                <th>S.No</th>
                                                <th>File Category</th>
                                                <th>File SubCategory </th>
                                                @*<th>Status</th>*@
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@item.FileCat_Name</td>
                                                        <td> @item.FileSubCat_Name</td>
                                                        @*<td>@item.Status</td>*@
                                                        <td>
                                                            @Html.ActionLink("Edit", "FileSubCategory", "Admin", new { FileSubCat_Code = item.FileSubCat_Code }, new { @class = "btn btn-sm btn-warning" })
                                                            @Html.ActionLink("Delete", "DeleteFileSubCat", "Admin", new { FileSubCat_Code = item.FileSubCat_Code }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to delete this file sub category?');" })

                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            var message = '@TempData["insertmsg"]';

            if (message) {
                switch (message) {
                    case "1":
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'file category inserted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "2":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to insert file category.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updated":
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: 'file category updated successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "updatefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to update file category.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deleted":
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'file category deleted successfully.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    case "deletefail":
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: 'Failed to delete file category.',
                            timer: 4000,
                            showConfirmButton: false
                        });
                        break;
                    default:
                        // Optional: handle other messages
                        break;
                }
            }

            $("#filesubcatForm").validate({
                errorClass: "text-danger",
                validClass: "is-valid",
                errorElement: "span",
                rules: {
                    FileCat_Name: { required: true },
                    FileSubCat_Name: { required: true },

                },
                messages: {
                    FileCat_Name: { required: "Please select file category" },
                    FileSubCat_Name: { required: "Please enter file sub category" },
                },
                highlight: function (element) {
                    $(element).removeClass("is-valid").addClass("error");
                },
                unhighlight: function (element) {
                    $(element).removeClass("error").addClass("is-valid");
                },
                errorPlacement: function (error, element) {
                    error.insertAfter(element);
                },
                submitHandler: function (form) {
                    // Disable button and show spinner
                    var $btn = $('#filesubcatForm input[type="submit"]');
                    var originalVal = $btn.val();
                    $btn.prop('disabled', true);
                    $btn.val('Processing...');
                    $btn.css({ 'opacity': '0.7', 'cursor': 'not-allowed' });
                    form.submit();
                }
            });
        });
    </script>

    <script>
    $(document).ready(function () {
        const isEdit = '@(isEdit)'.toLowerCase() === 'true';
        const selectedFileCategory = '@(isEdit ? editfilesubcat.FileCat_Code : "")';

        if (selectedFileCategory != "") {
            bindFileCategory('ddlFileCategory', selectedFileCategory);
        }
        else {
            bindFileCategory('ddlFileCategory', -1);
        }
    });

    function bindFileCategory(id, defaultvalue) {
        if (defaultvalue == -1 || defaultvalue == undefined || defaultvalue == "") {
            defaultvalue = -1;
        }

        var obj = new Object();
        obj.Action = "bindFileCategory";

        $.ajax({
            type: 'POST',
            //url: '/Admin/fillDropdown',
             url: '@Url.Action("fillDropdown", "Admin")',
            data: { Action: obj.Action },

            success: function (Data) {

                var ddl = $('#' + id);
                ddl.empty();

                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option"
                }));
                if (defaultvalue != -1) {
                    ddl.val(defaultvalue);
                }
                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                ddl.val(defaultvalue);
                },
            error: function (Data) {
                console.error("Some error while binding");
            },
        });
    }
    </script>
}




