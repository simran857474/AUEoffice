        <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.dataTables.js"></script>*@
    <script src="https://cdn.datatables.net/rowgroup/1.5.1/js/dataTables.rowGroup.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.5.1/js/rowGroup.dataTables.js"></script>


    <script>
        var table = new DataTable('.example1', {
            //columnDefs: [{ width: '50%', targets: 0 }],
            dom: "Blfrtip",
            //sScrollY: "500px",
            /* "autoWidth": false, */
            sScrollX: true,

            bScrollCollapse: true,
            "paging": true,

            "sScrollXInner": "100%",
            //rowGroup: {
            //    dataSrc: [2]
            //},
            columnDefs: [
                { "className": "dt-center", "targets": "_all" },
                {
                    searchable: false,
                    orderable: false,
                    targets: 0,
                },
                //{
                //    targets: [2],
                //    visible: false
                //}
            ],
            order: [],
            //order: [[1, 'asc']],
            buttons: [
                {
                    extend: 'excelHtml5',
                    title: "Eoffice",
                    //messageTop: "Eoffice",
                    exportOptions: {
                        columns: ':visible'
                    }
                },
                {
                    extend: 'print',
                    title: "Eoffice",
                    //messageTop: "Eoffice",
                    exportOptions: {
                        columns: ':visible'
                    }

                }, 'colvis'
            ]
        });

        // Logout confirmation with SweetAlert2
        $("#logoutBtn").click(function (e) {
            e.preventDefault();
            Swal.fire({
                title: 'Logout Confirmation',
                text: "Are you sure you want to logout?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, Logout',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = "@Url.Action("Logout", "Home")";
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)

    

