                                    </a>
                                    <ul>
                                        <li>
                                            <a href="@Url.Action("Department", "Admin")">
                                                <i class="metismenu-icon"></i>Add Department
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Section", "Admin")">
                                                <i class="metismenu-icon"></i>Add Section
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Designation", "Admin")">
