                                                <i class="metismenu-icon"></i>Employee Report
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li>
                                    <a href="#">
                                        <i class="metismenu-icon pe-7s-users"></i>User Management
                                        <i class="metismenu-state-icon pe-7s-angle-down caret-left"></i>
                                    </a>
                                    <ul>
                                        <li>
                                            <a href="@Url.Action("CreateUser", "Admin")">
                                                <i class="metismenu-icon"></i>Create User
                                            </a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("ChangePassword", "Admin")">
                                                <i class="metismenu-icon"></i>Change Password
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (roleType == "User")
                            {
                                <li>
                                    <a href="@Url.Action("Index", "Home")">
                                        <i class="metismenu-icon pe-7s-home"></i>Home
                                        <i class="metismenu-state-icon caret-left"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="@Url.Action("CreateDocument", "Home")">
