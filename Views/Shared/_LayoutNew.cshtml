    <script>
        let idleTime = 0;
        const idleLimitMinutes = 30; // When to auto logout
        const warningBeforeMinutes = 1; // Show warning 1 min before logout
        let warningShown = false;
        let idleInterval;

        function resetIdleTime() {
            idleTime = 0;
            if (warningShown) {
                $("#sessionWarningModal").modal("hide");
                warningShown = false;
            }
        }

        function startIdleTimer() {
            idleInterval = setInterval(function () {
                idleTime++;

                if (idleTime >= (idleLimitMinutes - warningBeforeMinutes) && !warningShown) {
                    warningShown = true;
                    $("#sessionWarningModal").modal("show");
                }

                if (idleTime >= idleLimitMinutes) {
                    clearInterval(idleInterval);
                   window.location.href = '@Url.Action("Logout", "Home")'; // Logout controller
                }
            }, 60000); // 1 minute
        }

        // Reset on activity
        $(document).on("mousemove keypress click scroll", resetIdleTime);

        $(document).ready(function () {
            startIdleTimer();

            // Active menu highlighting
            var currentPath = window.location.pathname.toLowerCase();

            // Find and activate the matching menu item
            $('.nav-sidebar .nav-link').each(function() {
                var $link = $(this);
                var href = $link.attr('href');

                if (href && href !== '#') {
                    var linkPath = href.toLowerCase();

                    // Check if current path matches the link
                    if (currentPath === linkPath || currentPath.indexOf(linkPath) === 0) {
                        // Add active class to the link
                        $link.addClass('active');

                        // If it's a submenu item, open the parent menu
                        var $parentItem = $link.closest('.nav-treeview').closest('.nav-item');
                        if ($parentItem.length) {
                            $parentItem.addClass('menu-open');
                            $parentItem.find('> .nav-link').addClass('active');
                        }
                    }
                }
            });

            // If no exact match found, try to match by controller
            if ($('.nav-sidebar .nav-link.active').length === 0) {
                var pathParts = currentPath.split('/');
                if (pathParts.length >= 3) {
                    var controller = pathParts[1];
                    var action = pathParts[2];

                    $('.nav-sidebar .nav-link').each(function() {
                        var $link = $(this);
                        var href = $link.attr('href');

                        if (href && href !== '#') {
                            var hrefLower = href.toLowerCase();
                            if (hrefLower.indexOf('/' + controller + '/') !== -1) {
                                $link.addClass('active');

                                var $parentItem = $link.closest('.nav-treeview').closest('.nav-item');
                                if ($parentItem.length) {
                                    $parentItem.addClass('menu-open');
                                    $parentItem.find('> .nav-link').addClass('active');
                                }
                                return false; // Break the loop
                            }
                        }
                    });
                }
            }
        });
    </script>

