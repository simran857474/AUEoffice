@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP - E-Office</title>
    <link rel="icon" type="image/png" href="~/theme/dist/img/logo-inverse.png" />
    <link href="~/themeassets/demo.dashboardpack.com/architectui-html-pro/main.d810cf0ae7f39f28f336.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* OTP Input Boxes */
        .otp-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 30px 0;
        }

        .otp-input {
            width: 50px;
            height: 50px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            transition: all 0.3s ease;
            outline: none;
        }

        .otp-input:focus {
            border-color: #3f6ad8;
            box-shadow: 0 0 0 0.2rem rgba(63, 106, 216, 0.25);
            transform: scale(1.05);
        }

        .otp-input:disabled {
            background-color: #f8f9fa;
            cursor: not-allowed;
        }

        .otp-input.filled {
            border-color: #28a745;
            background-color: #f0fff4;
        }

        .otp-input.error {
            border-color: #dc3545;
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        /* Timer */
        .timer-container {
            text-align: center;
            margin: 20px 0;
        }

        .timer {
            font-size: 18px;
            font-weight: 600;
            color: #3f6ad8;
        }

        .timer.expired {
            color: #dc3545;
        }

        /* Resend Link */
        .resend-link {
            text-align: center;
            margin-top: 15px;
        }

        .resend-link a {
            color: #3f6ad8;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .resend-link a:hover {
            text-decoration: underline;
        }

        .resend-link a.disabled {
            color: #6c757d;
            cursor: not-allowed;
            pointer-events: none;
        }

        /* Button */
        .btn-primary {
            transition: all 0.3s ease;
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(63, 106, 216, 0.3);
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
        }

        /* Info Box */
        .info-box {
            background: #e7f3ff;
            border-left: 4px solid #3f6ad8;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .info-box i {
            color: #3f6ad8;
            margin-right: 10px;
        }

        @@media (max-width: 576px) {
            .otp-input {
                width: 40px;
                height: 40px;
                font-size: 20px;
            }
            
            .otp-container {
                gap: 8px;
            }
        }
    </style>
</head>
<body>
    <div class="app-container app-theme-white body-tabs-shadow">
        <div class="app-container">
            <div class="h-100 bg-plum-plate bg-animation">
                <div class="d-flex h-100 justify-content-center align-items-center">
                    <div class="mx-auto app-login-box col-md-6">
                        <div class="modal-dialog w-100">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <div class="h5 modal-title">
                                        <i class="fa fa-shield mr-2"></i>Verify OTP
                                        <h6 class="mt-2 mb-0 opacity-8">
                                            <span style="color:green;">Enter the 4-digit OTP sent to your registered email</span>
                                        </h6>
                                    </div>
                                </div>

                                <form id="otpForm">
                                    <div class="modal-body">
                                        <div class="info-box">
                                            <i class="fa fa-info-circle"></i>
                                            <span>Please check your email for the verification code</span>
                                        </div>

                                        <div class="otp-container">
                                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" data-index="0" />
                                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" data-index="1" />
                                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" data-index="2" />
                                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" data-index="3" />
                                        </div>

                                        <div class="timer-container">
                                            <div class="timer" id="timer">
                                                <i class="fa fa-clock-o mr-1"></i>
                                                <span id="timeLeft">05:00</span>
                                            </div>
                                        </div>

                                        <div class="resend-link">
                                            <span>Didn't receive the code? </span>
                                            <a href="javascript:void(0)" id="resendLink" class="disabled">Resend OTP</a>
                                        </div>
                                    </div>

                                    <div class="modal-footer clearfix">
                                        <div class="float-left">
                                            <a href="@Url.Action("ForgotPassword", "Home")" class="btn btn-link" style="text-decoration:none;">
                                                <i class="fa fa-arrow-left mr-1"></i>Back
                                            </a>
                                        </div>
                                        <div class="float-right">
                                            <button class="btn btn-primary btn-lg" type="submit" id="btnVerify">
                                                <span class="btn-text">Verify OTP</span>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="text-center text-white opacity-8 mt-3">
                            Copyright © @DateTime.Now.Year Acme Digitek Solutions Pvt. Limited
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            const $otpInputs = $('.otp-input');
            const $form = $('#otpForm');
            const $btnVerify = $('#btnVerify');
            const $resendLink = $('#resendLink');
            let timeLeft = 300; // 5 minutes in seconds
            let timerInterval;

            // Auto-focus first input
            $otpInputs.first().focus();

            // OTP Input Handling
            $otpInputs.on('input', function (e) {
                const $this = $(this);
                const value = $this.val();

                // Only allow numbers
                if (!/^\d*$/.test(value)) {
                    $this.val('');
                    return;
                }

                // Add filled class
                if (value) {
                    $this.addClass('filled');
                    // Move to next input
                    const nextIndex = parseInt($this.data('index')) + 1;
                    if (nextIndex < $otpInputs.length) {
                        $otpInputs.eq(nextIndex).focus();
                    }
                } else {
                    $this.removeClass('filled');
                }

                // Remove error class on input
                $this.removeClass('error');
            });

            // Handle backspace
            $otpInputs.on('keydown', function (e) {
                const $this = $(this);
                const index = parseInt($this.data('index'));

                if (e.key === 'Backspace') {
                    if (!$this.val() && index > 0) {
                        // Move to previous input
                        $otpInputs.eq(index - 1).focus().val('').removeClass('filled');
                    } else {
                        $this.val('').removeClass('filled');
                    }
                } else if (e.key === 'ArrowLeft' && index > 0) {
                    $otpInputs.eq(index - 1).focus();
                } else if (e.key === 'ArrowRight' && index < $otpInputs.length - 1) {
                    $otpInputs.eq(index + 1).focus();
                }
            });

            // Handle paste
            $otpInputs.on('paste', function (e) {
                e.preventDefault();
                const pastedData = e.originalEvent.clipboardData.getData('text');
                const digits = pastedData.replace(/\D/g, '').split('').slice(0, 4);

                digits.forEach((digit, index) => {
                    if (index < $otpInputs.length) {
                        $otpInputs.eq(index).val(digit).addClass('filled');
                    }
                });

                // Focus last filled input or first empty
                const lastFilledIndex = Math.min(digits.length, $otpInputs.length) - 1;
                $otpInputs.eq(lastFilledIndex).focus();
            });

            // Timer countdown
            function startTimer() {
                timerInterval = setInterval(function () {
                    timeLeft--;

                    const minutes = Math.floor(timeLeft / 60);
                    const seconds = timeLeft % 60;
                    $('#timeLeft').text(
                        String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0')
                    );

                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        $('#timer').addClass('expired');
                        $('#timeLeft').text('Expired');
                        $resendLink.removeClass('disabled');
                        $otpInputs.prop('disabled', true);
                        $btnVerify.prop('disabled', true);
                    } else if (timeLeft <= 60) {
                        $('#timer').addClass('expired');
                    }
                }, 1000);
            }

            // Start timer
            startTimer();

            // Resend OTP
            $resendLink.on('click', function () {
                if ($(this).hasClass('disabled')) return;

                Swal.fire({
                    title: 'Resend OTP?',
                    text: 'A new OTP will be sent to your email',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3f6ad8',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, Resend'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Reset timer and inputs
                        clearInterval(timerInterval);
                        timeLeft = 300;
                        $('#timer').removeClass('expired');
                        $resendLink.addClass('disabled');
                        $otpInputs.prop('disabled', false).val('').removeClass('filled error');
                        $btnVerify.prop('disabled', false);
                        $otpInputs.first().focus();
                        startTimer();

                        // Call resend API (you'll need to implement this)
                        $.ajax({
                            //url: '/Home/ResendOtp',
                            url: '@Url.Action("ResendOtp", "Home")',

                            type: 'POST',
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'OTP Sent!',
                                        text: 'A new OTP has been sent to your email',
                                        confirmButtonColor: '#3f6ad8'
                                    });
                                }
                            }
                        });
                    }
                });
            });

            // Form submission
            $form.on('submit', function (e) {
                e.preventDefault();

                // Collect OTP
                let otp = '';
                $otpInputs.each(function () {
                    otp += $(this).val();
                });

                // Validate OTP
                if (otp.length !== 4) {
                    $otpInputs.addClass('error');
                    Swal.fire({
                        icon: 'warning',
                        title: 'Incomplete OTP',
                        text: 'Please enter all 4 digits',
                        confirmButtonColor: '#3f6ad8'
                    });
                    return;
                }

                // Disable inputs and button
                $otpInputs.prop('disabled', true);
                const $btnText = $btnVerify.find('.btn-text');
                $btnVerify.prop('disabled', true);
                $btnText.html('<span class="spinner-border spinner-border-sm mr-2"></span>Verifying...');

                // Submit OTP
                $.ajax({
                    //url: '/Home/VerifyForgotPasswordOtp',
                      url: '@Url.Action("VerifyForgotPasswordOtp", "Home")',
                    type: 'POST',
                    data: { otp: otp },
                    success: function (res) {
                        if (res.success) {
                            clearInterval(timerInterval);
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: res.message,
                                confirmButtonColor: '#3f6ad8'
                            }).then(() => {
                                //window.location.href = '/Home/Login';
                                window.location.href = '@Url.Action("Login", "Home")';

                            });
                        } else {
                            // Re-enable and show error
                            $otpInputs.prop('disabled', false).val('').removeClass('filled').addClass('error');
                            $btnVerify.prop('disabled', false);
                            $btnText.html('Verify OTP');
                            $otpInputs.first().focus();

                            Swal.fire({
                                icon: 'error',
                                title: 'Invalid OTP',
                                text: res.message,
                                confirmButtonColor: '#d33'
                            });
                        }
                    },
                    error: function () {
                        // Re-enable and show error
                        $otpInputs.prop('disabled', false);
                        $btnVerify.prop('disabled', false);
                        $btnText.html('Verify OTP');

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An unexpected error occurred. Please try again.',            
                            confirmButtonColor: '#d33'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>
