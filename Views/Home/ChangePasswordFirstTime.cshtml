
@model Eoffice.Models.ChangePasswordFirstTimeModel
@{

    Layout = null;
}

<link href="~/themeassets/demo.dashboardpack.com/architectui-html-pro/main.d810cf0ae7f39f28f336.css" rel="stylesheet" />
<title>Change Password</title>
<div class="app-container app-theme-white body-tabs-shadow">
    <div class="app-container">
        <div class="h-100 bg-plum-plate bg-animation">
            <div class="d-flex h-100 justify-content-center align-items-center">
                <div class="mx-auto app-login-box col-md-6">
                    <div class="modal-dialog w-100">
                        <div class="modal-content">
                            <div class="modal-header">
                                <div class="h5 modal-title text-center">
                                    UserName: @Model.Username
                                    <h6 class="mt-1 mb-0 opacity-8">
                                        <span style="color:red;"><b>Note: </b>This winodw will appear at once for the first time login to change password.</span>
                                    </h6>
                                </div>
                            </div>
                            <div class="modal-body">
                                @using (Html.BeginForm("ChangePasswordFirstTime", "Home", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    @*<input type="hidden" value="@Model.Username" name="Username" />*@

                                    if (ViewBag.Error != null)
                                    {
                                        <div class="alert alert-danger">@ViewBag.Error</div>
                                    }

                                    <div class="form-row">
                                        <div class="col-md-12">
                                            <div class="position-relative form-group">
                                                <label class="">New Password</label>
                                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Enter new password" })
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="position-relative form-group">
                                                <label class="">Confirm Password</label>
                                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Confirm new password" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal-footer clearfix">
                                        <div class="float-left">
                                            <a href="@Url.Action("Login", "Home")" class="btn btn-outline-secondary btn-lg">Back to Login</a>
                                        </div>
                                        <div class="float-right">
                                            <button type="submit" class="btn btn-primary btn-lg">Update Password</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="text-center text-white opacity-8 mt-3">
                        Copyright © Acme Digitek Solutions Pvt. Limited
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

