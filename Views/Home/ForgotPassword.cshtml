@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - E-Office</title>
    <link rel="icon" type="image/png" href="~/theme/dist/img/logo-inverse.png" />
    <link href="~/themeassets/demo.dashboardpack.com/architectui-html-pro/main.d810cf0ae7f39f28f336.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        .form-control:focus {
            border-color: #3f6ad8;
            box-shadow: 0 0 0 0.2rem rgba(63, 106, 216, 0.25);
        }

        .btn-primary {
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(63, 106, 216, 0.3);
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
        }

        .modal-title {
            color: #495057;
        }

        .text-primary:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="app-container app-theme-white body-tabs-shadow">
        <div class="app-container">
            <div class="h-100 bg-plum-plate bg-animation">
                <div class="d-flex h-100 justify-content-center align-items-center">
                    <div class="mx-auto app-login-box col-md-6">
                        <div class="modal-dialog w-100">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <div class="h5 modal-title">
                                        <i class="fa fa-lock mr-2"></i><b>Forgot your Password?</b>
                                        <h6 class="mt-2 mb-0 opacity-8">
                                            <span style="color:green;">Provide the email address and mobile number associated with your account to recover your password</span>
                                        </h6>
                                    </div>
                                </div>
                                <form id="forgotPasswordForm">
                                    <div class="modal-body">
                                        <div class="form-row">
                                            <div class="col-md-12">
                                                <div class="position-relative form-group">
                                                    <label for="email" >
                                                        <i class="fa fa-envelope mr-1"></i>Email
                                                    </label>
                                                    <input 
                                                        name="email" 
                                                        id="email" 
                                                        placeholder="Enter your email address" 
                                                        type="email" 
                                                        class="form-control" 
                                                        required
                                                    />
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="position-relative form-group">
                                                    <label for="mobile">
                                                        <i class="fa fa-mobile mr-1"></i>Mobile Number
                                                    </label>
                                                    <input 
                                                        name="mobile" 
                                                        id="mobile" 
                                                        placeholder="Enter your 10-digit mobile number" 
                                                        type="tel" 
                                                        class="form-control" 
                                                        pattern="[0-9]{10}"
                                                        maxlength="10"
                                                        required
                                                    />
                                                    <small class="form-text text-muted">Enter 10-digit mobile number</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="divider"></div>
                                        <h6 class="mb-0">
                                            <i class="fa fa-arrow-left mr-1"></i>
                                            <a href="@Url.Action("Login", "Home")" class="text-primary" style="text-decoration:none;">Back to Login</a>
                                        </h6>
                                    </div>
                                    <div class="modal-footer clearfix">
                                        <div class="float-right">
                                            <button class="btn btn-primary btn-lg" type="submit" id="btnRecover">
                                                <span class="btn-text">Recover Password</span>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="text-center text-white opacity-8 mt-3">
                            Copyright © @DateTime.Now.Year Acme Digitek Solutions Pvt. Limited
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Mobile number validation - only numbers
            $('#mobile').on('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            // Handle Forgot Password (AJAX)
            $("#forgotPasswordForm").submit(function (e) {
                e.preventDefault();

                var email = $("#email").val().trim();
                var mobile = $("#mobile").val().trim();

                // Validation
                if (!email) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Validation Error',
                        text: 'Please enter your email address',
                        confirmButtonColor: '#3f6ad8'
                    });
                    return;
                }

                if (!mobile) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Validation Error',
                        text: 'Please enter your mobile number',
                        confirmButtonColor: '#3f6ad8'
                    });
                    return;
                }

                if (mobile.length !== 10) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Validation Error',
                        text: 'Mobile number must be 10 digits',
                        confirmButtonColor: '#3f6ad8'
                    });
                    return;
                }

                // Disable button and show spinner
                var $btn = $("#btnRecover");
                var $btnText = $btn.find('.btn-text');
                $btn.prop('disabled', true);
                $btnText.html('<span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>Sending OTP...');

                var data = {
                    email: email,
                    mobile: mobile
                };

                $.ajax({
                    url: '@Url.Action("ForgotPassword", "Home")',
                    type: "POST",
                    data: data,
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'OTP Sent!',
                                text: res.message,
                                confirmButtonColor: '#3f6ad8',
                                confirmButtonText: 'Verify OTP'
                            }).then(() => {
                                window.location.href = '@Url.Action("VerifyForgotPasswordOtp", "Home")';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: res.message,
                                confirmButtonColor: '#d33'
                            });
                            // Re-enable button
                            $btn.prop('disabled', false);
                            $btnText.html('Recover Password');
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong. Please try again.',
                            confirmButtonColor: '#d33'
                        });
                        // Re-enable button
                        $btn.prop('disabled', false);
                        $btnText.html('Recover Password');
                    }
                });
            });
        });
    </script>
</body>
</html>
