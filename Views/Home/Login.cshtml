    background: url('@Url.Content("~/Content/Images/Au_Original.png")') center / contain no-repeat;
  }


    .app-header__center {
    margin-top: 10px;
    text-align: center;
    }

    .university-name {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 600;
    color: #800000;
    text-shadow: 1px 1px 2px #aaa;
    }

    .password-wrapper {
    position: relative;
    }

    .password-wrapper input {
    padding-right: 40px; /* make space for icon */
    }

    .toggle-password {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    cursor: pointer;
    color: #666;
    font-size: 18px;
    transition: color 0.3s;
    }
    
    .toggle-password:hover {
        color: #3f6ad8;
    }

    /* 🔥 Fix ArchitectUI modal issue */
    .modal {
    z-index: 1050 !important;
    }

    .modal-backdrop {
    z-index: 1040 !important;
    }

    .department-card {
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    }

    .department-card:hover {
    transform: scale(1.02);
    box-shadow: 0 6px 18px rgba(0,0,0,0.15);
    }

    /* Login spinner styles */
    .login-spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        vertical-align: text-bottom;
        border: 0.15em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border 0.75s linear infinite;
        margin-right: 0.5rem;
    }

    @@keyframes spinner-border {
        to {
            transform: rotate(360deg);
        }
    }

    .spinner-border-sm {
        width: 0.875rem;
        height: 0.875rem;
        border-width: 0.125em;
    }

    input[type="submit"]:disabled {
        cursor: not-allowed !important;
        position: relative;
    }

    /* Animated dots for loading state */
    @@keyframes loading-dots {
        0%, 20% {
            content: '⏳ Logging in.';
        }
        40% {
            content: '⏳ Logging in..';
        }
        60%, 100% {
            content: '⏳ Logging in...';
        }
    }
    
    /* Enhanced form inputs */
    .form-control {
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        border-color: #3f6ad8;
        box-shadow: 0 0 0 0.2rem rgba(63, 106, 216, 0.25);
    }
    
    /* Radio button styling */
    .form-check-input:checked {
        background-color: #3f6ad8;
        border-color: #3f6ad8;
    }
    
    /* Button hover effect */
    .btn-primary {
        transition: all 0.3s ease;
    }
    
    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(63, 106, 216, 0.3);
    }
    
    /* Captcha styling */
    #captcha {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-top: 15px;
    }
    
    #txtCaptcha {
        background-size: cover !important;
        font-weight: bold !important;
        letter-spacing: 3px;
    }
    
    #btnrefresh {
        color: #3f6ad8;
        transition: transform 0.3s;
    }
    
    #btnrefresh:hover {
        transform: rotate(180deg);
        color: #2d4fb8;
    }
    
    /* Input icons */
    .input-icon-wrapper {
